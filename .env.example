# ==============================================================================
# PujoPath — Environment Configuration Template (.env.example)
# ==============================================================================
# Copy this file to .env.local to configure your local development environment:
#   cp .env.example .env.local
#
# Do NOT commit .env.local or any production credentials to source control.
# ==============================================================================

# Public URL of the application
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Base path for deployment (leave empty for root domain, use /pujopath for GitHub Pages)
NEXT_PUBLIC_BASE_PATH=

# Map Tile Provider (openstreetmap | cartodb | custom)
NEXT_PUBLIC_MAP_PROVIDER=openstreetmap

# Optional Custom Map Tile Server URL (if using private tiles)
NEXT_PUBLIC_MAP_TILE_URL=

# Default Application Language (en | bn)
NEXT_PUBLIC_DEFAULT_LOCALE=en

# Analytics & Monitoring (optional)
NEXT_PUBLIC_ENABLE_ANALYTICS=false
NEXT_PUBLIC_ANALYTICS_KEY=
