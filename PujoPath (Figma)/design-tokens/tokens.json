{
  "$schema": "https://tokens.studio/schemas/token-schema.json",
  "global": {
    "color": {
      "brand": {
        "red": {
          "default": { "value": "#b42323", "type": "color", "description": "Primary PujoPath red used for branding, active states, and primary CTAs" },
          "hover": { "value": "#971e1e", "type": "color", "description": "Hover state for primary red buttons" },
          "soft": { "value": "#fdeeee", "type": "color", "description": "Subtle red background tint for badges and highlights" },
          "border": { "value": "rgba(180, 35, 35, 0.25)", "type": "color", "description": "Subtle red border for active cards and badges" },
          "dark": { "value": "#801414", "type": "color", "description": "Deep red for gradients and dark mode accents" }
        },
        "gold": {
          "default": { "value": "#d97706", "type": "color", "description": "Auspicious festive gold accent" },
          "light": { "value": "#fef3c7", "type": "color", "description": "Soft gold background tint" },
          "dark": { "value": "#b45309", "type": "color", "description": "Deep gold for typography and icons" }
        }
      },
      "neutral": {
        "white": { "value": "#ffffff", "type": "color" },
        "black": { "value": "#000000", "type": "color" },
        "cream": { "value": "#fcfaf7", "type": "color", "description": "Default light mode canvas background" },
        "charcoal": { "value": "#14110e", "type": "color", "description": "Default dark mode canvas background" }
      }
    },
    "typography": {
      "fontFamilies": {
        "sans": { "value": "Inter", "type": "fontFamilies" },
        "display": { "value": "Plus Jakarta Sans", "type": "fontFamilies" },
        "bengali": { "value": "Hind Siliguri", "type": "fontFamilies" }
      },
      "fontWeights": {
        "regular": { "value": 400, "type": "fontWeights" },
        "medium": { "value": 500, "type": "fontWeights" },
        "semibold": { "value": 600, "type": "fontWeights" },
        "bold": { "value": 700, "type": "fontWeights" },
        "black": { "value": 900, "type": "fontWeights" }
      },
      "fontSizes": {
        "xs": { "value": "11px", "type": "fontSizes" },
        "sm": { "value": "13px", "type": "fontSizes" },
        "base": { "value": "15px", "type": "fontSizes" },
        "lg": { "value": "17px", "type": "fontSizes" },
        "xl": { "value": "20px", "type": "fontSizes" },
        "2xl": { "value": "24px", "type": "fontSizes" },
        "3xl": { "value": "30px", "type": "fontSizes" },
        "4xl": { "value": "36px", "type": "fontSizes" },
        "5xl": { "value": "48px", "type": "fontSizes" }
      },
      "lineHeights": {
        "tight": { "value": "1.15", "type": "lineHeights" },
        "snug": { "value": "1.3", "type": "lineHeights" },
        "normal": { "value": "1.5", "type": "lineHeights" },
        "relaxed": { "value": "1.65", "type": "lineHeights" }
      }
    },
    "spacing": {
      "0": { "value": "0px", "type": "spacing" },
      "1": { "value": "4px", "type": "spacing" },
      "2": { "value": "8px", "type": "spacing" },
      "3": { "value": "12px", "type": "spacing" },
      "4": { "value": "16px", "type": "spacing" },
      "5": { "value": "20px", "type": "spacing" },
      "6": { "value": "24px", "type": "spacing" },
      "8": { "value": "32px", "type": "spacing" },
      "10": { "value": "40px", "type": "spacing" },
      "12": { "value": "48px", "type": "spacing" },
      "16": { "value": "64px", "type": "spacing" }
    },
    "borderRadius": {
      "none": { "value": "0px", "type": "borderRadius" },
      "sm": { "value": "6px", "type": "borderRadius" },
      "md": { "value": "8px", "type": "borderRadius" },
      "lg": { "value": "10px", "type": "borderRadius" },
      "xl": { "value": "12px", "type": "borderRadius" },
      "2xl": { "value": "16px", "type": "borderRadius" },
      "3xl": { "value": "22px", "type": "borderRadius" },
      "4xl": { "value": "28px", "type": "borderRadius" },
      "full": { "value": "9999px", "type": "borderRadius" }
    },
    "boxShadow": {
      "xs": {
        "value": { "x": "0", "y": "1px", "blur": "3px", "spread": "0", "color": "rgba(60, 30, 15, 0.04)", "type": "dropShadow" },
        "type": "boxShadow"
      },
      "card": {
        "value": { "x": "0", "y": "2px", "blur": "10px", "spread": "0", "color": "rgba(70, 35, 15, 0.04)", "type": "dropShadow" },
        "type": "boxShadow"
      },
      "container": {
        "value": { "x": "0", "y": "20px", "blur": "60px", "spread": "0", "color": "rgba(80, 40, 20, 0.08)", "type": "dropShadow" },
        "type": "boxShadow"
      },
      "player": {
        "value": { "x": "0", "y": "14px", "blur": "40px", "spread": "0", "color": "rgba(70, 35, 15, 0.12)", "type": "dropShadow" },
        "type": "boxShadow"
      }
    }
  },
  "light": {
    "color": {
      "bg": {
        "main": { "value": "{global.color.neutral.cream.value}", "type": "color" },
        "surface": { "value": "{global.color.neutral.white.value}", "type": "color" },
        "surfaceSecondary": { "value": "#f5f1eb", "type": "color" },
        "surfaceHover": { "value": "#f2ede6", "type": "color" },
        "card": { "value": "{global.color.neutral.white.value}", "type": "color" }
      },
      "text": {
        "primary": { "value": "#242424", "type": "color" },
        "secondary": { "value": "#5c524a", "type": "color" },
        "muted": { "value": "#7e7268", "type": "color" }
      },
      "border": {
        "default": { "value": "#e8e1d9", "type": "color" },
        "subtle": { "value": "#f0eae2", "type": "color" },
        "strong": { "value": "#d5c9bd", "type": "color" }
      }
    }
  },
  "dark": {
    "color": {
      "bg": {
        "main": { "value": "{global.color.neutral.charcoal.value}", "type": "color" },
        "surface": { "value": "#1e1915", "type": "color" },
        "surfaceSecondary": { "value": "#27201a", "type": "color" },
        "surfaceHover": { "value": "#332b23", "type": "color" },
        "card": { "value": "#1a1613", "type": "color" }
      },
      "text": {
        "primary": { "value": "#ede5dc", "type": "color" },
        "secondary": { "value": "#b5aaa0", "type": "color" },
        "muted": { "value": "#8a7f76", "type": "color" }
      },
      "border": {
        "default": { "value": "#2f2720", "type": "color" },
        "subtle": { "value": "#251e18", "type": "color" },
        "strong": { "value": "#3d332a", "type": "color" }
      }
    }
  }
}
