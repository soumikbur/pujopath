__d(function(g,r,i,a,m,e,_d){"use strict";Object.defineProperty(e,'__esModule',{value:!0}),Object.defineProperty(e,"CURRENT_SEASON_CONFIG",{enumerable:!0,get:function(){return t}}),e.isLatestCompletedSeason=function(n,s=t){return n===s.latestCompletedSeason},e.getSeasonBadgeLabel=function(n,s="en",o=t){var l=t=>{var n=['\u09e6','\u09e7','\u09e8','\u09e9','\u09ea','\u09eb','\u09ec','\u09ed','\u09ee','\u09ef'];return String(t).replace(/[0-9]/g,t=>n[parseInt(t,10)])},c='bn'===s;if(!n)return{badgeText:c?'\u099b\u09ac\u09bf \u0985\u09aa\u09cd\u09b0\u09be\u09aa\u09cd\u09af':'Photo Unavailable',isLatest:!1,isArchival:!1};var d=n>=o.latestCompletedSeason;o.latestCompletedSeason;if(d){var u=c?l(n):n;return{badgeText:c?`${u} \u099b\u09ac\u09bf`:`${u} Photo`,isLatest:!0,isArchival:!1}}var v=c?l(n):n;return{badgeText:c?`${v} \u0986\u09b0\u09cd\u0995\u09be\u0987\u09ad`:`${v} Archive`,isLatest:!1,isArchival:!0}};var t={currentTargetSeason:2026,latestCompletedSeason:2025,seasonRefreshedAt:'2026-10-12',nextScheduledRun:'2026-10-19',policyVersion:'2.0.0-smart-refresh',minConfidenceScore:85,allowPriorYearFallback:!0}},1017,[]);
__d(function(g,r,i,a,m,e,d){"use strict";Object.defineProperty(e,'__esModule',{value:!0}),Object.defineProperty(e,"KALI_TEMPLES_DATA",{enumerable:!0,get:function(){return n}});var n=[{id:'kali-kalighat',name:'Kalighat Kali Temple',nameBn:'\u0995\u09be\u09b2\u09c0\u0998\u09be\u099f \u0995\u09be\u09b2\u09c0 \u09ae\u09a8\u09cd\u09a6\u09bf\u09b0',zone:'South Kolkata',zoneBn:'\u09a6\u0995\u09cd\u09b7\u09bf\u09a3 \u0995\u09b2\u0995\u09be\u09a4\u09be',category:'Historic Shaktipeeth',categoryBn:'\u0990\u09a4\u09bf\u09b9\u09be\u09b8\u09bf\u0995 \u09ae\u09b9\u09be\u09aa\u09c0\u09a0',history:'One of the supreme 51 Shaktipeeths of the subcontinent where the four toes of Devi Sati\u2019s right foot fell. Situated along the holy Adi Ganga canal, the sanctum features the iconic touchstone idol with three large eyes, four golden arms, and protruding golden tongue.',historyBn:'\u09ad\u09be\u09b0\u09a4\u09c0\u09af\u09bc \u0989\u09aa\u09ae\u09b9\u09be\u09a6\u09c7\u09b6\u09c7\u09b0 \u09aa\u09b0\u09ae \u09aa\u09ac\u09bf\u09a4\u09cd\u09b0 \u09eb\u09e7 \u09b8\u09a4\u09c0\u09aa\u09c0\u09a0\u09c7\u09b0 \u0985\u09a8\u09cd\u09af\u09a4\u09ae \u09aa\u09cd\u09b0\u09a7\u09be\u09a8 \u09ae\u09b9\u09be\u09aa\u09c0\u09a0\u0964 \u0995\u09a5\u09bf\u09a4 \u0986\u099b\u09c7 \u098f\u0996\u09be\u09a8\u09c7 \u09a6\u09c7\u09ac\u09c0\u09b0 \u09a1\u09be\u09a8 \u099a\u09b0\u09a3\u09c7\u09b0 \u099a\u09be\u09b0\u099f\u09bf \u0985\u0999\u09cd\u0997\u09c1\u09b2\u09bf \u09aa\u09a4\u09bf\u09a4 \u09b9\u09af\u09bc\u09c7\u099b\u09bf\u09b2\u0964 \u0995\u09b7\u09cd\u099f\u09bf\u09aa\u09be\u09a5\u09b0\u09c7\u09b0 \u09a4\u09cd\u09b0\u09bf\u09a8\u09af\u09bc\u09a8\u09be \u09a6\u09c7\u09ac\u09c0\u09ae\u09c2\u09b0\u09cd\u09a4\u09bf, \u09b8\u09cd\u09ac\u09b0\u09cd\u09a3\u099c\u09bf\u09b9\u09cd\u09ac\u09be \u0993 \u0986\u09a6\u09bf \u0997\u0999\u09cd\u0997\u09be\u09b0 \u09a4\u09c0\u09b0\u09c7 \u09b6\u09a4 \u09b6\u09a4 \u09ac\u099b\u09b0\u09c7\u09b0 \u09ad\u0995\u09cd\u09a4\u09bf\u0990\u09a4\u09bf\u09b9\u09cd\u09af\u0964',address:'Anami Sangha, Kalighat Road, Kalighat, Kolkata 700026',addressBn:'\u0986\u09a6\u09bf \u0997\u0999\u09cd\u0997\u09be\u09b0 \u09a4\u09c0\u09b0, \u0995\u09be\u09b2\u09c0\u0998\u09be\u099f \u09b0\u09cb\u09a1, \u0995\u09b2\u0995\u09be\u09a4\u09be \u09ed\u09e6\u09e6\u09e6\u09e8\u09ec',deityForm:'Dakshina Kali (Touchstone Murti with Golden Tongue & Trinetra)',deityFormBn:'\u09a6\u0995\u09cd\u09b7\u09bf\u09a3\u09be \u0995\u09be\u09b2\u09bf\u0995\u09be (\u09b8\u09cd\u09ac\u09b0\u09cd\u09a3\u099c\u09bf\u09b9\u09cd\u09ac\u09be \u0993 \u09a4\u09cd\u09b0\u09bf\u09a8\u09af\u09bc\u09a8 \u09ac\u09bf\u09b6\u09bf\u09b7\u09cd\u099f \u0995\u09b7\u09cd\u099f\u09bf\u09aa\u09be\u09a5\u09b0\u09c7\u09b0 \u09ac\u09bf\u0997\u09cd\u09b0\u09b9)',dipanwitaRituals:'Midnight Mangal Aarati, continuous Dipanwita Amavasya pradip illumination, sacred snan yatra, and nocturnal Mahapuja with thousands of red hibiscus flowers.',dipanwitaRitualsBn:'\u09a8\u09bf\u09b6\u09c0\u09a5 \u09ae\u0999\u09cd\u0997\u09b2 \u0986\u09b0\u09a4\u09bf, \u09b8\u09b9\u09b8\u09cd\u09b0 \u09aa\u09cd\u09b0\u09a6\u09c0\u09aa \u09aa\u09cd\u09b0\u099c\u09cd\u09ac\u09b2\u09a8, \u09b0\u0995\u09cd\u09a4\u099c\u09ac\u09be \u0985\u099e\u09cd\u099c\u09b2\u09bf \u098f\u09ac\u0982 \u09b0\u09be\u09a4\u09ad\u09b0 \u09ae\u09b9\u09be\u09a8\u09bf\u09b0\u09cd\u0998\u09a3\u09cd\u099f \u09aa\u09c2\u099c\u09be\u0964',nearestMetro:'Kalighat Metro Station (Blue Line) - 800m walk',nearestMetroBn:'\u0995\u09be\u09b2\u09c0\u0998\u09be\u099f \u09ae\u09c7\u099f\u09cd\u09b0\u09cb \u09b8\u09cd\u099f\u09c7\u09b6\u09a8 (\u09ac\u09cd\u09b2\u09c1 \u09b2\u09be\u0987\u09a8) - \u09ee\u09e6\u09e6 \u09ae\u09bf\u099f\u09be\u09b0',establishedYear:'Ancient (Reconstructed 1809 by Sabarna Roy Choudhury family)',specialTiming:'Temple open throughout Dipanwita Amavasya night (04:00 AM - next morning)',specialTimingBn:'\u09a6\u09c0\u09aa\u09be\u09a8\u09cd\u09ac\u09bf\u09a4\u09be \u0985\u09ae\u09be\u09ac\u09b8\u09cd\u09af\u09be\u09b0 \u09b0\u09be\u09a4\u09ad\u09b0 \u09ae\u09a8\u09cd\u09a6\u09bf\u09b0 \u0996\u09cb\u09b2\u09be \u09a5\u09be\u0995\u09c7 (\u09ad\u09cb\u09b0 \u09ea\u099f\u09be \u09a5\u09c7\u0995\u09c7 \u09aa\u09b0\u09a6\u09bf\u09a8 \u09aa\u09b0\u09cd\u09af\u09a8\u09cd\u09a4)',image:r(d[0]),tags:['Shaktipeeth','Ancient','Adi Ganga','Heritage','South Kolkata']},{id:'kali-dakshineswar',name:'Dakshineswar Bhavatarini Kali Temple',nameBn:'\u09a6\u0995\u09cd\u09b7\u09bf\u09a3\u09c7\u09b6\u09cd\u09ac\u09b0 \u09ad\u09ac\u09a4\u09be\u09b0\u09bf\u09a3\u09c0 \u0995\u09be\u09b2\u09c0 \u09ae\u09a8\u09cd\u09a6\u09bf\u09b0',zone:'North Kolkata & Suburbs',zoneBn:'\u0989\u09a4\u09cd\u09a4\u09b0 \u0995\u09b2\u0995\u09be\u09a4\u09be \u0993 \u09b6\u09b9\u09b0\u09a4\u09b2\u09bf',category:'Riverside Shrine',categoryBn:'\u0997\u0999\u09cd\u0997\u09be\u09a4\u09c0\u09b0\u09ac\u09b0\u09cd\u09a4\u09c0 \u09a4\u09c0\u09b0\u09cd\u09a5\u0995\u09cd\u09b7\u09c7\u09a4\u09cd\u09b0',history:'Founded in 1855 by the visionary philanthropist Rani Rashmoni along the Hooghly river. The 9-spire Navaratna temple is universally revered worldwide as the sacred spiritual hermitage where Sri Ramakrishna Paramahamsa attained supreme divine realization of Mother Kali.',historyBn:'\u09e7\u09ee\u09eb\u09eb \u0996\u09cd\u09b0\u09bf\u09b8\u09cd\u099f\u09be\u09ac\u09cd\u09a6\u09c7 \u09aa\u09c1\u09a3\u09cd\u09af\u09b6\u09cd\u09b2\u09cb\u0995\u09be \u09b0\u09be\u09a8\u09c0 \u09b0\u09be\u09b8\u09ae\u09a3\u09bf \u0995\u09b0\u09cd\u09a4\u09c3\u0995 \u09b9\u09c1\u0997\u09b2\u09bf \u09a8\u09a6\u09c0\u09b0 \u09a4\u09c0\u09b0\u09c7 \u09aa\u09cd\u09b0\u09a4\u09bf\u09b7\u09cd\u09a0\u09bf\u09a4 \u09a8\u09ac\u09b0\u09a4\u09cd\u09a8 \u09ae\u09a8\u09cd\u09a6\u09bf\u09b0\u0964 \u09b6\u09cd\u09b0\u09c0 \u09b0\u09be\u09ae\u0995\u09c3\u09b7\u09cd\u09a3 \u09aa\u09b0\u09ae\u09b9\u0982\u09b8\u09a6\u09c7\u09ac\u09c7\u09b0 \u09aa\u09b0\u09ae \u09b8\u09be\u09a7\u09a8\u0995\u09cd\u09b7\u09c7\u09a4\u09cd\u09b0 \u0993 \u09ae\u09be \u09ad\u09ac\u09a4\u09be\u09b0\u09bf\u09a3\u09c0\u09b0 \u099a\u09bf\u09b0\u09a8\u09cd\u09a4\u09a8 \u09b2\u09c0\u09b2\u09be\u09ad\u09c2\u09ae\u09bf\u0964 \u09ac\u09bf\u09b6\u09cd\u09ac\u099c\u09c1\u09a1\u09bc\u09c7 \u0986\u09a7\u09cd\u09af\u09be\u09a4\u09cd\u09ae\u09bf\u0995 \u09ad\u0995\u09cd\u09a4\u09a6\u09c7\u09b0 \u09aa\u09b0\u09ae \u09a4\u09c0\u09b0\u09cd\u09a5\u0964',address:'Mayadibya Ghat, Dakshineswar, Kolkata 700076',addressBn:'\u09ae\u09be\u09af\u09bc\u09be\u09a6\u09bf\u09ac\u09cd\u09af \u0998\u09be\u099f, \u09a6\u0995\u09cd\u09b7\u09bf\u09a3\u09c7\u09b6\u09cd\u09ac\u09b0, \u0995\u09b2\u0995\u09be\u09a4\u09be \u09ed\u09e6\u09e6\u09ed\u09ec',deityForm:'Maa Bhavatarini (Adya Shakti standing on Lord Shiva\u2019s chest upon silver lotus)',deityFormBn:'\u09ae\u09be \u09ad\u09ac\u09a4\u09be\u09b0\u09bf\u09a3\u09c0 (\u09b0\u09cc\u09aa\u09cd\u09af \u09aa\u09a6\u09cd\u09ae\u09c7 \u09b6\u09be\u09af\u09bc\u09bf\u09a4 \u09ae\u09b9\u09be\u09a6\u09c7\u09ac\u09c7\u09b0 \u09ac\u0995\u09cd\u09b7\u09c7 \u09a6\u09a3\u09cd\u09a1\u09be\u09af\u09bc\u09ae\u09be\u09a8\u09be \u0986\u09a6\u09cd\u09af\u09be\u09b6\u0995\u09cd\u09a4\u09bf)',dipanwitaRituals:'Massive midnight Amavasya gathering, special 56-bhog offering, sacred Panchavati meditation, and illumination of 12 Shiva temples along the riverbanks with oil lamps.',dipanwitaRitualsBn:'\u09ae\u09b9\u09be\u09a8\u09bf\u09b6\u09be\u09af\u09bc \u09b0\u09be\u099c\u0995\u09c0\u09af\u09bc \u09ad\u09cb\u0997 \u0986\u09b0\u09a4\u09bf, \u09aa\u099e\u09cd\u099a\u09ac\u099f\u09c0\u09a4\u09c7 \u09a7\u09cd\u09af\u09be\u09a8, \u0997\u0999\u09cd\u0997\u09be\u09b0 \u0998\u09be\u099f\u09c7 \u09b9\u09be\u099c\u09be\u09b0 \u09b9\u09be\u099c\u09be\u09b0 \u09ae\u09be\u099f\u09bf\u09b0 \u09aa\u09cd\u09b0\u09a6\u09c0\u09aa\u09c7\u09b0 \u0986\u09b2\u09cb\u0995\u09ae\u09be\u09b2\u09be \u0993 \u09a6\u09cd\u09ac\u09be\u09a6\u09b6 \u09b6\u09bf\u09ac\u09ae\u09a8\u09cd\u09a6\u09bf\u09b0\u09c7 \u09ac\u09bf\u09b6\u09c7\u09b7 \u09aa\u09c2\u099c\u09be\u0964',nearestMetro:'Dakshineswar Metro Station (Blue Line Terminal) - 300m direct footbridge',nearestMetroBn:'\u09a6\u0995\u09cd\u09b7\u09bf\u09a3\u09c7\u09b6\u09cd\u09ac\u09b0 \u09ae\u09c7\u099f\u09cd\u09b0\u09cb \u09b8\u09cd\u099f\u09c7\u09b6\u09a8 (\u09ac\u09cd\u09b2\u09c1 \u09b2\u09be\u0987\u09a8 \u09aa\u09cd\u09b0\u09be\u09a8\u09cd\u09a4\u09bf\u0995) - \u09e9\u09e6\u09e6 \u09ae\u09bf\u099f\u09be\u09b0 \u09ab\u09c1\u099f\u09ac\u09cd\u09b0\u09bf\u099c',establishedYear:'1855 AD by Rani Rashmoni',specialTiming:'Dipanwita Amavasya: Open all night from 05:00 AM to 03:00 AM',specialTimingBn:'\u09a6\u09c0\u09aa\u09be\u09a8\u09cd\u09ac\u09bf\u09a4\u09be \u0985\u09ae\u09be\u09ac\u09b8\u09cd\u09af\u09be: \u09ad\u09cb\u09b0 \u09eb\u099f\u09be \u09a5\u09c7\u0995\u09c7 \u0997\u09ad\u09c0\u09b0 \u09b0\u09be\u09a4 \u09aa\u09b0\u09cd\u09af\u09a8\u09cd\u09a4 \u0985\u0996\u09a3\u09cd\u09a1 \u09a6\u09b0\u09cd\u09b6\u09a8',image:r(d[1]),tags:['Ramakrishna','Rani Rashmoni','Ganges','Navaratna','North Kolkata']},{id:'kali-thanthania',name:'Thanthania Kalibari (Siddheswari Kali)',nameBn:'\u09a0\u09a8\u09a0\u09a8\u09bf\u09af\u09bc\u09be \u0995\u09be\u09b2\u09c0\u09ac\u09be\u09a1\u09bc\u09bf (\u09b8\u09bf\u09a6\u09cd\u09a7\u09c7\u09b6\u09cd\u09ac\u09b0\u09c0 \u0995\u09be\u09b2\u09c0)',zone:'Central Kolkata',zoneBn:'\u09ae\u09a7\u09cd\u09af \u0995\u09b2\u0995\u09be\u09a4\u09be',category:'Heritage Mandir',categoryBn:'\u0990\u09a4\u09bf\u09b9\u09be\u09b8\u09bf\u0995 \u09ac\u09a8\u09c7\u09a6\u09bf \u09ae\u09a8\u09cd\u09a6\u09bf\u09b0',history:'A legendary tantric shrine established in 1703 by Udiyana Brahmachari. The clay murti of Goddess Siddheswari is unique: traditionally sculpted anew over the sacred wooden frame every single year immediately preceding Kali Puja with deep ritual sanctity.',historyBn:'\u09e7\u09ed\u09e6\u09e9 \u0996\u09cd\u09b0\u09bf\u09b8\u09cd\u099f\u09be\u09ac\u09cd\u09a6\u09c7 \u0989\u09a6\u09af\u09bc\u09a8\u09be\u09b0\u09be\u09af\u09bc\u09a8 \u09ac\u09cd\u09b0\u09b9\u09cd\u09ae\u099a\u09be\u09b0\u09c0 \u09aa\u09cd\u09b0\u09a4\u09bf\u09b7\u09cd\u09a0\u09bf\u09a4 \u09ae\u09a7\u09cd\u09af \u0995\u09b2\u0995\u09be\u09a4\u09be\u09b0 \u0985\u09a8\u09cd\u09af\u09a4\u09ae \u09aa\u09cd\u09b0\u09be\u099a\u09c0\u09a8 \u099c\u09be\u0997\u09cd\u09b0\u09a4 \u09aa\u09c0\u09a0\u0964 \u09aa\u09cd\u09b0\u09a4\u09bf \u09ac\u099b\u09b0 \u0995\u09be\u09b2\u09c0\u09aa\u09c2\u099c\u09be\u09b0 \u09aa\u09c2\u09b0\u09cd\u09ac\u09c7 \u09ae\u09c3\u09a8\u09cd\u09ae\u09af\u09bc\u09c0 \u09aa\u09cd\u09b0\u09a4\u09bf\u09ae\u09be \u09a8\u09a4\u09c1\u09a8 \u0995\u09b0\u09c7 \u09a8\u09bf\u09b0\u09cd\u09ae\u09be\u09a3 \u0995\u09b0\u09be \u09b9\u09af\u09bc \u09af\u09be \u09b6\u09a4\u09be\u09ac\u09cd\u09a6\u09c0\u09b0 \u09aa\u09cd\u09b0\u09be\u099a\u09c0\u09a8 \u09aa\u09cd\u09b0\u09a5\u09be\u0964',address:'College Street & Bidhan Sarani Crossing, Kolkata 700006',addressBn:'\u0995\u09b2\u09c7\u099c \u09b8\u09cd\u099f\u09cd\u09b0\u09bf\u099f \u0993 \u09ac\u09bf\u09a7\u09be\u09a8 \u09b8\u09b0\u09a3\u09bf \u0995\u09cd\u09b0\u09b8\u09bf\u0982, \u0995\u09b2\u0995\u09be\u09a4\u09be \u09ed\u09e6\u09e6\u09e6\u09e6\u09ec',deityForm:'Maa Siddheswari (Seated Tantric Kali with silver crescent moon)',deityFormBn:'\u09ae\u09be \u09b8\u09bf\u09a6\u09cd\u09a7\u09c7\u09b6\u09cd\u09ac\u09b0\u09c0 (\u09b0\u09cc\u09aa\u09cd\u09af \u09ae\u09c1\u0995\u09c1\u099f \u0993 \u0985\u09b0\u09cd\u09a7\u099a\u09a8\u09cd\u09a6\u09cd\u09b0 \u09b6\u09cb\u09ad\u09bf\u09a4\u09be \u0989\u09aa\u09ac\u09bf\u09b7\u09cd\u099f\u09be \u09a6\u09c7\u09ac\u09c0\u09ae\u09c2\u09b0\u09cd\u09a4\u09bf)',dipanwitaRituals:'Annual pratima nirman sanctification, midnight pushpanjali, traditional animal sacrifice replacement with chalkumro and sugarcane, and continuous incense smoke.',dipanwitaRitualsBn:'\u09ac\u09be\u09b0\u09cd\u09b7\u09bf\u0995 \u09aa\u09cd\u09b0\u09a4\u09bf\u09ae\u09be \u09aa\u09cd\u09b0\u09a4\u09bf\u09b7\u09cd\u09a0\u09be, \u09a8\u09bf\u09b6\u09c0\u09a5 \u09aa\u09c1\u09b7\u09cd\u09aa\u09be\u099e\u09cd\u099c\u09b2\u09bf, \u0986\u0996 \u0993 \u099a\u09be\u09b2\u0995\u09c1\u09ae\u09a1\u09bc\u09cb \u09ac\u09b2\u09bf \u098f\u09ac\u0982 \u0985\u09ac\u09bf\u09b0\u09be\u09ae \u09a7\u09c2\u09aa-\u09a7\u09c1\u09a8\u09cb\u09b0 \u09b8\u09c1\u09ac\u09be\u09b8\u09c7 \u09ad\u09be\u09ac\u0997\u09ae\u09cd\u09ad\u09c0\u09b0 \u09aa\u09c2\u099c\u09be\u0964',nearestMetro:'Central / Mahatma Gandhi Road Metro - 550m walk',nearestMetroBn:'\u09b8\u09c7\u09a8\u09cd\u099f\u09cd\u09b0\u09be\u09b2 \u0985\u09a5\u09ac\u09be \u09ae\u09b9\u09be\u09a4\u09cd\u09ae\u09be \u0997\u09be\u09a8\u09cd\u09a7\u09c0 \u09b0\u09cb\u09a1 \u09ae\u09c7\u099f\u09cd\u09b0\u09cb - \u09eb\u09eb\u09e6 \u09ae\u09bf\u099f\u09be\u09b0',establishedYear:'1703 AD (Over 320 years old)',specialTiming:'Dipanwita Night: Open until 02:00 AM midnight',specialTimingBn:'\u09a6\u09c0\u09aa\u09be\u09a8\u09cd\u09ac\u09bf\u09a4\u09be \u09b0\u09be\u09a4: \u09b0\u09be\u09a4 \u09e8\u099f\u09be \u09aa\u09b0\u09cd\u09af\u09a8\u09cd\u09a4 \u0996\u09cb\u09b2\u09be',image:r(d[0]),tags:['1703 AD','College Street','Heritage','Tantric','Central Kolkata']},{id:'kali-lake-kalibari',name:'Lake Kalibari (Sree Sree Karunamoyee Kali)',nameBn:'\u09b2\u09c7\u0995 \u0995\u09be\u09b2\u09c0\u09ac\u09be\u09a1\u09bc\u09bf (\u09b6\u09cd\u09b0\u09c0 \u09b6\u09cd\u09b0\u09c0 \u0995\u09b0\u09c1\u09a3\u09be\u09ae\u09af\u09bc\u09c0 \u0995\u09be\u09b2\u09c0)',zone:'South Kolkata',zoneBn:'\u09a6\u0995\u09cd\u09b7\u09bf\u09a3 \u0995\u09b2\u0995\u09be\u09a4\u09be',category:'Heritage Mandir',categoryBn:'\u09a6\u0995\u09cd\u09b7\u09bf\u09a3 \u0995\u09b2\u0995\u09be\u09a4\u09be\u09b0 \u099c\u09be\u0997\u09cd\u09b0\u09a4 \u09a4\u09c0\u09b0\u09cd\u09a5',history:'Founded in 1949 by the devout spiritual seeker Haripada Chakraborty. Known as the shrine of Maa Karunamoyee, this temple near Rabindra Sarobar lakes is widely respected for strict scriptural adherence, soulful devotional atmosphere, and community service.',historyBn:'\u09e7\u09ef\u09ea\u09ef \u0996\u09cd\u09b0\u09bf\u09b8\u09cd\u099f\u09be\u09ac\u09cd\u09a6\u09c7 \u09aa\u09b0\u09ae \u09ad\u0995\u09cd\u09a4 \u09b9\u09b0\u09bf\u09aa\u09a6 \u099a\u0995\u09cd\u09b0\u09ac\u09b0\u09cd\u09a4\u09c0 \u0995\u09b0\u09cd\u09a4\u09c3\u0995 \u09aa\u09cd\u09b0\u09a4\u09bf\u09b7\u09cd\u09a0\u09bf\u09a4\u0964 \u09b0\u09ac\u09c0\u09a8\u09cd\u09a6\u09cd\u09b0 \u09b8\u09b0\u09cb\u09ac\u09b0\u09c7\u09b0 \u09ae\u09a8\u09cb\u09b0\u09ae \u09aa\u09b0\u09bf\u09ac\u09c7\u09b6\u09c7 \u09ae\u09be \u0995\u09b0\u09c1\u09a3\u09be\u09ae\u09af\u09bc\u09c0\u09b0 \u09ae\u09a8\u09cd\u09a6\u09bf\u09b0\u099f\u09bf \u09a8\u09bf\u09b7\u09cd\u09a0\u09be\u09ac\u09be\u09a8 \u09a4\u09be\u09a8\u09cd\u09a4\u09cd\u09b0\u09bf\u0995 \u0993 \u09ac\u09c8\u09a6\u09bf\u0995 \u09aa\u09c2\u099c\u09be\u09b0 \u099c\u09a8\u09cd\u09af \u09a6\u0995\u09cd\u09b7\u09bf\u09a3 \u0995\u09b2\u0995\u09be\u09a4\u09be\u09af\u09bc \u09b8\u09c1\u09ac\u09bf\u0996\u09cd\u09af\u09be\u09a4\u0964',address:'107/1 Southern Avenue, Lake Market area, Kolkata 700029',addressBn:'\u09e7\u09e6\u09ed/\u09e7 \u09b8\u09be\u09a6\u09be\u09b0\u09cd\u09a8 \u0985\u09cd\u09af\u09be\u09ad\u09bf\u09a8\u09bf\u0989, \u09b2\u09c7\u0995 \u09ae\u09be\u09b0\u09cd\u0995\u09c7\u099f \u0985\u099e\u09cd\u099a\u09b2, \u0995\u09b2\u0995\u09be\u09a4\u09be \u09ed\u09e6\u09e6\u09e6\u09e8\u09ef',deityForm:'Maa Karunamoyee (Compassionate Shyama with Panchamundi Asana)',deityFormBn:'\u09ae\u09be \u0995\u09b0\u09c1\u09a3\u09be\u09ae\u09af\u09bc\u09c0 (\u09aa\u099e\u09cd\u099a\u09ae\u09c1\u09a3\u09cd\u09a1\u09bf\u09b0 \u0986\u09b8\u09a8\u09c7 \u0985\u09a7\u09bf\u09b7\u09cd\u09a0\u09bf\u09a4\u09be \u09aa\u09b0\u09ae \u0995\u09b0\u09c1\u09a3\u09be\u09ae\u09af\u09bc\u09c0 \u09b6\u09cd\u09af\u09be\u09ae\u09be)',dipanwitaRituals:'Sacred midnight Mahapuja, distribution of traditional khichuri and labra bhog, lighting of 108 ghee lamps, and evening Shyama Sangeet recitals.',dipanwitaRitualsBn:'\u09e7\u09e6\u09ee \u0998\u09c3\u09a4\u09aa\u09cd\u09b0\u09a6\u09c0\u09aa \u09aa\u09cd\u09b0\u099c\u09cd\u09ac\u09b2\u09a8, \u09ae\u09b9\u09be\u09a8\u09bf\u09b6\u09be\u09af\u09bc \u0985\u09ae\u09be\u09ac\u09b8\u09cd\u09af\u09be \u09aa\u09c2\u099c\u09be, \u0990\u09a4\u09bf\u09b9\u09cd\u09af\u09ac\u09be\u09b9\u09c0 \u0996\u09bf\u099a\u09c1\u09a1\u09bc\u09bf \u09ad\u09cb\u0997 \u09ac\u09bf\u09a4\u09b0\u09a3 \u0993 \u09b6\u09cd\u09af\u09be\u09ae\u09be\u09b8\u0999\u09cd\u0997\u09c0\u09a4\u09be\u09a8\u09c1\u09b7\u09cd\u09a0\u09be\u09a8\u0964',nearestMetro:'Rabindra Sarobar / Kalighat Metro - 700m walk',nearestMetroBn:'\u09b0\u09ac\u09c0\u09a8\u09cd\u09a6\u09cd\u09b0 \u09b8\u09b0\u09cb\u09ac\u09b0 \u0985\u09a5\u09ac\u09be \u0995\u09be\u09b2\u09c0\u0998\u09be\u099f \u09ae\u09c7\u099f\u09cd\u09b0\u09cb - \u09ed\u09e6\u09e6 \u09ae\u09bf\u099f\u09be\u09b0',establishedYear:'1949 AD',specialTiming:'Dipanwita Night: Open until 03:00 AM',specialTimingBn:'\u09a6\u09c0\u09aa\u09be\u09a8\u09cd\u09ac\u09bf\u09a4\u09be \u09b0\u09be\u09a4: \u09b0\u09be\u09a4 \u09e9\u099f\u09be \u09aa\u09b0\u09cd\u09af\u09a8\u09cd\u09a4 \u09a6\u09b0\u09cd\u09b6\u09a8\u09be\u09b0\u09cd\u09a5\u09c0\u09a6\u09c7\u09b0 \u099c\u09a8\u09cd\u09af \u0989\u09a8\u09cd\u09ae\u09c1\u0995\u09cd\u09a4',image:r(d[1]),tags:['Southern Avenue','Karunamoyee','Peaceful','South Kolkata']},{id:'kali-firinghi',name:'Firinghi Kalibari (Bowbazar)',nameBn:'\u09ab\u09bf\u09b0\u09bf\u0999\u09cd\u0997\u09bf \u0995\u09be\u09b2\u09c0\u09ac\u09be\u09a1\u09bc\u09bf (\u09ac\u0989\u09ac\u09be\u099c\u09be\u09b0)',zone:'Central Kolkata',zoneBn:'\u09ae\u09a7\u09cd\u09af \u0995\u09b2\u0995\u09be\u09a4\u09be',category:'Heritage Mandir',categoryBn:'\u0990\u09a4\u09bf\u09b9\u09be\u09b8\u09bf\u0995 \u09ae\u09bf\u09b2\u09a8\u09aa\u09c0\u09a0',history:'Over 500-year-old historic shrine in Bowbazar. Deeply entwined with folk lore and literature through Portuguese kabiwala Hensman Anthony (Anthony Firinghi), who embraced Bengali culture and composed timeless devotional songs to Maa Kali.',historyBn:'\u09ac\u0989\u09ac\u09be\u099c\u09be\u09b0\u09c7\u09b0 \u09eb\u09e6\u09e6 \u09ac\u099b\u09b0\u09c7\u09b0\u0993 \u09aa\u09cd\u09b0\u09be\u099a\u09c0\u09a8 \u09ae\u09a8\u09cd\u09a6\u09bf\u09b0\u0964 \u09aa\u09b0\u09cd\u09a4\u09c1\u0997\u09bf\u099c \u0995\u09ac\u09bf\u0997\u09be\u09a8 \u09b0\u099a\u09af\u09bc\u09bf\u09a4\u09be \u0985\u09cd\u09af\u09be\u09a8\u09cd\u099f\u09a8\u09bf \u09ab\u09bf\u09b0\u09bf\u0999\u09cd\u0997\u09bf\u09b0 \u09a8\u09be\u09ae\u09be\u09a8\u09c1\u09b8\u09be\u09b0\u09c7 \u0996\u09cd\u09af\u09be\u09a4, \u09af\u09bf\u09a8\u09bf \u09ac\u09bf\u09a6\u09c7\u09b6\u09bf \u09b9\u09af\u09bc\u09c7\u0993 \u09a6\u09c7\u09ac\u09c0 \u0995\u09be\u09b2\u09bf\u0995\u09be\u09b0 \u09aa\u09b0\u09ae \u09ad\u0995\u09cd\u09a4 \u0993 \u0995\u09be\u09b2\u099c\u09af\u09bc\u09c0 \u09b6\u09cd\u09af\u09be\u09ae\u09be\u09b8\u0999\u09cd\u0997\u09c0\u09a4 \u09b0\u099a\u09af\u09bc\u09bf\u09a4\u09be \u099b\u09bf\u09b2\u09c7\u09a8\u0964',address:'244 Bepin Behari Ganguly Street, Bowbazar, Kolkata 700012',addressBn:'\u09e8\u09ea\u09ea \u09ac\u09bf\u09aa\u09bf\u09a8 \u09ac\u09bf\u09b9\u09be\u09b0\u09c0 \u0997\u09be\u0999\u09cd\u0997\u09c1\u09b2\u09c0 \u09b8\u09cd\u099f\u09cd\u09b0\u09bf\u099f, \u09ac\u0989\u09ac\u09be\u099c\u09be\u09b0, \u0995\u09b2\u0995\u09be\u09a4\u09be \u09ed\u09e6\u09e6\u09e6\u09e7\u09e8',deityForm:'Maa Siddheswari Kali',deityFormBn:'\u09ae\u09be \u09b8\u09bf\u09a6\u09cd\u09a7\u09c7\u09b6\u09cd\u09ac\u09b0\u09c0 \u0995\u09be\u09b2\u09c0',dipanwitaRituals:'Deepavali evening aarati, continuous musical performances of Anthony Firinghi and Ramprasad compositions, and traditional floral offerings.',dipanwitaRitualsBn:'\u09a6\u09c0\u09aa\u09be\u09ac\u09b2\u09bf \u0986\u09b0\u09a4\u09bf, \u0985\u09cd\u09af\u09be\u09a8\u09cd\u099f\u09a8\u09bf \u09ab\u09bf\u09b0\u09bf\u0999\u09cd\u0997\u09bf \u0993 \u09b0\u09be\u09ae\u09aa\u09cd\u09b0\u09b8\u09be\u09a6\u09c0 \u09b6\u09cd\u09af\u09be\u09ae\u09be\u09b8\u0999\u09cd\u0997\u09c0\u09a4 \u09aa\u09b0\u09bf\u09ac\u09c7\u09b6\u09a8 \u098f\u09ac\u0982 \u09b0\u0995\u09cd\u09a4\u099c\u09ac\u09be\u09b0 \u0985\u099e\u09cd\u099c\u09b2\u09bf\u0964',nearestMetro:'Central Metro Station (Blue Line) - 350m walk',nearestMetroBn:'\u09b8\u09c7\u09a8\u09cd\u099f\u09cd\u09b0\u09be\u09b2 \u09ae\u09c7\u099f\u09cd\u09b0\u09cb \u09b8\u09cd\u099f\u09c7\u09b6\u09a8 (\u09ac\u09cd\u09b2\u09c1 \u09b2\u09be\u0987\u09a8) - \u09e9\u09eb\u09e6 \u09ae\u09bf\u099f\u09be\u09b0',establishedYear:'Circa 16th Century',specialTiming:'Dipanwita Night: Open until 01:30 AM',specialTimingBn:'\u09a6\u09c0\u09aa\u09be\u09a8\u09cd\u09ac\u09bf\u09a4\u09be \u09b0\u09be\u09a4: \u09b0\u09be\u09a4 \u09e7:\u09e9\u09e6 \u09aa\u09b0\u09cd\u09af\u09a8\u09cd\u09a4 \u0989\u09a8\u09cd\u09ae\u09c1\u0995\u09cd\u09a4',image:r(d[0]),tags:['Anthony Firinghi','Bowbazar','Historic','Central Kolkata']},{id:'kali-barasat',name:'Barasat Celebrated Community Kali Puja Festival',nameBn:'\u09ac\u09be\u09b0\u09be\u09b8\u09be\u09a4 \u0990\u09a4\u09bf\u09b9\u09be\u09b8\u09bf\u0995 \u09b8\u09b0\u09cd\u09ac\u099c\u09a8\u09c0\u09a8 \u0995\u09be\u09b2\u09c0\u09aa\u09c2\u099c\u09be \u09ae\u09b9\u09cb\u09ce\u09b8\u09ac',zone:'North 24 Parganas Hub',zoneBn:'\u0989\u09a4\u09cd\u09a4\u09b0 \u09e8\u09ea \u09aa\u09b0\u0997\u09a8\u09be',category:'Celebrated Pandal',categoryBn:'\u09ac\u09bf\u0996\u09cd\u09af\u09be\u09a4 \u09b8\u09b0\u09cd\u09ac\u099c\u09a8\u09c0\u09a8 \u09ae\u09a3\u09cd\u09a1\u09aa \u0993 \u0986\u09b2\u09cb\u0995\u09b8\u099c\u09cd\u099c\u09be',history:'Barasat is universally acclaimed across Eastern India as the grandest epicenter of community Kali Puja. Iconic clubs including Pioneer Park, Nabapally Byam Samity, Sandhani Club, and KNC Regiment create monumental architectural theme pandals and multi-kilometer dynamic LED light corridors.',historyBn:'\u09aa\u09c2\u09b0\u09cd\u09ac \u09ad\u09be\u09b0\u09a4\u09c7\u09b0 \u09b8\u09b0\u09cd\u09ac\u09b6\u09cd\u09b0\u09c7\u09b7\u09cd\u09a0 \u0995\u09be\u09b2\u09c0\u09aa\u09c2\u099c\u09be \u0989\u09ce\u09b8\u09ac\u0995\u09cd\u09b7\u09c7\u09a4\u09cd\u09b0\u0964 \u09aa\u09be\u0987\u0993\u09a8\u09bf\u09af\u09bc\u09be\u09b0 \u09aa\u09be\u09b0\u09cd\u0995, \u09a8\u09ac\u09aa\u09b2\u09cd\u09b2\u09c0 \u09ac\u09cd\u09af\u09be\u09af\u09bc\u09be\u09ae \u09b8\u09ae\u09bf\u09a4\u09bf, \u09b8\u09a8\u09cd\u09a7\u09be\u09a8\u09c0 \u0995\u09cd\u09b2\u09be\u09ac \u0993 \u0995\u09c7\u098f\u09a8\u09b8\u09bf \u09b0\u09c7\u099c\u09bf\u09ae\u09c7\u09a8\u09cd\u099f \u09b8\u09b9 \u09ac\u09b9\u09c1 \u09b6\u09a4\u09ac\u09b0\u09cd\u09b7\u09c0 \u0995\u09cd\u09b2\u09be\u09ac\u09c7\u09b0 \u099a\u09cb\u0996\u09a7\u09be\u0981\u09a7\u09be\u09a8\u09cb \u09a5\u09bf\u09ae \u09ae\u09a3\u09cd\u09a1\u09aa \u0993 \u09ac\u09bf\u09b6\u09cd\u09ac\u0996\u09cd\u09af\u09be\u09a4 \u099a\u09a8\u09cd\u09a6\u09a8\u09a8\u0997\u09b0\u09c7\u09b0 \u0986\u09b2\u09cb\u0995\u09b8\u099c\u09cd\u099c\u09be\u0964',address:'Pioneer Park & Nabapally Circuits, Barasat, Kolkata 700126',addressBn:'\u09aa\u09be\u0987\u0993\u09a8\u09bf\u09af\u09bc\u09be\u09b0 \u09aa\u09be\u09b0\u09cd\u0995 \u0993 \u09a8\u09ac\u09aa\u09b2\u09cd\u09b2\u09c0 \u099a\u09a4\u09cd\u09ac\u09b0, \u09ac\u09be\u09b0\u09be\u09b8\u09be\u09a4, \u0995\u09b2\u0995\u09be\u09a4\u09be \u09ed\u09e6\u09e6\u09e7\u09e8\u09ec',deityForm:'Grand Theme Murti & Classical Kali Pratimas',deityFormBn:'\u09ac\u09bf\u09b6\u09be\u09b2\u0995\u09be\u09b0 \u09a5\u09bf\u09ae \u09aa\u09cd\u09b0\u09a4\u09bf\u09ae\u09be \u0993 \u0990\u09a4\u09bf\u09b9\u09cd\u09af\u09ac\u09be\u09b9\u09c0 \u09b0\u09c2\u09aa',dipanwitaRituals:'Grand 5-day carnival extending through Bhai Phonta, colossal lighting gates, continuous cultural concerts, and carnival stalls attracting millions of visitors.',dipanwitaRitualsBn:'\u09ad\u09be\u0987\u09ab\u09cb\u0981\u099f\u09be \u09aa\u09b0\u09cd\u09af\u09a8\u09cd\u09a4 \u09eb \u09a6\u09bf\u09a8\u09ac\u09cd\u09af\u09be\u09aa\u09c0 \u09ae\u09b9\u09be \u0989\u09ce\u09b8\u09ac, \u0995\u09bf\u09b2\u09cb\u09ae\u09bf\u099f\u09be\u09b0\u09ac\u09cd\u09af\u09be\u09aa\u09c0 \u0986\u09b2\u09cb\u09b0 \u0997\u09c7\u099f \u0993 \u09b8\u09be\u0982\u09b8\u09cd\u0995\u09c3\u09a4\u09bf\u0995 \u0985\u09a8\u09c1\u09b7\u09cd\u09a0\u09be\u09a8\u0964',nearestMetro:'Noapara / Dum Dum Junction + local train/bus or NH12 commute',nearestMetroBn:'\u09a6\u09ae\u09a6\u09ae \u099c\u0982\u09b6\u09a8 \u09a5\u09c7\u0995\u09c7 \u09b8\u09b0\u09be\u09b8\u09b0\u09bf \u09b2\u09cb\u0995\u09be\u09b2 \u099f\u09cd\u09b0\u09c7\u09a8 \u09ac\u09be \u098f\u09a8\u098f\u0987\u099a \u09e7\u09e8 \u09ac\u09be\u09b8',establishedYear:'1960s onward',specialTiming:'Pujas remain illuminated & open 24 hours across 5 festival days',specialTimingBn:'\u0989\u09ce\u09b8\u09ac\u09c7\u09b0 \u09eb \u09a6\u09bf\u09a8 \u09e8\u09ea \u0998\u09a3\u09cd\u099f\u09be\u0987 \u09ae\u09a3\u09cd\u09a1\u09aa \u0993 \u0986\u09b2\u09cb \u09b8\u099a\u09b2 \u09a5\u09be\u0995\u09c7',image:r(d[0]),tags:['Grand Carnival','Pioneer Park','Barasat','Illumination','Theme Pandal']},{id:'kali-naihati-boro-maa',name:'Naihati Boro Maa Kali Puja',nameBn:'\u09a8\u09c8\u09b9\u09be\u099f\u09bf \u09ac\u09a1\u09bc \u09ae\u09be \u0995\u09be\u09b2\u09c0\u09aa\u09c2\u099c\u09be',zone:'North 24 Parganas Heritage',zoneBn:'\u0989\u09a4\u09cd\u09a4\u09b0 \u09e8\u09ea \u09aa\u09b0\u0997\u09a8\u09be \u0990\u09a4\u09bf\u09b9\u09cd\u09af',category:'Celebrated Pandal',categoryBn:'\u0990\u09a4\u09bf\u09b9\u09be\u09b8\u09bf\u0995 \u09b8\u09c1\u09ac\u09bf\u09b6\u09be\u09b2 \u09b0\u09c2\u09aa',history:'Celebrated for over 100 years, Naihati\u2019s Boro Maa features a majestic 21-foot tall idol adorned with hundreds of kilograms of gold and silver jewelry gifted by devotees across Bengal. Millions queue from midnight to offer pure ghee lamps and red dhotis.',historyBn:'\u09b6\u09a4\u09ac\u09b0\u09cd\u09b7\u09c7\u09b0 \u0990\u09a4\u09bf\u09b9\u09cd\u09af\u09ac\u09be\u09b9\u09c0 \u09a8\u09c8\u09b9\u09be\u099f\u09bf\u09b0 \u09e8\u09e7 \u09ab\u09c1\u099f \u0989\u099a\u09cd\u099a\u09a4\u09be\u09b0 \u09b8\u09c1\u09ac\u09bf\u09b6\u09be\u09b2 \u09ac\u09a1\u09bc \u09ae\u09be\u0964 \u09ad\u0995\u09cd\u09a4\u09a6\u09c7\u09b0 \u09a6\u09c7\u0993\u09af\u09bc\u09be \u09b6\u09a4 \u09b6\u09a4 \u09ad\u09b0\u09bf \u09b8\u09cb\u09a8\u09be-\u09b0\u09c1\u09aa\u09cb\u09b0 \u0997\u09b9\u09a8\u09be\u09af\u09bc \u09b8\u09be\u099c\u09be\u09a8\u09cb \u09b9\u09af\u09bc \u09a6\u09c7\u09ac\u09c0\u0995\u09c7\u0964 \u09a8\u09bf\u09b7\u09cd\u09a0\u09be\u09ad\u09b0\u09c7 \u09ae\u09be\u09a8\u09a4 \u09aa\u09c2\u09b0\u09a3 \u0993 \u09b2\u09be\u0996\u09cb \u09ae\u09be\u09a8\u09c1\u09b7\u09c7\u09b0 \u09ad\u0995\u09cd\u09a4\u09bf\u09b0 \u09ae\u09b9\u09be\u09b8\u0999\u09cd\u0997\u09ae\u0964',address:'Arbinda Road, Naihati, North 24 Parganas 743165',addressBn:'\u0985\u09b0\u09ac\u09bf\u09a8\u09cd\u09a6 \u09b0\u09cb\u09a1, \u09a8\u09c8\u09b9\u09be\u099f\u09bf, \u0989\u09a4\u09cd\u09a4\u09b0 \u09e8\u09ea \u09aa\u09b0\u0997\u09a8\u09be \u09ed\u09ea\u09e9\u09e7\u09ec\u09eb',deityForm:'21-Foot Colossal Murti of Maa Shyama adorned in solid gold ornaments',deityFormBn:'\u09e8\u09e7 \u09ab\u09c1\u099f \u0989\u099a\u09cd\u099a\u09a4\u09be\u09b0 \u09ac\u09bf\u09b6\u09be\u09b2\u0995\u09be\u09b0 \u09b0\u09c2\u09aa \u0993 \u09ad\u0995\u09cd\u09a4\u09a6\u09a4\u09cd\u09a4 \u09b8\u09cd\u09ac\u09b0\u09cd\u09a3\u09be\u09b2\u0999\u09cd\u0995\u09be\u09b0\u09c7 \u09ad\u09c2\u09b7\u09bf\u09a4\u09be \u09ae\u09be \u09b6\u09cd\u09af\u09be\u09ae\u09be',dipanwitaRituals:'Continuous 72-hour darshan, millions of earthen lamps glowing along the queue, and historic immersion procession with thousands of torchbearers.',dipanwitaRitualsBn:'\u09ed\u09e8 \u0998\u09a3\u09cd\u099f\u09be\u09b0 \u0985\u0996\u09a3\u09cd\u09a1 \u09a6\u09b0\u09cd\u09b6\u09a8, \u09b2\u09be\u0996 \u09b2\u09be\u0996 \u09ae\u09be\u099f\u09bf\u09b0 \u09aa\u09cd\u09b0\u09a6\u09c0\u09aa\u09c7\u09b0 \u0986\u09b2\u09cb \u098f\u09ac\u0982 \u0990\u09a4\u09bf\u09b9\u09be\u09b8\u09bf\u0995 \u09ac\u09bf\u09b8\u09b0\u09cd\u099c\u09a8 \u09b6\u09cb\u09ad\u09be\u09af\u09be\u09a4\u09cd\u09b0\u09be\u0964',nearestMetro:'Naihati Railway Junction (Sealdah Main Line) - 600m walk',nearestMetroBn:'\u09a8\u09c8\u09b9\u09be\u099f\u09bf \u09b0\u09c7\u09b2\u0993\u09af\u09bc\u09c7 \u099c\u0982\u09b6\u09a8 (\u09b6\u09bf\u09af\u09bc\u09be\u09b2\u09a6\u09b9 \u09ae\u09c7\u09a8 \u09b2\u09be\u0987\u09a8) - \u09ec\u09e6\u09e6 \u09ae\u09bf\u099f\u09be\u09b0',establishedYear:'Over 100 years ago',specialTiming:'Open 24 hours continuously throughout Kali Puja days',specialTimingBn:'\u0995\u09be\u09b2\u09c0\u09aa\u09c2\u099c\u09be\u09b0 \u09a6\u09bf\u09a8\u0997\u09c1\u09b2\u09bf\u09a4\u09c7 \u09e8\u09ea \u0998\u09a3\u09cd\u099f\u09be\u0987 \u0985\u0996\u09a3\u09cd\u09a1 \u09a6\u09b0\u09cd\u09b6\u09a8 \u099a\u09be\u09b2\u09c1 \u09a5\u09be\u0995\u09c7',image:r(d[1]),tags:['21 Feet Tall','Boro Maa','Naihati','Famous','Gold Ornaments']}]},1018,[1003,1019]);
