__d(function(g,r,i,a,m,e,d){"use strict";Object.defineProperty(e,'__esModule',{value:!0}),Object.defineProperty(e,"PUJA_CALENDAR_DATA",{enumerable:!0,get:function(){return n}});var n=[{id:'mahalaya-2026',slug:'mahalaya',dayName:'Mahalaya (\u09ae\u09b9\u09be\u09b2\u09af\u09bc\u09be)',dayNameBn:'\u09ae\u09b9\u09be\u09b2\u09af\u09bc\u09be',dateString:'Saturday, October 10, 2026',gregorianDate:'2026-10-10',significance:'The sacred dawn of Agomoni marking the arrival of Goddess Durga and the end of Pitru Paksha. Bengalis wake at 4:00 AM for the legendary Chandipath recitation.',significanceBn:'\u09aa\u09bf\u09a4\u09c3\u09aa\u0995\u09cd\u09b7\u09c7\u09b0 \u0985\u09ac\u09b8\u09be\u09a8 \u0993 \u09a6\u09c7\u09ac\u09c0\u09aa\u0995\u09cd\u09b7\u09c7\u09b0 \u09aa\u09c1\u09a3\u09cd\u09af \u09b8\u09c2\u099a\u09a8\u09be\u0964 \u09ad\u09cb\u09b0 \u09ea\u099f\u09be\u09af\u09bc \u09ac\u09c0\u09b0\u09c7\u09a8\u09cd\u09a6\u09cd\u09b0\u0995\u09c3\u09b7\u09cd\u09a3 \u09ad\u09a6\u09cd\u09b0\u09c7\u09b0 \u099a\u09a3\u09cd\u09a1\u09c0\u09aa\u09be\u09a0 \u0993 \u09ae\u09b9\u09bf\u09b7\u09be\u09b8\u09c1\u09b0\u09ae\u09b0\u09cd\u09a6\u09bf\u09a8\u09c0 \u09b6\u09c1\u09a8\u09c7 \u09a6\u09c7\u09ac\u09c0 \u0986\u09ac\u09be\u09b9\u09a8 \u098f\u09ac\u0982 \u0997\u0999\u09cd\u0997\u09be\u09b0 \u0998\u09be\u099f\u09c7 \u09a4\u09b0\u09cd\u09aa\u09a3\u0964',rituals:['Tarpan for ancestors at dawn on Ganges ghats','Listening to Birendra Krishna Bhadra Mahishasuramardini at 4:00 AM','Chokkhudaan (painting of the eyes of Goddess Durga idol by master sculptors)'],ritualsBn:['\u09ad\u09cb\u09b0\u09ac\u09c7\u09b2\u09be\u09af\u09bc \u0997\u0999\u09cd\u0997\u09be\u09b0 \u0998\u09be\u099f\u09c7 \u09aa\u09c2\u09b0\u09cd\u09ac\u09aa\u09c1\u09b0\u09c1\u09b7\u09a6\u09c7\u09b0 \u09a4\u09b0\u09cd\u09aa\u09a3','\u09ad\u09cb\u09b0 \u09ea\u099f\u09be\u09af\u09bc \u09ac\u09c0\u09b0\u09c7\u09a8\u09cd\u09a6\u09cd\u09b0\u0995\u09c3\u09b7\u09cd\u09a3 \u09ad\u09a6\u09cd\u09b0\u09c7\u09b0 \u09ae\u09b9\u09bf\u09b7\u09be\u09b8\u09c1\u09b0\u09ae\u09b0\u09cd\u09a6\u09bf\u09a8\u09c0 \u09b6\u09cd\u09b0\u09ac\u09a3','\u09ae\u09c3\u09ce\u09b6\u09bf\u09b2\u09cd\u09aa\u09c0\u09a6\u09c7\u09b0 \u09a6\u09cd\u09ac\u09be\u09b0\u09be \u09a6\u09c7\u09ac\u09c0\u09b0 \u099a\u0995\u09cd\u09b7\u09c1\u09a6\u09be\u09a8\u09c7\u09b0 \u09b6\u09c1\u09ad \u09b8\u09c2\u099a\u09a8\u09be'],pushpanjaliTimings:'Tarpan: 05:15 AM - 09:30 AM',pushpanjaliTimingsBn:'\u09a4\u09b0\u09cd\u09aa\u09a3 \u09b8\u09ae\u09af\u09bc: \u09ad\u09cb\u09b0 \u09eb:\u09e7\u09eb - \u09b8\u0995\u09be\u09b2 \u09ef:\u09e9\u09e6',tithis:[{name:'Amavasya (Mahalaya Amavasya)',nameBn:'\u09ae\u09b9\u09be\u09b2\u09af\u09bc\u09be \u0985\u09ae\u09be\u09ac\u09b8\u09cd\u09af\u09be',startTime:'Oct 09, 07:22 PM',endTime:'Oct 10, 08:45 PM',description:'Auspicious period for offering holy water and prayers to departed souls.',descriptionBn:'\u09aa\u09bf\u09a4\u09c3\u09aa\u09c1\u09b0\u09c1\u09b7\u09a6\u09c7\u09b0 \u0989\u09a6\u09cd\u09a6\u09c7\u09b6\u09cd\u09af\u09c7 \u099c\u09b2\u09a6\u09be\u09a8 \u0993 \u09b8\u09cd\u09ae\u09b0\u09a3\u09c7\u09b0 \u09aa\u09c1\u09a3\u09cd\u09af\u09b2\u0997\u09cd\u09a8\u0964'}]},{id:'maha-panchami-2026',slug:'maha-panchami',dayName:'Maha Panchami (\u09ae\u09b9\u09be \u09aa\u099e\u09cd\u099a\u09ae\u09c0)',dayNameBn:'\u09ae\u09b9\u09be \u09aa\u099e\u09cd\u099a\u09ae\u09c0',dateString:'Thursday, October 15, 2026',gregorianDate:'2026-10-15',significance:'The festive awakening marking the welcoming of Mother Durga, Anandamela food celebrations, and ceremonial inauguration of pandals across the city.',significanceBn:'\u09b6\u09be\u09b0\u09a6\u09cb\u09ce\u09b8\u09ac\u09c7\u09b0 \u0986\u09a8\u09a8\u09cd\u09a6\u09ae\u09af\u09bc \u09aa\u09cd\u09b0\u09be\u0995-\u09ae\u09c1\u09b9\u09c2\u09b0\u09cd\u09a4\u0964 \u09aa\u09be\u09a1\u09bc\u09be\u09af\u09bc \u09aa\u09be\u09a1\u09bc\u09be\u09af\u09bc \u0986\u09a8\u09a8\u09cd\u09a6\u09ae\u09c7\u09b2\u09be, \u09a6\u09c7\u09ac\u09c0\u09b0 \u09ac\u09cb\u09a7\u09a8 \u09aa\u09cd\u09b0\u09b8\u09cd\u09a4\u09c1\u09a4\u09bf \u098f\u09ac\u0982 \u09a6\u09b0\u09cd\u09b6\u09a8\u09be\u09b0\u09cd\u09a5\u09c0\u09a6\u09c7\u09b0 \u099c\u09a8\u09cd\u09af \u09ae\u09a3\u09cd\u09a1\u09aa \u0989\u09a8\u09cd\u09ae\u09cb\u099a\u09a8\u0964',rituals:['Anandamela food festival and community gatherings','Invocation prayers and Bilva tree sanctification preparation','Ceremonial inauguration of artisan pandals'],ritualsBn:['\u09aa\u09be\u09a1\u09bc\u09be\u09af\u09bc \u09aa\u09be\u09a1\u09bc\u09be\u09af\u09bc \u0986\u09a8\u09a8\u09cd\u09a6\u09ae\u09c7\u09b2\u09be \u0993 \u0997\u09c3\u09b9\u09bf\u09a3\u09c0\u09a6\u09c7\u09b0 \u09b8\u09c1\u09b8\u09cd\u09ac\u09be\u09a6\u09c1 \u0996\u09be\u09ac\u09be\u09b0\u09c7\u09b0 \u0986\u09af\u09bc\u09cb\u099c\u09a8','\u09a6\u09c7\u09ac\u09c0 \u0986\u09ac\u09be\u09b9\u09a8 \u0993 \u0995\u09b2\u09cd\u09aa\u09be\u09b0\u09ae\u09cd\u09ad\u09c7\u09b0 \u09aa\u09cd\u09b0\u09b8\u09cd\u09a4\u09c1\u09a4\u09bf \u09aa\u09b0\u09cd\u09ac','\u09b6\u09bf\u09b2\u09cd\u09aa\u09ae\u09a3\u09cd\u09a1\u09bf\u09a4 \u09ae\u09a3\u09cd\u09a1\u09aa\u09b8\u09ae\u09c2\u09b9\u09c7\u09b0 \u0986\u09a8\u09c1\u09b7\u09cd\u09a0\u09be\u09a8\u09bf\u0995 \u0989\u09a6\u09cd\u09ac\u09cb\u09a7\u09a8'],pushpanjaliTimings:'Tithi extends till 01:43 AM (Late Night)',pushpanjaliTimingsBn:'\u09aa\u099e\u09cd\u099a\u09ae\u09c0 \u09a4\u09bf\u09a5\u09bf: \u09b0\u09be\u09a4 \u09e6\u09e7:\u09ea\u09e9 \u09aa\u09b0\u09cd\u09af\u09a8\u09cd\u09a4',tithis:[{name:'Panchami Tithi',nameBn:'\u09aa\u099e\u09cd\u099a\u09ae\u09c0 \u09a4\u09bf\u09a5\u09bf',startTime:'Oct 14, 11:32 PM',endTime:'Oct 15, 01:43 AM (Night)',description:'Panchami tithi lasts till 01:43 AM at night according to the 1433 Bengali Panjika schedule.',descriptionBn:'\u09e7\u09ea\u09e9\u09e9 \u09b8\u09be\u09b2\u09c7\u09b0 \u09aa\u099e\u09cd\u099c\u09bf\u0995\u09be \u09a8\u09bf\u09b0\u09cd\u0998\u09a3\u09cd\u099f \u0985\u09a8\u09c1\u09af\u09be\u09af\u09bc\u09c0 \u09aa\u099e\u09cd\u099a\u09ae\u09c0 \u09a4\u09bf\u09a5\u09bf \u09b0\u09be\u09a4 \u09e6\u09e7:\u09ea\u09e9 \u09aa\u09b0\u09cd\u09af\u09a8\u09cd\u09a4\u0964'}]},{id:'maha-shashthi-2026',slug:'maha-shashthi',dayName:'Maha Shashthi (\u09ae\u09b9\u09be \u09b7\u09b7\u09cd\u09a0\u09c0)',dayNameBn:'\u09ae\u09b9\u09be \u09b7\u09b7\u09cd\u09a0\u09c0',dateString:'Friday, October 16, 2026',gregorianDate:'2026-10-16',significance:'The official beginning of Durga Puja rituals. Goddess Durga is welcomed with the awakening ritual (Bodhon) under the sacred Bilva (Bel) tree.',significanceBn:'\u09b6\u09be\u09b0\u09a6\u09cb\u09ce\u09b8\u09ac\u09c7\u09b0 \u09ae\u09c2\u09b2 \u09aa\u09b0\u09cd\u09ac\u09c7\u09b0 \u09b8\u09c2\u099a\u09a8\u09be\u0964 \u09ac\u09c7\u09b2\u09a4\u09b2\u09be\u09af\u09bc \u09a6\u09c7\u09ac\u09c0\u09b0 \u09ac\u09cb\u09a7\u09a8, \u0986\u09ae\u09a8\u09cd\u09a4\u09cd\u09b0\u09a3 \u0993 \u0985\u09a7\u09bf\u09ac\u09be\u09b8\u09c7\u09b0 \u09ae\u09a7\u09cd\u09af \u09a6\u09bf\u09af\u09bc\u09c7 \u09ae\u09b9\u09be\u09ae\u09be\u09af\u09bc\u09be\u0995\u09c7 \u09ae\u09b0\u09cd\u09a4\u09cd\u09af\u09c7 \u09ac\u09b0\u09a3\u0964',rituals:['Kalparambha (solemn pledge of the festival)','Bodhon (unveiling and divine invocation under Bilva tree)','Adhibas and Amontron rituals in evening','Unveiling of pandal idols for grand public viewing'],ritualsBn:['\u0995\u09b2\u09cd\u09aa\u09be\u09b0\u09ae\u09cd\u09ad \u0993 \u09b8\u0982\u0995\u09b2\u09cd\u09aa \u0997\u09cd\u09b0\u09b9\u09a3','\u09ac\u09bf\u09b2\u09cd\u09ac\u09ac\u09c3\u0995\u09cd\u09b7\u09c7\u09b0 \u09a8\u09bf\u099a\u09c7 \u09a6\u09c7\u09ac\u09c0\u09b0 \u09ac\u09cb\u09a7\u09a8 \u0993 \u099c\u09be\u0997\u09b0\u09a3','\u09b8\u09a8\u09cd\u09a7\u09cd\u09af\u09be\u09af\u09bc \u0986\u09ae\u09a8\u09cd\u09a4\u09cd\u09b0\u09a3 \u0993 \u0985\u09a7\u09bf\u09ac\u09be\u09b8 \u09aa\u09b0\u09cd\u09ac','\u09b8\u09be\u09a7\u09be\u09b0\u09a3 \u09a6\u09b0\u09cd\u09b6\u09a8\u09be\u09b0\u09cd\u09a5\u09c0\u09a6\u09c7\u09b0 \u099c\u09a8\u09cd\u09af \u09ae\u09a3\u09cd\u09a1\u09aa \u0989\u09a8\u09cd\u09ae\u09cb\u099a\u09a8'],pushpanjaliTimings:'08:30 AM - 10:00 AM (Tithi till 03:47 AM Night)',pushpanjaliTimingsBn:'\u09b8\u0995\u09be\u09b2 \u09ee:\u09e9\u09e6 - \u09b8\u0995\u09be\u09b2 \u09e7\u09e6:\u09e6\u09e6 (\u09a4\u09bf\u09a5\u09bf \u09b0\u09be\u09a4 \u09e6\u09e9:\u09ea\u09ed am \u09aa\u09b0\u09cd\u09af\u09a8\u09cd\u09a4)',tithis:[{name:'Shashthi Tithi',nameBn:'\u09b7\u09b7\u09cd\u09a0\u09c0 \u09a4\u09bf\u09a5\u09bf',startTime:'Oct 15, 01:43 AM',endTime:'Oct 16, 03:47 AM (Night)',description:'Shashthi tithi concludes at 03:47 AM night according to 1433 Bengali Panjika.',descriptionBn:'\u09e7\u09ea\u09e9\u09e9 \u09b8\u09be\u09b2\u09c7\u09b0 \u09a6\u09c1\u09b0\u09cd\u0997\u09be \u09aa\u09c2\u099c\u09be\u09b0 \u09b8\u09ae\u09df\u09b8\u09c2\u099a\u09c0 \u0985\u09a8\u09c1\u09af\u09be\u09af\u09bc\u09c0 \u09b7\u09b7\u09cd\u09a0\u09c0 \u09a4\u09bf\u09a5\u09bf \u09b0\u09be\u09a4 \u09e6\u09e9:\u09ea\u09ed am \u09aa\u09b0\u09cd\u09af\u09a8\u09cd\u09a4\u0964'}]},{id:'maha-saptami-2026',slug:'maha-saptami',dayName:'Maha Saptami (\u09ae\u09b9\u09be \u09b8\u09aa\u09cd\u09a4\u09ae\u09c0)',dayNameBn:'\u09ae\u09b9\u09be \u09b8\u09aa\u09cd\u09a4\u09ae\u09c0',dateString:'Saturday, October 17 \u2013 Sunday, October 18, 2026',gregorianDate:'2026-10-17',significance:'Arrival of Nabapatrika (Kola Bou) after morning holy bath at the river, representing nature and agriculture fertility, followed by Pran Pratishtha. Saptami extends from Saturday into Sunday morning.',significanceBn:'\u09a8\u09ac\u09aa\u09a4\u09cd\u09b0\u09bf\u0995\u09be \u09ac\u09be \u0995\u09b2\u09be\u09ac\u0989 \u09b8\u09cd\u09a8\u09be\u09a8 \u0993 \u09aa\u09cd\u09b0\u09be\u09a3\u09aa\u09cd\u09b0\u09a4\u09bf\u09b7\u09cd\u09a0\u09be\u0964 \u09a8\u09af\u09bc\u099f\u09bf \u0989\u09a6\u09cd\u09ad\u09bf\u09a6\u09c7\u09b0 \u09b8\u09ae\u09a8\u09cd\u09ac\u09af\u09bc\u09c7 \u09aa\u09cd\u09b0\u0995\u09c3\u09a4\u09bf \u09b0\u09c2\u09aa\u09bf\u09a3\u09c0 \u09a6\u09c7\u09ac\u09c0\u09b0 \u09aa\u09c1\u099c\u09cb \u0993 \u09ae\u09b9\u09be\u09b8\u09aa\u09cd\u09a4\u09ae\u09c0\u09b0 \u0985\u099e\u09cd\u099c\u09b2\u09bf\u0964 \u09e7\u09ed \u0985\u0995\u09cd\u099f\u09cb\u09ac\u09b0 \u09b6\u09a8\u09bf\u09ac\u09be\u09b0 \u09b6\u09c1\u09b0\u09c1 \u09b9\u09af\u09bc\u09c7 \u09e7\u09ee \u0985\u0995\u09cd\u099f\u09cb\u09ac\u09b0 \u09b0\u09ac\u09bf\u09ac\u09be\u09b0 \u09b8\u0995\u09be\u09b2 \u09e6\u09eb:\u09eb\u09e9 \u09aa\u09b0\u09cd\u09af\u09a8\u09cd\u09a4 \u09b8\u09aa\u09cd\u09a4\u09ae\u09c0 \u09a4\u09bf\u09a5\u09bf\u0964',rituals:['Nabapatrika Snan (holy river bath for 9 plant bundle tied with yellow sari)','Pran Pratishtha (infusing divine life into the clay image)','Shodashopachara Puja with 16 sacred offerings','Evening Aarti with rhythmic Dhak and Dhunuchi dance'],ritualsBn:['\u09a8\u09ac\u09aa\u09a4\u09cd\u09b0\u09bf\u0995\u09be \u09b8\u09cd\u09a8\u09be\u09a8 \u0993 \u0995\u09b2\u09be\u09ac\u0989 \u09aa\u09cd\u09b0\u09ac\u09c7\u09b6','\u09aa\u09cd\u09b0\u09a4\u09bf\u09ae\u09be\u09af\u09bc \u09aa\u09cd\u09b0\u09be\u09a3\u09aa\u09cd\u09b0\u09a4\u09bf\u09b7\u09cd\u09a0\u09be \u0993 \u099a\u0995\u09cd\u09b7\u09c1 \u0989\u09a8\u09cd\u09ae\u09cb\u099a\u09a8','\u09b7\u09cb\u09a1\u09bc\u09b6\u09cb\u09aa\u099a\u09be\u09b0\u09c7 \u09ae\u09b9\u09be\u09b8\u09aa\u09cd\u09a4\u09ae\u09c0 \u09aa\u09c2\u099c\u09be','\u09b8\u09be\u09a8\u09cd\u09a7\u09cd\u09af \u0986\u09b0\u09a4\u09bf \u0993 \u09a7\u09c1\u09a8\u09c1\u099a\u09bf \u09a8\u09be\u099a'],pushpanjaliTimings:'08:30 AM - 10:15 AM (Tithi till Sun 05:53 AM)',pushpanjaliTimingsBn:'\u09b8\u0995\u09be\u09b2 \u09ee:\u09e9\u09e6 - \u09b8\u0995\u09be\u09b2 \u09e7\u09e6:\u09e7\u09eb (\u09a4\u09bf\u09a5\u09bf \u09b0\u09ac\u09bf\u09ac\u09be\u09b0 \u09b8\u0995\u09be\u09b2 \u09e6\u09eb:\u09eb\u09e9 \u09aa\u09b0\u09cd\u09af\u09a8\u09cd\u09a4)',bhogTimings:'12:30 PM - 02:00 PM (Khichuri Bhog, Labra, Payesh)',bhogTimingsBn:'\u09a6\u09c1\u09aa\u09c1\u09b0 \u09e7\u09e8:\u09e9\u09e6 - \u09a6\u09c1\u09aa\u09c1\u09b0 \u09e8:\u09e6\u09e6 (\u0996\u09bf\u099a\u09c1\u09a1\u09bc\u09bf \u09ad\u09cb\u0997, \u09b2\u09be\u09ac\u09a1\u09bc\u09be, payesh)',tithis:[{name:'Saptami Tithi',nameBn:'\u09b8\u09aa\u09cd\u09a4\u09ae\u09c0 \u09a4\u09bf\u09a5\u09bf',startTime:'Oct 16, 03:47 AM',endTime:'Oct 18, 05:53 AM',description:'Saptami spans Saturday 17 October through Sunday 18 October, ending at 05:53 AM morning.',descriptionBn:'\u09e7\u09ed \u0985\u0995\u09cd\u099f\u09cb\u09ac\u09b0 \u09b6\u09a8\u09bf\u09ac\u09be\u09b0 \u0993 \u09e7\u09ee \u0985\u0995\u09cd\u099f\u09cb\u09ac\u09b0 \u09b0\u09ac\u09bf\u09ac\u09be\u09b0 \u09b8\u0995\u09be\u09b2 \u09e6\u09eb:\u09eb\u09e9 \u09aa\u09b0\u09cd\u09af\u09a8\u09cd\u09a4 \u09b8\u09aa\u09cd\u09a4\u09ae\u09c0 \u09a4\u09bf\u09a5\u09bf\u0964'}]},{id:'maha-ashtami-2026',slug:'maha-ashtami',dayName:'Maha Ashtami & Sandhi Puja (\u09ae\u09b9\u09be \u0985\u09b7\u09cd\u099f\u09ae\u09c0 \u0993 \u09b8\u09a8\u09cd\u09a7\u09bf\u09aa\u09c2\u099c\u09be)',dayNameBn:'\u09ae\u09b9\u09be \u0985\u09b7\u09cd\u099f\u09ae\u09c0 \u0993 \u09b8\u09a8\u09cd\u09a7\u09bf\u09aa\u09c2\u099c\u09be',dateString:'Monday, October 19, 2026',gregorianDate:'2026-10-19',significance:'The most sacred day of Durga Puja. Devotees fast for Ashtami Pushpanjali, followed by the momentous Sandhi Puja (07:26 AM - 08:14 AM) with Balidan at 07:50 AM, 108 lotus flowers, and 108 lamps.',significanceBn:'\u09b6\u09be\u09b0\u09a6\u09cb\u09ce\u09b8\u09ac\u09c7\u09b0 \u09b8\u09b0\u09cd\u09ac\u09be\u09a7\u09bf\u0995 \u09aa\u09ac\u09bf\u09a4\u09cd\u09b0 \u09a6\u09bf\u09a8\u0964 \u0990\u09a4\u09bf\u09b9\u09cd\u09af\u09ac\u09be\u09b9\u09c0 \u09b8\u09be\u099c\u09c7 \u0989\u09aa\u09ac\u09be\u09b8 \u09b0\u09c7\u0996\u09c7 \u0985\u099e\u09cd\u099c\u09b2\u09bf \u09aa\u09cd\u09b0\u09a6\u09be\u09a8, \u0995\u09c1\u09ae\u09be\u09b0\u09c0 \u09aa\u09c2\u099c\u09be \u098f\u09ac\u0982 \u09b8\u0995\u09be\u09b2 \u09e6\u09ed:\u09e8\u09ec \u09a5\u09c7\u0995\u09c7 \u09e6\u09ee:\u09e7\u09ea \u09aa\u09b0\u09cd\u09af\u09a8\u09cd\u09a4 \u09e7\u09e6\u09ee \u09aa\u09a6\u09cd\u09ae \u0993 \u09e7\u09e6\u09ee \u09aa\u09cd\u09b0\u09a6\u09c0\u09aa\u09c7 \u09b8\u09a8\u09cd\u09a7\u09bf\u09aa\u09c2\u099c\u09be \u0993 \u09ac\u09b2\u09bf\u09a6\u09be\u09a8 (\u09b8\u0995\u09be\u09b2 \u09e6\u09ed:\u09eb\u09e6)\u0964',rituals:['Grand Maha Ashtami Pushpanjali concluding before 07:50 AM','Kumari Puja (worship of a young girl child as living divine embodiment)','Sandhi Puja (07:26 AM to 08:14 AM, junction when Devi Chamunda slays Chanda & Munda)','Sandhi Puja Balidan at 07:50 AM with 108 Pradips and 108 blue lotuses'],ritualsBn:['\u09ad\u0995\u09cd\u09a4\u09bf\u09ad\u09b0\u09c7 \u09ae\u09b9\u09be \u0985\u09b7\u09cd\u099f\u09ae\u09c0\u09b0 \u0985\u099e\u09cd\u099c\u09b2\u09bf \u09aa\u09cd\u09b0\u09a6\u09be\u09a8 (\u09b8\u0995\u09be\u09b2 \u09e6\u09ed:\u09eb\u09e6 \u098f\u09b0 \u09ae\u09a7\u09cd\u09af\u09c7 \u09b8\u09ae\u09be\u09aa\u09cd\u09af)','\u0995\u09c1\u09ae\u09be\u09b0\u09c0 \u09aa\u09c2\u099c\u09be (\u09ac\u09be\u09b2\u09bf\u0995\u09be\u0995\u09c7 \u099c\u09c0\u09ac\u09a8\u09cd\u09a4 \u09a6\u09c7\u09ac\u09c0\u09b0\u09c2\u09aa\u09c7 \u09ac\u09a8\u09cd\u09a6\u09a8\u09be)','\u09b8\u09a8\u09cd\u09a7\u09bf\u09aa\u09c2\u099c\u09be (\u09b8\u0995\u09be\u09b2 \u09e6\u09ed:\u09e8\u09ec \u09a5\u09c7\u0995\u09c7 \u09e6\u09ee:\u09e7\u09ea \u09aa\u09b0\u09cd\u09af\u09a8\u09cd\u09a4 \u099a\u09a3\u09cd\u09a1 \u0993 \u09ae\u09c1\u09a3\u09cd\u09a1 \u09ac\u09a7\u09c7\u09b0 \u09aa\u09c1\u09a3\u09cd\u09af\u09b2\u0997\u09cd\u09a8)','\u09b8\u0995\u09be\u09b2 \u09e6\u09ed:\u09eb\u09e6 \u098f \u09b8\u09a8\u09cd\u09a7\u09bf\u09aa\u09c2\u099c\u09be \u09ac\u09b2\u09bf\u09a6\u09be\u09a8, \u09e7\u09e6\u09ee\u099f\u09bf \u09ae\u09be\u099f\u09bf\u09b0 \u09aa\u09cd\u09b0\u09a6\u09c0\u09aa \u0993 \u09e7\u09e6\u09ee\u099f\u09bf \u09a8\u09c0\u09b2 \u09aa\u09a6\u09cd\u09ae \u09a8\u09bf\u09ac\u09c7\u09a6\u09a8'],pushpanjaliTimings:'06:30 AM - 07:45 AM (Must conclude before 07:50 AM)',pushpanjaliTimingsBn:'\u09b8\u0995\u09be\u09b2 \u09ec:\u09e9\u09e6 - \u09b8\u0995\u09be\u09b2 \u09ed:\u09ea\u09eb (\u09b8\u0995\u09be\u09b2 \u09ed:\u09eb\u09e6 \u098f\u09b0 \u09ae\u09a7\u09cd\u09af\u09c7 \u09b8\u09ae\u09be\u09aa\u09cd\u09af)',bhogTimings:'12:30 PM - 02:30 PM (Bhog Prasad & Chutney)',bhogTimingsBn:'\u09a6\u09c1\u09aa\u09c1\u09b0 \u09e7\u09e8:\u09e9\u09e6 - \u09a6\u09c1\u09aa\u09c1\u09b0 \u09e8:\u09e9\u09e6 (\u0996\u09bf\u099a\u09c1\u09a1\u09bc\u09bf, \u09ac\u09c7\u0997\u09c1\u09a8\u09ad\u09be\u099c\u09be, \u09aa\u09be\u09af\u09bc\u09c7\u09b8, \u099a\u09be\u099f\u09a8\u09bf)',tithis:[{name:'Maha Ashtami Tithi',nameBn:'\u09ae\u09b9\u09be \u0985\u09b7\u09cd\u099f\u09ae\u09c0 \u09a4\u09bf\u09a5\u09bf',startTime:'Oct 18, 05:53 AM',endTime:'Oct 19, 07:50 AM',description:'Maha Ashtami tithi concludes at 07:50 AM Monday morning as per the 1433 Bengali schedule.',descriptionBn:'\u09e7\u09ea\u09e9\u09e9 \u09b8\u09be\u09b2\u09c7\u09b0 \u09a6\u09c1\u09b0\u09cd\u0997\u09be \u09aa\u09c2\u099c\u09be\u09b0 \u09b8\u09ae\u09df\u09b8\u09c2\u099a\u09c0 \u0985\u09a8\u09c1\u09af\u09be\u09af\u09bc\u09c0 \u0985\u09b7\u09cd\u099f\u09ae\u09c0 \u09a4\u09bf\u09a5\u09bf \u09b8\u0995\u09be\u09b2 \u09e6\u09ed:\u09eb\u09e6 \u099f\u09be \u09aa\u09b0\u09cd\u09af\u09a8\u09cd\u09a4\u0964'},{name:'Sandhi Puja Window (1433 Bangabda)',nameBn:'\u09b8\u09a8\u09cd\u09a7\u09bf\u09aa\u09c2\u099c\u09be \u09b2\u0997\u09cd\u09a8 (\u09e7\u09ea\u09e9\u09e9 \u09ac\u0999\u09cd\u0997\u09be\u09ac\u09cd\u09a6)',startTime:'Oct 19, 07:26 AM',endTime:'Oct 19, 08:14 AM',description:'Sandhi Puja starts at 07:26 AM, Balidan at 07:50 AM, concludes at 08:14 AM (48 minutes).',descriptionBn:'\u09b8\u09a8\u09cd\u09a7\u09bf \u09aa\u09c2\u099c\u09be \u09b6\u09c1\u09b0\u09c1 \u09e6\u09ed:\u09e8\u09ec am \u09b8\u0995\u09be\u09b2, \u09ac\u09b2\u09bf\u09a6\u09be\u09a8 \u09e6\u09ed:\u09eb\u09e6 am \u09b8\u0995\u09be\u09b2, \u09b6\u09c7\u09b7 \u09e6\u09ee:\u09e7\u09ea am \u09b8\u0995\u09be\u09b2 (\u09ea\u09ee \u09ae\u09bf\u09a8\u09bf\u099f)\u0964'}]},{id:'maha-nabami-2026',slug:'maha-nabami',dayName:'Maha Nabami (\u09ae\u09b9\u09be \u09a8\u09ac\u09ae\u09c0)',dayNameBn:'\u09ae\u09b9\u09be \u09a8\u09ac\u09ae\u09c0',dateString:'Tuesday, October 20, 2026',gregorianDate:'2026-10-20',significance:'The celebratory day marking the final victory of Devi Mahishasuramardini over the demon Mahishasura. Navami tithi lasts until 09:31 AM, followed by Maha Nabami Homa and jubilant pandal hopping.',significanceBn:'\u0985\u09b8\u09c1\u09b0 \u09b8\u0982\u09b9\u09be\u09b0\u09c7\u09b0 \u099a\u09b0\u09ae \u09ac\u09bf\u099c\u09af\u09bc \u09ae\u09c1\u09b9\u09c2\u09b0\u09cd\u09a4\u0964 \u09ae\u09b9\u09be \u09a8\u09ac\u09ae\u09c0\u09b0 \u09ac\u09bf\u09b6\u09c7\u09b7 \u09b9\u09cb\u09ae-\u09af\u099c\u09cd\u099e, \u09ac\u09b2\u09bf\u09a6\u09be\u09a8 \u09b0\u09c2\u09aa \u09aa\u09cd\u09b0\u09a4\u09c0\u0995\u09c0 \u09aa\u09c2\u099c\u09be \u098f\u09ac\u0982 \u09b8\u09be\u09b0\u09be \u09b0\u09be\u09a4\u09ac\u09cd\u09af\u09be\u09aa\u09c0 \u0986\u09a8\u09a8\u09cd\u09a6\u09cb\u099a\u09cd\u099b\u09cd\u09ac\u09b2 \u09a0\u09be\u0995\u09c1\u09b0 \u09a6\u09c7\u0996\u09be\u0964 \u09a8\u09ac\u09ae\u09c0 \u09a4\u09bf\u09a5\u09bf \u09b8\u0995\u09be\u09b2 \u09e6\u09ef:\u09e9\u09e7 \u09aa\u09b0\u09cd\u09af\u09a8\u09cd\u09a4\u0964',rituals:['Maha Nabami Homa and sacred fire sacrifice','Balidaan ritual (symbolic fruit/gourd cutting)','Grand Dhunuchi dance competitions to fiery Dhak beats','All-night pandal hopping across North and South Kolkata'],ritualsBn:['\u09ae\u09b9\u09be \u09a8\u09ac\u09ae\u09c0\u09b0 \u09ae\u09b9\u09be\u09af\u099c\u09cd\u099e \u0993 \u09b9\u09cb\u09ae','\u09aa\u09cd\u09b0\u09a4\u09c0\u0995\u09c0 \u09ac\u09b2\u09bf\u09a6\u09be\u09a8 \u0993 \u09ad\u09cb\u0997 \u09a8\u09bf\u09ac\u09c7\u09a6\u09a8','\u09ae\u09a3\u09cd\u09a1\u09aa\u09c7 \u09ae\u09a3\u09cd\u09a1\u09aa\u09c7 \u0989\u09a8\u09cd\u09ae\u09be\u09a4\u09be\u09b2 \u09a7\u09c1\u09a8\u09c1\u099a\u09bf \u09a8\u09be\u099a \u09aa\u09cd\u09b0\u09a4\u09bf\u09af\u09cb\u0997\u09bf\u09a4\u09be','\u09b0\u09be\u09a4\u09ad\u09b0 \u09ac\u09be\u0981\u09a7\u09ad\u09be\u0999\u09be \u09aa\u09cd\u09af\u09be\u09a8\u09cd\u09a1\u09c7\u09b2 \u09b9\u09aa\u09bf\u0982 \u0993 \u0989\u09b2\u09cd\u09b2\u09be\u09b8'],pushpanjaliTimings:'08:00 AM - 09:15 AM (Tithi ends at 09:31 AM)',pushpanjaliTimingsBn:'\u09b8\u0995\u09be\u09b2 \u09ee:\u09e6\u09e6 - \u09b8\u0995\u09be\u09b2 \u09ef:\u09e7\u09eb (\u09a4\u09bf\u09a5\u09bf \u09b8\u0995\u09be\u09b2 \u09e6\u09ef:\u09e9\u09e7 \u09aa\u09b0\u09cd\u09af\u09a8\u09cd\u09a4)',bhogTimings:'01:00 PM - 03:00 PM (Bhog distribution)',bhogTimingsBn:'\u09a6\u09c1\u09aa\u09c1\u09b0 \u09e7:\u09e6\u09e6 - \u09a6\u09c1\u09aa\u09c1\u09b0 \u09e9:\u09e6\u09e6',tithis:[{name:'Nabami Tithi',nameBn:'\u09a8\u09ac\u09ae\u09c0 \u09a4\u09bf\u09a5\u09bf',startTime:'Oct 19, 07:50 AM',endTime:'Oct 20, 09:31 AM',description:'Maha Navami tithi concludes at 09:31 AM Tuesday morning.',descriptionBn:'\u09e7\u09ea\u09e9\u09e9 \u09b8\u09be\u09b2\u09c7\u09b0 \u09aa\u099e\u09cd\u099c\u09bf\u0995\u09be \u09ae\u09a4\u09c7 \u09a8\u09ac\u09ae\u09c0 \u09a4\u09bf\u09a5\u09bf \u09b8\u0995\u09be\u09b2 \u09e6\u09ef:\u09e9\u09e7 \u09aa\u09b0\u09cd\u09af\u09a8\u09cd\u09a4\u0964'}]},{id:'bijoya-dashami-2026',slug:'bijoya-dashami',dayName:'Bijoya Dashami & Sindoor Khela (\u09ac\u09bf\u099c\u09af\u09bc\u09be \u09a6\u09b6\u09ae\u09c0 \u0993 \u09b8\u09bf\u0981\u09a6\u09c1\u09b0 \u0989\u09ce\u09b8\u09ac)',dayNameBn:'\u09ac\u09bf\u099c\u09af\u09bc\u09be \u09a6\u09b6\u09ae\u09c0 \u0993 \u09b8\u09bf\u0981\u09a6\u09c1\u09b0 \u0989\u09ce\u09b8\u09ac',dateString:'Wednesday, October 21, 2026',gregorianDate:'2026-10-21',significance:'Bittersweet farewell as Mother Durga departs for Mount Kailash. Dashami tithi continues till 10:47 AM, followed by Aparajita Puja, Dadhikarma, Debi Bisorjon (immersion), and joyous Sindoor Khela.',significanceBn:'\u09ac\u09bf\u09a6\u09be\u09af\u09bc\u09c7\u09b0 \u09b8\u09c1\u09b0 \u0986\u09b0 \u09ac\u09bf\u09b7\u09be\u09a6\u09ae\u09af\u09bc \u0986\u09a8\u09a8\u09cd\u09a6\u09c7\u09b0 \u09ae\u09bf\u09b2\u09a8\u0964 \u09a6\u09b6\u09ae\u09c0 \u09a4\u09bf\u09a5\u09bf \u09b8\u0995\u09be\u09b2 \u09e7\u09e6:\u09ea\u09ed \u09aa\u09b0\u09cd\u09af\u09a8\u09cd\u09a4, \u098f\u09b0\u09aa\u09b0 \u0985\u09aa\u09b0\u09be\u099c\u09bf\u09a4\u09be \u09aa\u09c2\u099c\u09be, \u09a6\u09a7\u09bf\u0995\u09b0\u09cd\u09ae, \u09a6\u09c7\u09ac\u09c0 \u09ac\u09bf\u09b8\u09b0\u09cd\u099c\u09a8 \u098f\u09ac\u0982 \u09b8\u09bf\u0981\u09a6\u09c1\u09b0 \u0989\u09ce\u09b8\u09ac\u0964 \u09ae\u09bf\u09b7\u09cd\u099f\u09bf\u09ae\u09c1\u0996 \u0993 \u2018\u09b6\u09c1\u09ad \u09ac\u09bf\u099c\u09af\u09bc\u09be\u2019\u09b0 \u09b6\u09c1\u09ad\u09c7\u099a\u09cd\u099b\u09be \u09ac\u09bf\u09a8\u09bf\u09ae\u09af\u09bc\u0964',rituals:['Aparajita Puja and Dadhikarma ceremonies','Darpan Visarjan (symbolic farewell through reflection in water mirror)','Sindoor Khela (Sindur Utsab vermilion ritual among married women with sweets)','Grand immersion procession (Debi Bisorjon) to Ganges Ghats with firecrackers and Dhak','Shubho Bijoya greetings, hugging (Kola-Koli), and sweet distribution'],ritualsBn:['\u0985\u09aa\u09b0\u09be\u099c\u09bf\u09a4\u09be \u09aa\u09c2\u099c\u09be \u0993 \u09a6\u09a7\u09bf\u0995\u09b0\u09cd\u09ae \u09aa\u09be\u09b2\u09a8','\u09a6\u09b0\u09cd\u09aa\u09a3 \u09ac\u09bf\u09b8\u09b0\u09cd\u099c\u09a8 (\u099c\u09b2\u09c7\u09b0 \u09a6\u09b0\u09cd\u09aa\u09a3\u09c7 \u09a6\u09c7\u09ac\u09c0\u09b0 \u09aa\u09cd\u09b0\u09a4\u09bf\u09ac\u09bf\u09ae\u09cd\u09ac \u09ac\u09bf\u09a6\u09be\u09af\u09bc)','\u09ae\u09b9\u09bf\u09b2\u09be\u09a6\u09c7\u09b0 \u09b8\u09bf\u0981\u09a6\u09c1\u09b0 \u0989\u09ce\u09b8\u09ac \u0993 \u09ae\u09bf\u09b7\u09cd\u099f\u09bf\u09ae\u09c1\u0996','\u09a6\u09c7\u09ac\u09c0 \u09ac\u09bf\u09b8\u09b0\u09cd\u099c\u09a8 \u0993 \u0997\u0999\u09cd\u0997\u09be\u09b0 \u0998\u09be\u099f\u09c7 \u09ac\u09b0\u09cd\u09a3\u09be\u09a2\u09cd\u09af \u09b6\u09cb\u09ad\u09be\u09af\u09be\u09a4\u09cd\u09b0\u09be','\u2018\u09b6\u09c1\u09ad \u09ac\u09bf\u099c\u09af\u09bc\u09be\u2019\u09b0 \u09b6\u09c1\u09ad\u09c7\u099a\u09cd\u099b\u09be \u09ac\u09bf\u09a8\u09bf\u09ae\u09af\u09bc, \u0995\u09cb\u09b2\u09be\u0995\u09c1\u09b2\u09bf \u0993 \u09ae\u09bf\u09b7\u09cd\u099f\u09bf \u09ac\u09bf\u09a4\u09b0\u09a3'],pushpanjaliTimings:'08:30 AM - 10:30 AM (Aparajita Puja & Pushpanjali)',pushpanjaliTimingsBn:'\u09b8\u0995\u09be\u09b2 \u09ee:\u09e9\u09e6 - \u09b8\u0995\u09be\u09b2 \u09e7\u09e6:\u09e9\u09e6 (\u0985\u09aa\u09b0\u09be\u099c\u09bf\u09a4\u09be \u09aa\u09c2\u099c\u09be \u0993 \u0985\u099e\u09cd\u099c\u09b2\u09bf)',tithis:[{name:'Dashami Tithi',nameBn:'\u09a6\u09b6\u09ae\u09c0 \u09a4\u09bf\u09a5\u09bf',startTime:'Oct 20, 09:31 AM',endTime:'Oct 21, 10:47 AM',description:'Dashami tithi concludes at 10:47 AM Wednesday morning; followed by Aparajita Puja, Dadhikarma, Debi Bisorjon, and Sindur Utsab.',descriptionBn:'\u09a6\u09b6\u09ae\u09c0 \u09a4\u09bf\u09a5\u09bf \u09b8\u0995\u09be\u09b2 \u09e7\u09e6:\u09ea\u09ed \u099f\u09be \u09aa\u09b0\u09cd\u09af\u09a8\u09cd\u09a4; \u0985\u09aa\u09b0\u09be\u099c\u09bf\u09a4\u09be \u09aa\u09c2\u099c\u09be, \u09a6\u09a7\u09bf\u0995\u09b0\u09cd\u09ae, \u09a6\u09c7\u09ac\u09c0 \u09ac\u09bf\u09b8\u09b0\u09cd\u099c\u09a8, \u09b8\u09bf\u0981\u09a6\u09c1\u09b0 \u0989\u09ce\u09b8\u09ac\u0964'}]}]},1082,[]);
__d(function(g,r,i,a,m,e,d){"use strict";Object.defineProperty(e,'__esModule',{value:!0}),Object.defineProperty(e,"SANDHI_PUJA_SCHEDULES",{enumerable:!0,get:function(){return n}}),e.getSandhiPujaSchedule=function(t=2026){return n[t]||n[2026]};var n={2026:{year:2026,location:'Kolkata, West Bengal',timezone:'Asia/Kolkata (IST)',primaryConventionId:'bangabda-1433-schedule',conventions:[{id:'bangabda-1433-schedule',name:'Bengali Almanac 1433 Schedule (\u09e7\u09ea\u09e9\u09e9 \u09ac\u0999\u09cd\u0997\u09be\u09ac\u09cd\u09a6 \u09ac\u09bf\u09b6\u09c1\u09a6\u09cd\u09a7 \u09a8\u09bf\u09b0\u09cd\u0998\u09a3\u09cd\u099f)',nameBn:'\u09e7\u09ea\u09e9\u09e9 \u09b8\u09be\u09b2\u09c7\u09b0 \u09a6\u09c1\u09b0\u09cd\u0997\u09be \u09aa\u09c2\u099c\u09be\u09b0 \u09b8\u09ae\u09df\u09b8\u09c2\u099a\u09c0 (\u0985\u09a8\u09c1\u09ae\u09cb\u09a6\u09bf\u09a4 \u09aa\u099e\u09cd\u099c\u09bf\u0995\u09be \u09a8\u09bf\u09b0\u09cd\u0998\u09a3\u09cd\u099f)',panjikaSystem:'Surya Siddhanta',panjikaSystemBn:'\u09e7\u09ea\u09e9\u09e9 \u09ac\u0999\u09cd\u0997\u09be\u09ac\u09cd\u09a6 \u09aa\u099e\u09cd\u099c\u09bf\u0995\u09be',sourceName:'\u09e7\u09ea\u09e9\u09e9 \u09b8\u09be\u09b2\u09c7\u09b0 \u09a6\u09c1\u09b0\u09cd\u0997\u09be \u09aa\u09c2\u099c\u09be\u09b0 \u09b8\u09ae\u09df\u09b8\u09c2\u099a\u09c0 (Approved 1433 Almanac Reference)',sourceUrl:'https://pujopath-five.vercel.app/calendar#sandhi-puja-section',year:2026,location:'Kolkata, West Bengal (22.5726\xb0 N, 88.3639\xb0 E)',locationBn:'\u0995\u09b2\u0995\u09be\u09a4\u09be, \u09aa\u09b6\u09cd\u099a\u09bf\u09ae\u09ac\u0999\u09cd\u0997 (\u09e8\u09e8.\u09eb\u09ed\u09e8\u09ec\xb0 \u0989, \u09ee\u09ee.\u09e9\u09ec\u09e9\u09ef\xb0 \u09aa\u09c2)',coordinates:{lat:22.5726,lng:88.3639},festival:'Sandhi Puja (\u09b8\u09a8\u09cd\u09a7\u09bf\u09aa\u09c2\u099c\u09be)',festivalBn:'\u09b8\u09a8\u09cd\u09a7\u09bf\u09aa\u09c2\u099c\u09be \u0993 \u09ac\u09b2\u09bf\u09a6\u09be\u09a8 \u09b2\u0997\u09cd\u09a8',dateString:'Monday, 19 October 2026',dateStringBn:'\u09b8\u09cb\u09ae\u09ac\u09be\u09b0, \u09e7\u09ef \u0985\u0995\u09cd\u099f\u09cb\u09ac\u09b0 \u09e8\u09e6\u09e8\u09ec',gregorianDate:'2026-10-19',startTime:'07:26 AM IST',endTime:'08:14 AM IST',startTimeBn:'\u09b8\u0995\u09be\u09b2 \u09e6\u09ed:\u09e8\u09ec (IST)',endTimeBn:'\u09b8\u0995\u09be\u09b2 \u09e6\u09ee:\u09e7\u09ea (IST)',durationMinutes:48,durationDisplay:'48 minutes (2 Dandas: 07:26 AM \u2013 08:14 AM)',durationDisplayBn:'\u09ea\u09ee \u09ae\u09bf\u09a8\u09bf\u099f (\u09e8 \u09a6\u09a3\u09cd\u09a1: \u09b8\u0995\u09be\u09b2 \u09e6\u09ed:\u09e8\u09ec \u2013 \u09b8\u0995\u09be\u09b2 \u09e6\u09ee:\u09e7\u09ea)',ashtamiEndTransition:'Last 24 minutes of Maha Ashtami (07:26 AM \u2013 07:50 AM)',navamiStartTransition:'First 24 minutes of Maha Navami (07:50 AM \u2013 08:14 AM)',significance:'Sandhi Puja commemorates the supreme cosmic moment when Goddess Durga assumed the fiery form of Chamunda to vanquish demons Chanda and Munda. According to the authoritative 1433 schedule, Sandhi Puja starts at 07:26 AM, sacred Balidan takes place at 07:50 AM at the exact juncture of Ashtami and Navami, and concludes at 08:14 AM with the lighting of 108 earthen lamps and offering of 108 blue lotuses.',significanceBn:'\u09e7\u09ea\u09e9\u09e9 \u09b8\u09be\u09b2\u09c7\u09b0 \u09a6\u09c1\u09b0\u09cd\u0997\u09be \u09aa\u09c2\u099c\u09be\u09b0 \u09b8\u09ae\u09df\u09b8\u09c2\u099a\u09c0 \u0985\u09a8\u09c1\u09af\u09be\u09af\u09bc\u09c0 \u09b8\u09a8\u09cd\u09a7\u09bf\u09aa\u09c2\u099c\u09be \u09b6\u09c1\u09b0\u09c1 \u09b9\u09af\u09bc \u09b8\u0995\u09be\u09b2 \u09e6\u09ed:\u09e8\u09ec am, \u09b8\u09a8\u09cd\u09a7\u09bf\u09aa\u09c2\u099c\u09be \u09ac\u09b2\u09bf\u09a6\u09be\u09a8 \u09b8\u0995\u09be\u09b2 \u09e6\u09ed:\u09eb\u09e6 am \u098f\u09ac\u0982 \u09b8\u09a8\u09cd\u09a7\u09bf\u09aa\u09c2\u099c\u09be \u09b8\u09ae\u09be\u09aa\u09cd\u09a4 \u09b9\u09af\u09bc \u09b8\u0995\u09be\u09b2 \u09e6\u09ee:\u09e7\u09ea am\u0964 \u0985\u09b7\u09cd\u099f\u09ae\u09c0 \u09a4\u09bf\u09a5\u09bf\u09b0 \u09b6\u09c7\u09b7 \u09e8\u09ea \u09ae\u09bf\u09a8\u09bf\u099f \u098f\u09ac\u0982 \u09a8\u09ac\u09ae\u09c0 \u09a4\u09bf\u09a5\u09bf\u09b0 \u09aa\u09cd\u09b0\u09a5\u09ae \u09e8\u09ea \u09ae\u09bf\u09a8\u09bf\u099f\u2014\u098f\u0987 \u09ea\u09ee \u09ae\u09bf\u09a8\u09bf\u099f\u09c7\u09b0 \u09ae\u09b9\u09be\u09ae\u09bf\u09b2\u09a8 \u0995\u09cd\u09b7\u09a3\u09c7 \u09e7\u09e6\u09ee\u099f\u09bf \u09ae\u09be\u099f\u09bf\u09b0 \u09aa\u09cd\u09b0\u09a6\u09c0\u09aa \u0993 \u09e7\u09e6\u09ee\u099f\u09bf \u09a8\u09c0\u09b2\u09aa\u09a6\u09cd\u09ae \u09a8\u09bf\u09ac\u09c7\u09a6\u09a8\u09c7\u09b0 \u09ae\u09be\u09a7\u09cd\u09af\u09ae\u09c7 \u09a6\u09c7\u09ac\u09c0\u09b0 \u09ae\u09b9\u09be\u09b6\u0995\u09cd\u09a4\u09bf\u09b0 \u0989\u09aa\u09be\u09b8\u09a8\u09be \u0993 \u09ac\u09b2\u09bf\u09a6\u09be\u09a8 \u09b8\u09c1\u09b8\u09ae\u09cd\u09aa\u09a8\u09cd\u09a8 \u09b9\u09af\u09bc\u0964',calculationNote:'Approved reference timetable (\u09e7\u09ea\u09e9\u09e9 \u09b8\u09be\u09b2\u09c7\u09b0 \u09a6\u09c1\u09b0\u09cd\u0997\u09be \u09aa\u09c2\u099c\u09be\u09b0 \u09b8\u09ae\u09df\u09b8\u09c2\u099a\u09c0): Sandhi Puja begins at 07:26 AM, Balidan at 07:50 AM, ends at 08:14 AM on Monday, 19 October 2026 (Asia/Kolkata timezone).',calculationNoteBn:'\u09e7\u09ea\u09e9\u09e9 \u09b8\u09be\u09b2\u09c7\u09b0 \u09a6\u09c1\u09b0\u09cd\u0997\u09be \u09aa\u09c2\u099c\u09be\u09b0 \u0985\u09a8\u09c1\u09ae\u09cb\u09a6\u09bf\u09a4 \u09b8\u09ae\u09df\u09b8\u09c2\u099a\u09c0: \u09e7\u09ef \u0985\u0995\u09cd\u099f\u09cb\u09ac\u09b0 \u09e8\u09e6\u09e8\u09ec \u09b8\u09cb\u09ae\u09ac\u09be\u09b0 \u09b8\u0995\u09be\u09b2 \u09e6\u09ed:\u09e8\u09ec \u098f \u09b8\u09a8\u09cd\u09a7\u09bf\u09aa\u09c2\u099c\u09be \u09b6\u09c1\u09b0\u09c1, \u09b8\u0995\u09be\u09b2 \u09e6\u09ed:\u09eb\u09e6 \u098f \u09ac\u09b2\u09bf\u09a6\u09be\u09a8 \u098f\u09ac\u0982 \u09b8\u0995\u09be\u09b2 \u09e6\u09ee:\u09e7\u09ea \u098f \u09b8\u09a8\u09cd\u09a7\u09bf\u09aa\u09c2\u099c\u09be \u09b6\u09c7\u09b7 (\u098f\u09b6\u09bf\u09af\u09bc\u09be/\u0995\u09b2\u0995\u09be\u09a4\u09be \u09b8\u09ae\u09af\u09bc)\u0964',isPrimaryConvention:!0},{id:'drik-panchang-2026',name:'Drik Panchang (Drik Siddhanta / Modern Ephemeris)',nameBn:'\u09a6\u09c3\u0995 \u09b8\u09bf\u09a6\u09cd\u09a7\u09be\u09a8\u09cd\u09a4 (\u09a6\u09c3\u0995 \u09aa\u099e\u09cd\u099a\u09be\u0999\u09cd\u0997 \u09ac\u09bf\u09b6\u09c1\u09a6\u09cd\u09a7 \u0997\u09a3\u09a8\u09be)',panjikaSystem:'Drik Siddhanta',panjikaSystemBn:'\u09a6\u09c3\u0995 \u09b8\u09bf\u09a6\u09cd\u09a7\u09be\u09a8\u09cd\u09a4',sourceName:'Drik Panchang Kolkata (Geoname ID: 1275004)',sourceUrl:'https://www.drikpanchang.com/navratri/shardiya-navratri-sandhipuja.html?geoname-id=1275004&year=2026',year:2026,location:'Kolkata, West Bengal (22.5726\xb0 N, 88.3639\xb0 E)',locationBn:'\u0995\u09b2\u0995\u09be\u09a4\u09be, \u09aa\u09b6\u09cd\u099a\u09bf\u09ae\u09ac\u0999\u09cd\u0997 (\u09e8\u09e8.\u09eb\u09ed\u09e8\u09ec\xb0 \u0989, \u09ee\u09ee.\u09e9\u09ec\u09e9\u09ef\xb0 \u09aa\u09c2)',coordinates:{lat:22.5726,lng:88.3639},festival:'Sandhi Puja',festivalBn:'\u09b8\u09a8\u09cd\u09a7\u09bf\u09aa\u09c2\u099c\u09be',dateString:'Monday, 19 October 2026',dateStringBn:'\u09b8\u09cb\u09ae\u09ac\u09be\u09b0, \u09e7\u09ef \u0985\u0995\u09cd\u099f\u09cb\u09ac\u09b0 \u09e8\u09e6\u09e8\u09ec',gregorianDate:'2026-10-19',startTime:'10:27 AM IST',endTime:'11:15 AM IST',startTimeBn:'\u09b8\u0995\u09be\u09b2 \u09e7\u09e6:\u09e8\u09ed (IST)',endTimeBn:'\u09b8\u0995\u09be\u09b2 \u09e7\u09e7:\u09e7\u09eb (IST)',durationMinutes:48,durationDisplay:'48 minutes (2 Dandas)',durationDisplayBn:'\u09ea\u09ee \u09ae\u09bf\u09a8\u09bf\u099f (\u09e8 \u09a6\u09a3\u09cd\u09a1)',ashtamiEndTransition:'Last 24 minutes of Maha Ashtami Tithi',navamiStartTransition:'First 24 minutes of Maha Navami Tithi',significance:'Sandhi Puja commemorates the supreme cosmic moment when Goddess Durga assumed the fiery form of Chamunda to slay demons Chanda and Munda. It bridges the transition of Ashtami into Navami and is celebrated with the sacred lighting of 108 earthen lamps and the offering of 108 blue lotuses.',significanceBn:'\u0985\u09b7\u09cd\u099f\u09ae\u09c0 \u09a4\u09bf\u09a5\u09bf\u09b0 \u09b6\u09c7\u09b7 \u09e8\u09ea \u09ae\u09bf\u09a8\u09bf\u099f \u098f\u09ac\u0982 \u09a8\u09ac\u09ae\u09c0 \u09a4\u09bf\u09a5\u09bf\u09b0 \u09aa\u09cd\u09b0\u09a5\u09ae \u09e8\u09ea \u09ae\u09bf\u09a8\u09bf\u099f\u2014\u098f\u0987 \u09ea\u09ee \u09ae\u09bf\u09a8\u09bf\u099f\u09c7\u09b0 \u09ae\u09b9\u09be\u09ae\u09bf\u09b2\u09a8 \u0995\u09cd\u09b7\u09a3\u0987 \u09b8\u09a8\u09cd\u09a7\u09bf\u09aa\u09c2\u099c\u09be\u0964 \u099a\u09a3\u09cd\u09a1 \u0993 \u09ae\u09c1\u09a3\u09cd\u09a1 \u09ac\u09a7\u09c7\u09b0 \u0989\u09a6\u09cd\u09a6\u09c7\u09b6\u09cd\u09af\u09c7 \u09a6\u09c7\u09ac\u09c0 \u09a6\u09c1\u09b0\u09cd\u0997\u09be \u098f\u0987 \u09ae\u09b9\u09be\u09b2\u0997\u09cd\u09a8\u09c7\u0987 \u09b0\u09a3\u099a\u09a3\u09cd\u09a1\u09c0 \u099a\u09be\u09ae\u09c1\u09a3\u09cd\u09a1\u09be \u09b0\u09c2\u09aa\u09c7 \u0986\u09ac\u09bf\u09b0\u09cd\u09ad\u09c2\u09a4 \u09b9\u09af\u09bc\u09c7\u099b\u09bf\u09b2\u09c7\u09a8\u0964 \u09e7\u09e6\u09ee\u099f\u09bf \u09ae\u09be\u099f\u09bf\u09b0 \u09aa\u09cd\u09b0\u09a6\u09c0\u09aa \u0993 \u09e7\u09e6\u09ee\u099f\u09bf \u09a8\u09c0\u09b2\u09aa\u09a6\u09cd\u09ae \u09a8\u09bf\u09ac\u09c7\u09a6\u09a8\u09c7\u09b0 \u09ae\u09be\u09a7\u09cd\u09af\u09ae\u09c7 \u09a6\u09c7\u09ac\u09c0\u09b0 \u09ae\u09b9\u09be\u09b6\u0995\u09cd\u09a4\u09bf\u09b0 \u0989\u09aa\u09be\u09b8\u09a8\u09be \u0995\u09b0\u09be \u09b9\u09af\u09bc\u0964',calculationNote:'Calculated explicitly for Kolkata geographical coordinates (Asia/Kolkata timezone) using modern planetary positions (Drik astronomical algorithms). Followed by Ramakrishna Math & Mission (Belur Math) and modern astronomical institutes.',calculationNoteBn:'\u0995\u09b2\u0995\u09be\u09a4\u09be\u09b0 \u09ad\u09cc\u0997\u09cb\u09b2\u09bf\u0995 \u09b8\u09cd\u09a5\u09be\u09a8\u09be\u0999\u09cd\u0995 (\u098f\u09b6\u09bf\u09af\u09bc\u09be/\u0995\u09b2\u0995\u09be\u09a4\u09be \u09b8\u09ae\u09af\u09bc \u0985\u099e\u09cd\u099a\u09b2) \u098f\u09ac\u0982 \u0986\u09a7\u09c1\u09a8\u09bf\u0995 \u099c\u09cd\u09af\u09cb\u09a4\u09bf\u09b0\u09cd\u09ac\u09bf\u099c\u09cd\u099e\u09be\u09a8\u09c7\u09b0 \u0997\u09cd\u09b0\u09b9\u0997\u09a4\u09bf\u09b0 \u09b8\u09c2\u0995\u09cd\u09b7\u09cd\u09ae \u0997\u09a3\u09a8\u09be \u0985\u09a8\u09c1\u09af\u09be\u09af\u09bc\u09c0 \u09a8\u09bf\u09b0\u09cd\u09a7\u09be\u09b0\u09bf\u09a4\u0964 \u09ac\u09c7\u09b2\u09c1\u09a1\u09bc \u09ae\u09a0 \u0993 \u09ac\u09bf\u09b6\u09c1\u09a6\u09cd\u09a7 \u09b8\u09bf\u09a6\u09cd\u09a7\u09be\u09a8\u09cd\u09a4 \u0985\u09a8\u09c1\u0997\u09be\u09ae\u09c0\u09b0\u09be \u098f\u0987 \u09aa\u099e\u09cd\u099c\u09bf\u0995\u09be \u0985\u09a8\u09c1\u09b8\u09b0\u09a3 \u0995\u09b0\u09c7\u09a8\u0964',isPrimaryConvention:!1},{id:'surya-siddhanta-2026',name:'Gupta Press / Traditional Surya Siddhanta',nameBn:'\u0997\u09c1\u09aa\u09cd\u09a4\u09aa\u09cd\u09b0\u09c7\u09b8 \u09aa\u099e\u09cd\u099c\u09bf\u0995\u09be (\u099a\u09bf\u09b0\u09be\u099a\u09b0\u09bf\u09a4 \u09b8\u09c2\u09b0\u09cd\u09af \u09b8\u09bf\u09a6\u09cd\u09a7\u09be\u09a8\u09cd\u09a4)',panjikaSystem:'Surya Siddhanta',panjikaSystemBn:'\u09b8\u09c2\u09b0\u09cd\u09af \u09b8\u09bf\u09a6\u09cd\u09a7\u09be\u09a8\u09cd\u09a4',sourceName:'Traditional Bengali Almanac (Gupta Press Panjika)',sourceUrl:'https://www.kolkatatourguide.com/durga-puja-calendar-2026/',year:2026,location:'Kolkata, West Bengal',locationBn:'\u0995\u09b2\u0995\u09be\u09a4\u09be, \u09aa\u09b6\u09cd\u099a\u09bf\u09ae\u09ac\u0999\u09cd\u0997',coordinates:{lat:22.5726,lng:88.3639},festival:'Sandhi Puja (Traditional Almanac Timing)',festivalBn:'\u09b8\u09a8\u09cd\u09a7\u09bf\u09aa\u09c2\u099c\u09be (\u0990\u09a4\u09bf\u09b9\u09cd\u09af\u09ac\u09be\u09b9\u09c0 \u09aa\u099e\u09cd\u099c\u09bf\u0995\u09be \u09a8\u09bf\u09b0\u09cd\u0998\u09a3\u09cd\u099f)',dateString:'Sunday/Monday Festival Window (Oct 18-19, 2026)',dateStringBn:'\u09b0\u09ac\u09bf\u09ac\u09be\u09b0/\u09b8\u09cb\u09ae\u09ac\u09be\u09b0 \u09a4\u09bf\u09a5\u09bf \u09b8\u09a8\u09cd\u09a7\u09bf\u0995\u09cd\u09b7\u09a3 (\u09e7\u09ee-\u09e7\u09ef \u0985\u0995\u09cd\u099f\u09cb\u09ac\u09b0 \u09e8\u09e6\u09e8\u09ec)',gregorianDate:'2026-10-18',startTime:'06:21 PM IST (Preceding Evening)',endTime:'07:09 PM IST',startTimeBn:'\u09b8\u09a8\u09cd\u09a7\u09cd\u09af\u09be \u09e6\u09ec:\u09e8\u09e7 (IST)',endTimeBn:'\u09b8\u09a8\u09cd\u09a7\u09cd\u09af\u09be \u09e6\u09ed:\u09e6\u09ef (IST)',durationMinutes:48,durationDisplay:'48 minutes (2 Dandas)',durationDisplayBn:'\u09ea\u09ee \u09ae\u09bf\u09a8\u09bf\u099f (\u09e8 \u09a6\u09a3\u09cd\u09a1)',ashtamiEndTransition:'Last 24 minutes of Ashtami (Surya Siddhanta Table)',navamiStartTransition:'First 24 minutes of Navami (Surya Siddhanta Table)',significance:'Traditional family Bonedi Baris and ancestral community pujas frequently reference traditional Surya Siddhanta almanacs where tithi constants derive from classical Sanskrit texts.',significanceBn:'\u09ac\u09b9\u09c1 \u09aa\u09cd\u09b0\u09be\u099a\u09c0\u09a8 \u09ac\u09a8\u09c7\u09a6\u09bf \u09ac\u09be\u09a1\u09bc\u09bf \u0993 \u09b8\u09be\u09ac\u09c7\u0995\u09bf \u09aa\u09c1\u099c\u09cb \u09b8\u09ae\u09bf\u09a4\u09bf \u09b6\u09a4\u09be\u09ac\u09cd\u09a6\u09c0\u09b0 \u0990\u09a4\u09bf\u09b9\u09cd\u09af \u09ae\u09c7\u09a8\u09c7 \u0997\u09c1\u09aa\u09cd\u09a4\u09aa\u09cd\u09b0\u09c7\u09b8 \u0993 \u09b8\u09a8\u09be\u09a4\u09a8 \u09b8\u09c2\u09b0\u09cd\u09af \u09b8\u09bf\u09a6\u09cd\u09a7\u09be\u09a8\u09cd\u09a4 \u0997\u09a3\u09a8\u09be \u0985\u09a8\u09c1\u09b8\u09b0\u09a3 \u0995\u09b0\u09c7 \u09b8\u09a8\u09cd\u09a7\u09bf\u09aa\u09c2\u099c\u09be\u09b0 \u09b2\u0997\u09cd\u09a8 \u09a8\u09bf\u09b0\u09cd\u09a7\u09be\u09b0\u09a3 \u0995\u09b0\u09c7\u0964',calculationNote:'Based on classical Surya Siddhanta planetary equations. Note that different Bengali almanacs can yield different tithi cutoff timings; local pandals follow the specific Panjika mandated by their hereditary priest or committee.',calculationNoteBn:'\u09b8\u09a8\u09be\u09a4\u09a8 \u09b8\u09c2\u09b0\u09cd\u09af\u09b8\u09bf\u09a6\u09cd\u09a7\u09be\u09a8\u09cd\u09a4\u09c0\u09af\u09bc \u09b8\u09c2\u09a4\u09cd\u09b0\u09c7\u09b0 \u09ad\u09bf\u09a4\u09cd\u09a4\u09bf\u09a4\u09c7 \u09b0\u099a\u09bf\u09a4\u0964 \u09ac\u09be\u0982\u09b2\u09be\u09af\u09bc \u09ac\u09bf\u09ad\u09bf\u09a8\u09cd\u09a8 \u09aa\u099e\u09cd\u099c\u09bf\u0995\u09be\u09af\u09bc \u09a4\u09bf\u09a5\u09bf\u09b0 \u09b8\u09be\u09ae\u09be\u09a8\u09cd\u09af \u09b8\u09ae\u09af\u09bc\u09c7\u09b0 \u09ac\u09cd\u09af\u09ac\u09a7\u09be\u09a8 \u09a5\u09be\u0995\u09c7, \u09a4\u09be\u0987 \u09b8\u09cd\u09a5\u09be\u09a8\u09c0\u09af\u09bc \u09ae\u09a8\u09cd\u09a6\u09bf\u09b0 \u09ac\u09be \u09ae\u09a3\u09cd\u09a1\u09aa\u09c7\u09b0 \u09aa\u09c1\u09b0\u09cb\u09b9\u09bf\u09a4 \u09af\u09c7 \u09aa\u099e\u09cd\u099c\u09bf\u0995\u09be \u0985\u09a8\u09c1\u09b8\u09b0\u09a3 \u0995\u09b0\u09c7\u09a8, \u09b8\u09c7\u099f\u09be\u0987 \u09ae\u09be\u09a8\u09cd\u09af\u0964',isPrimaryConvention:!1}],ritualSignificance:{title:'Significance of Sandhi Puja (\u09b8\u09a8\u09cd\u09a7\u09bf\u09aa\u09c2\u099c\u09be\u09b0 \u09ae\u09be\u09b9\u09be\u09a4\u09cd\u09ae\u09cd\u09af)',titleBn:'\u09b8\u09a8\u09cd\u09a7\u09bf\u09aa\u09c2\u099c\u09be\u09b0 \u0986\u09a7\u09cd\u09af\u09be\u09a4\u09cd\u09ae\u09bf\u0995 \u0993 \u09aa\u09cc\u09b0\u09be\u09a3\u09bf\u0995 \u09ae\u09be\u09b9\u09be\u09a4\u09cd\u09ae\u09cd\u09af',summary:'Sandhi Puja is the climax and the most intensely sacred 48 minutes of Durga Puja. It represents the exact junction when Ashtami merges into Navami.',summaryBn:'\u09b6\u09be\u09b0\u09a6\u09c0\u09af\u09bc\u09be \u09a6\u09c1\u09b0\u09cd\u0997\u09cb\u09ce\u09b8\u09ac\u09c7\u09b0 \u09b8\u09ac\u099a\u09c7\u09af\u09bc\u09c7 \u0989\u09a6\u09cd\u09a6\u09c0\u09aa\u09a8\u09be\u09ae\u09af\u09bc \u0993 \u099c\u09be\u0997\u09cd\u09b0\u09a4 \u09ea\u09ee \u09ae\u09bf\u09a8\u09bf\u099f \u09b9\u09b2\u09cb \u09b8\u09a8\u09cd\u09a7\u09bf\u09aa\u09c2\u099c\u09be\u0964 \u09ae\u09b9\u09be\u09b7\u09cd\u099f\u09ae\u09c0\u09b0 \u09b8\u09ae\u09be\u09aa\u09cd\u09a4\u09bf \u0993 \u09ae\u09b9\u09be\u09a8\u09ac\u09ae\u09c0\u09b0 \u09aa\u09cd\u09b0\u09be\u09b0\u09ae\u09cd\u09ad\u09c7\u09b0 \u09aa\u09c1\u09a3\u09cd\u09af \u09b8\u09a8\u09cd\u09a7\u09bf\u09b2\u0997\u09cd\u09a8\u09c7 \u098f\u099f\u09bf \u0985\u09a8\u09c1\u09b7\u09cd\u09a0\u09bf\u09a4 \u09b9\u09af\u09bc\u0964',items:['Appearance of Devi Chamunda: Born from the divine forehead of Devi Ambika to vanquish demons Chanda and Munda.','108 Blue Lotuses (Neel Padma): Offered with devotion, echoing Lord Rama\u2019s worship during Akalbodhon.','108 Pradips (Earthen Oil Lamps): Lit in radiant rows to dispel spiritual and cosmic darkness.','Sacred Oblation / Balidaan: Symbolic sacrifice of sugarcane, white gourd (Chalkumro), or banana representing destruction of ego at 07:50 AM.'],itemsBn:['\u09a6\u09c7\u09ac\u09c0 \u099a\u09be\u09ae\u09c1\u09a3\u09cd\u09a1\u09be\u09b0 \u0986\u09ac\u09bf\u09b0\u09cd\u09ad\u09be\u09ac: \u099a\u09a3\u09cd\u09a1 \u0993 \u09ae\u09c1\u09a3\u09cd\u09a1\u0995\u09c7 \u09b8\u0982\u09b9\u09be\u09b0 \u0995\u09b0\u09a4\u09c7 \u09a6\u09c7\u09ac\u09c0 \u0985\u09ae\u09cd\u09ac\u09bf\u0995\u09be\u09b0 \u09b2\u09b2\u09be\u099f\u09a6\u09c7\u09b6 \u09a5\u09c7\u0995\u09c7 \u0995\u09be\u09b2\u09bf\u0995\u09be \u09b0\u09c2\u09aa\u09bf\u09a3\u09c0 \u099a\u09be\u09ae\u09c1\u09a3\u09cd\u09a1\u09be\u09b0 \u0989\u09a6\u09af\u09bc\u0964','\u09e7\u09e6\u09ee \u09a8\u09c0\u09b2\u09aa\u09a6\u09cd\u09ae \u09a8\u09bf\u09ac\u09c7\u09a6\u09a8: \u09b6\u09cd\u09b0\u09c0\u09b0\u09be\u09ae\u099a\u09a8\u09cd\u09a6\u09cd\u09b0\u09c7\u09b0 \u0985\u0995\u09be\u09b2\u09ac\u09cb\u09a7\u09a8\u09c7\u09b0 \u09a8\u09cd\u09af\u09be\u09af\u09bc \u09e7\u09e6\u09ee\u099f\u09bf \u09a8\u09c0\u09b2\u09aa\u09a6\u09cd\u09ae \u09a6\u09bf\u09af\u09bc\u09c7 \u09a6\u09c7\u09ac\u09c0\u09b0 \u09b6\u09cd\u09b0\u09c0\u099a\u09b0\u09a3\u09c7 \u0985\u099e\u09cd\u099c\u09b2\u09bf \u09aa\u09cd\u09b0\u09a6\u09be\u09a8\u0964','\u09e7\u09e6\u09ee \u09ae\u09be\u099f\u09bf\u09b0 \u09aa\u09cd\u09b0\u09a6\u09c0\u09aa \u09aa\u09cd\u09b0\u099c\u09cd\u09ac\u09be\u09b2\u09a8: \u0985\u099c\u09cd\u099e\u09be\u09a8\u09a4\u09be\u09b0 \u0985\u09a8\u09cd\u09a7\u0995\u09be\u09b0 \u09a6\u09c2\u09b0 \u0995\u09b0\u09c7 \u0986\u09b2\u09cb\u0995\u09ac\u09b0\u09cd\u09a4\u09bf\u0995\u09be \u09aa\u09cd\u09b0\u099c\u09cd\u09ac\u09be\u09b2\u09a8\u0964','\u09aa\u09cd\u09b0\u09a4\u09c0\u0995\u09c0 \u09ac\u09b2\u09bf\u09a6\u09be\u09a8: \u09b8\u0995\u09be\u09b2 \u09e6\u09ed:\u09eb\u09e6 \u098f \u0985\u09b9\u0982\u0995\u09be\u09b0 \u0993 \u0986\u09b8\u09c1\u09b0\u09bf\u0995 \u09ac\u09c3\u09a4\u09cd\u09a4\u09bf\u09b0 \u09ac\u09bf\u09a8\u09be\u09b6\u09c7\u09b0 \u09aa\u09cd\u09b0\u09a4\u09c0\u0995 \u09b9\u09bf\u09b8\u09c7\u09ac\u09c7 \u0986\u0996 \u0993 \u099a\u09be\u09b2\u0995\u09c1\u09ae\u09a1\u09bc\u09cb \u09ac\u09b2\u09bf \u09aa\u09cd\u09b0\u09a6\u09be\u09a8\u0964']}}}},1083,[]);
