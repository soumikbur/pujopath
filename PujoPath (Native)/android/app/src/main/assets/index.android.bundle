aa\u09be\u09a1\u09bc\u09be \u09ae\u09c7\u099f\u09cd\u09b0\u09cb',walkingDistanceMeters:18e3,walkingDurationMinutes:35}],facilities:{wheelchairAccessible:!0,drinkingWater:!0,medicalBooth:!0,vipPassEntry:!0,parkingAvailable:!1,foodStallsNearby:!0,publicToilets:!0},highlights:['Iconic Barasat Crowd Puller','500m from Barasat Station','Chandannagar LED Gates','Grand Theme Sanctum'],highlightsBn:['\u09ac\u09be\u09b0\u09be\u09b8\u09be\u09a4\u09c7\u09b0 \u09aa\u09cd\u09b0\u09a7\u09be\u09a8 \u09ad\u09bf\u09a1\u09bc\u099f\u09be\u09a8\u09be \u09aa\u09c1\u099c\u09cb','\u09ac\u09be\u09b0\u09be\u09b8\u09be\u09a4 \u09b8\u09cd\u099f\u09c7\u09b6\u09a8 \u09a5\u09c7\u0995\u09c7 \u09ae\u09be\u09a4\u09cd\u09b0 \u09eb\u09e6\u09e6 \u09ae\u09bf\u099f\u09be\u09b0','\u099a\u09a8\u09cd\u09a6\u09a8\u09a8\u0997\u09b0\u09c7\u09b0 \u0986\u09b2\u09cb\u0995\u09ae\u09be\u09b2\u09be','\u09ac\u09bf\u09b6\u09be\u09b2 \u09b6\u09c8\u09b2\u09cd\u09aa\u09bf\u0995 \u09ae\u09a3\u09cd\u09a1\u09aa'],sourceUrl:'https://www.kalipujabarasat.in/dashboards/guidemap',sourceName:'Barasat Police District Official Kali Puja Portal',verificationDate:'2026-10-19',coordinateConfidence:'High',verificationStatus:'Verified'},{id:'kali-barasat-nabapally-byam-samity',slug:'nabapally-byam-samity-colony-more',name:'Nabapally Byam Samity',nameBn:'\u09a8\u09ac\u09aa\u09b2\u09cd\u09b2\u09c0 \u09ac\u09cd\u09af\u09be\u09af\u09bc\u09be\u09ae \u09b8\u09ae\u09bf\u09a4\u09bf',zone:'Barasat',locality:'Colony More, Nabapally',localityBn:'\u0995\u09b2\u09cb\u09a8\u09bf \u09ae\u09cb\u09a1\u09bc, \u09a8\u09ac\u09aa\u09b2\u09cd\u09b2\u09c0',address:'Colony More, Nabapally, Barasat, North 24 Parganas - 700126',addressBn:'\u0995\u09b2\u09cb\u09a8\u09bf \u09ae\u09cb\u09a1\u09bc, \u09a8\u09ac\u09aa\u09b2\u09cd\u09b2\u09c0, \u09ac\u09be\u09b0\u09be\u09b8\u09be\u09a4, \u0989\u09a4\u09cd\u09a4\u09b0 \u09e8\u09ea \u09aa\u09b0\u0997\u09a8\u09be - \u09ed\u09e6\u09e6\u09e7\u09e8\u09ec',latitude:22.7223611,longitude:88.4741822,theme:'Classical Clay Craft