5\u09cd\u09a4\u09bf\u0997\u09ae\u09cd\u09ad\u09c0\u09b0 \u09b8\u09cd\u09a4\u09cb\u09a4\u09cd\u09b0\u09aa\u09be\u09a0\u0964',iconName:'Flame'},{id:'Puja Ritual & Ambience',name:'Puja Ritual & Pandal Ambience',nameBn:'\u09aa\u09c2\u099c\u09be \u0986\u099a\u09be\u09b0 \u0993 \u09ae\u09a3\u09cd\u09a1\u09aa\u09c7\u09b0 \u0986\u09ac\u09b9',description:'Atmospheric ceremonial sounds for Sandhi Puja, evening aarati, and sacred mantras.',descriptionBn:'\u09b8\u09a8\u09cd\u09a7\u09bf\u09aa\u09c2\u099c\u09be, \u09b8\u09a8\u09cd\u09a7\u09cd\u09af\u09be\u09b0\u09a4\u09bf \u0993 \u09b9\u09cb\u09ae-\u09af\u099c\u09cd\u099e\u09c7\u09b0 \u09aa\u09ac\u09bf\u09a4\u09cd\u09b0 \u09ad\u09be\u09ac\u0997\u09ae\u09cd\u09ad\u09c0\u09b0 \u09aa\u09b0\u09bf\u09ac\u09c7\u09b6\u09c7\u09b0 \u09b8\u09c1\u09b0 \u0993 \u09a8\u09be\u09a6\u0964',iconName:'Sparkles'},{id:'Pandal-Hopping',name:'Pandal-Hopping Playlist',nameBn:'\u09aa\u09cd\u09af\u09be\u09a8\u09cd\u09a1\u09c7\u09b2 \u09b9\u09aa\u09bf\u0982 \u09aa\u09cd\u09b2\u09c7\u09b2\u09bf\u09b8\u09cd\u099f',description:'Upbeat festive songs, energetic celebrations, and travel rhythms for hopping across Kolkata.',descriptionBn:'\u0995\u09b2\u0995\u09be\u09a4\u09be\u09b0 \u09b0\u09be\u09b8\u09cd\u09a4\u09be\u09af\u09bc \u09ac\u09a8\u09cd\u09a7\u09c1\u09a6\u09c7\u09b0 \u09b8\u09be\u09a5\u09c7 \u09aa\u09cd\u09af\u09be\u09a8\u09cd\u09a1\u09c7\u09b2 \u0998\u09cb\u09b0\u09be\u09b0 \u099c\u09ae\u09be\u099f\u09bf \u0989\u09ce\u09b8\u09ac \u0993 \u0986\u09a8\u09a8\u09cd\u09a6\u09c7\u09b0 \u09b8\u09c1\u09b0\u0964',iconName:'Compass'},{id:'Bengali Folk',name:'Bengali Folk & Cultural Traditions',nameBn:'\u09ac\u09be\u0982\u09b2\u09be\u09b0 \u09b2\u09cb\u0995\u09b8\u0999\u09cd\u0997\u09c0\u09a4 \u0993 \u09ac\u09be\u0989\u09b2 \u09a7\u09be\u09b0\u09be',description:'Authentic acoustic Baul performances, traditional Khamak, and timeless Bengali folk melodies.',descriptionBn:'\u09ae\u09be\u099f\u09bf\u09b0 \u09b8\u09c1\u09b0 - \u098f\u0995\u09a4\u09be\u09b0\u09be, \u0996\u09ae\u0995 \u0993 \u09ac\u09be\u0989\u09b2\u09c7\u09b0 \u0986\u09a7\u09cd\u09af\u09be\u09a4\u09cd\u09ae\u09bf\u0995 \u09ad\u09be\u09ac\u09a7\u09be\u09b0\u09be\u09af\u09bc \u09ac\u09be\u0982\u09b2\u09be\u09b0 \u09b2\u09cb\u0995\u0990\u09a4\u09bf\u09b9\u09cd\u09af\u0964',iconName:'HeartHandshake'},{id:'Cultural Programmes',name:'Cultural Programmes & Stage Classics',nameBn:'\u09b8\u09be\u0982\u09b8\u09cd\u0995\u09c3\u09a4\u09bf\u0995 \u0985\u09a8\u09c1\u09b7\u09cd\u09a0\u09be\u09a8 \u0993 \u09a7\u09cd\u09b0\u09c1\u09aa\u09a6\u09c0 \u0997\u09be\u09a8',description:'Rabindra Sangeet, Nazrul Geeti, classical ragas, and historic Bengali band anthems.',descriptionBn:'\u09aa\u09c2\u099c\u09be\u09b0 \u09ae\u09c1\u0995\u09cd\u09a4\u09ae\u099e\u09cd\u099a\u09c7\u09b0 \u09b0\u09ac\u09c0\u09a8\u09cd\u09a6\u09cd\u09b0\u09b8\u0999\u09cd\u0997\u09c0\u09a4, \u09a8\u099c\u09b0\u09c1\u09b2\u0997\u09c0\u09a4\u09bf \u0993 \u09a7\u09cd\u09b0\u09c1\u09aa\u09a6\u09c0 \u09b0\u09be\u0997\u09b8\u0999\u09cd\u0997\u09c0\u09a4\u09c7\u09b0 \u09b0\u09b8\u09be\u09b8\u09cd\u09ac\u09be\u09a6\u09a8\u0964',iconName:'Music'},{id:'Bisarjan & Immersion',name:'Bisarjan & Immersion Procession',nameBn:'\u09ac\u09bf\u09b8\u09b0\u09cd\u099c\u09a8 \u0993 \u09b6\u09cb\u09ad\u09be\u09af\u09be\u09a4\u09cd\u09b0\u09be\u09b0 \u09ac\u09cb\u09b2',description:'Powerful riverfront immersion dhak, Dashami Sindoor Khela, and "Asche Bochor Abar Hobe" farewells.',descriptionBn:'\u0997\u0999\u09cd\u0997\u09be\u09b0 \u0998\u09be\u099f\u09c7 \u09ac\u09bf\u09b8\u09b0\u09cd\u099c\u09a8\u09c7\u09b0 \u09b6\u09cb\u09ad\u09be\u09af\u09be\u09a4\u09cd\u09b0\u09be, \u09a6\u09b6\u09ae\u09c0\u09b0 \u09b8\u09bf\u0981\u09a6\u09c1\u09b0\u0996\u09c7\u09b2\u09be \u0993 "\u0986\u09b8\u099b\u09c7 \u09ac\u099b\u09b0 \u0986\u09ac\u09be\u09b0 \u09b9\u09ac\u09c7" \u09a7\u09cd\u09ac\u09a8\u09bf\u0964',iconName:'Waves'},{id:'Ambient Soundscapes',name:'Ambient Durga Puja Soundscapes',nameBn:'\u09b6\u09be\u09b0\u09a6\u09c0\u09af\u09bc\u09be \u09aa\u09be\u09b0\u09bf\u09aa\u09be\u09b0\u09cd\u09b6\u09cd\u09ac\u09bf\u0995 \u09b6\u09ac\u09cd\u09a6\u099b\u09ac\u09bf',description:'Field recordings of festive Kolkata street melas, temple bell echoes, and crowd atmospheres.',descriptionBn:'\u0989\u09ce\u09b8\u09ac\u09ae\u09c1\u0996\u09b0 \u0995\u09b2\u0995\u09be\u09a4\u09be\u09b0 \u09b0\u09be\u099c\u09aa\u09a5, \u09aa\u09c2\u099c\u09be \u09ae\u09c7\u09b2\u09be\u09b0 \u0995\u09cb\u09b2\u09be\u09b9\u09b2 \u0993 \u09a6\u09c2\u09b0 \u09a5\u09c7\u0995\u09c7 \u09ad\u09c7\u09b8\u09c7 \u0986\u09b8\u09be \u09a2\u09be\u0995\u09c7\u09b0 \u09ac\u09cb\u09b2\u0964',iconName:'Radio'},{id:'Mahalaya',name:'Historic Mahalaya Archive',nameBn:'\u09ae\u09b9\u09be\u09b2\u09af\u09bc\u09be \u09ae\u09b9\u09bf\u09b7\u09be\u09b8\u09c1\u09b0\u09ae\u09b0\u09cd\u09a6\u09bf\u09a8\u09c0 \u09b8\u0982\u0997\u09cd\u09b0\u09b9',description:'Historic 1931 All India Radio broadcast by Birendra Krishna Bhadra and Pankaj Mullick.',descriptionBn:'\u09ac\u09c0\u09b0\u09c7\u09a8\u09cd\u09a6\u09cd\u09b0\u0995\u09c3\u09b7\u09cd\u09a3 \u09ad\u09a6\u09cd\u09b0\u09c7\u09b0 \u099a\u09a3\u09cd\u09a1\u09c0\u09aa\u09be\u09a0 \u0993 \u09aa\u0999\u09cd\u0995\u099c \u09ae\u09b2\u09cd\u09b2\u09bf\u0995\u09c7\u09b0 \u09b8\u09c1\u09b0\u09c7 \u0995\u09be\u09b2\u099c\u09af\u09bc\u09c0 \u09ae\u09b9\u09be\u09b2\u09af\u09bc\u09be\u09b0 \u09aa\u09cd\u09b0\u09be\u09a4\u0983\u09b8\u09cd\u09ae\u09b0\u09a3\u09c0\u09af\u09bc \u09ac\u09be\u09a3\u09c0\u0964',iconName:'Sun'}],n=[{id:'Ritual & Devotion',label:'Ritual & Devotion',labelBn:'\u09aa\u09c2\u099c\u09be\u09b0 \u0986\u099a\u09be\u09b0 \u0993 \u09ad\u0995\u09cd\u09a4\u09bf',categoryFilter:'Agomoni & Devotional'},{id:'Dhak & Traditional',label:'Dhak & Traditional Sounds',labelBn:'\u09a2\u09be\u0995 \u0993 \u0990\u09a4\u09bf\u09b9\u09cd\u09af\u09ac\u09be\u09b9\u09c0 \u09ac\u09be\u09a6\u09cd\u09af',categoryFilter:'Dhak & Shankha'},{id:'Pandal Hopping',label:'Pandal Hopping',labelBn:'\u09aa\u09cd\u09af\u09be\u09a8\u09cd\u09a1\u09c7\u09b2 \u09b9\u09aa\u09bf\u0982 \u0993 \u09ad\u09cd\u09b0\u09ae\u09a3',categoryFilter:'Pandal-Hopping'},{id:'Bengali Festive',label:'Bengali Festive Music',labelBn:'\u09ac\u09be\u0999\u09be\u09b2\u09bf\u09b0 \u09b6\u09be\u09b0\u09a6 \u0989\u09ce\u09b8\u09ac',categoryFilter:'Cultural Programmes'},{id:'Folk & Cultural',label:'Folk & Cultural Music',labelBn:'\u09b2\u09cb\u0995\u0997\u09be\u09a8 \u0993 \u09ac\u09be\u0989\u09b2 \u09b8\u0982\u09b8\u09cd\u0995\u09c3\u09a4\u09bf',categoryFilter:'Bengali Folk'},{id:'Bisarjan',label:'Bisarjan & Farewell',labelBn:'\u09ac\u09bf\u09b8\u09b0\u09cd\u099c\u09a8 \u0993 \u09ac\u09bf\u09a6\u09be\u09af\u09bc \u09ac\u09c7\u09b2\u09be',categoryFilter:'Bisarjan & Immersion'},{id:'Ambient Sounds',label:'Ambient Puja Sounds',labelBn:'\u09aa\u09be\u09b0\u09bf\u09aa\u09be\u09b0\u09cd\u09b6\u09cd\u09ac\u09bf\u0995 \u09b6\u09ac\u09cd\u09a6\u099b\u09ac\u09bf',categoryFilter:'Ambient Soundscapes'}],s=[{id:'track-dhak-beats',title:'Sharodiya Dhak Dhwoni & Kashi Bol',titleBn:'\u09b6\u09be\u09b0\u09a6\u09c0\u09af\u09bc\u09be \u0986\u0997\u09ae\u09a8\u09c0 \u09a2\u09be\u0995\u09c7\u09b0 \u09ac\u09cb\u09b2 \u0993 \u0995\u09be\u0981\u09b8\u09bf',artist:'Mamta Jagdish Dhody (Live Field Recording)',artistBn:'\u09ae\u09ae\u09a4\u09be \u099c\u0997\u09a6\u09c0\u09b6 \u09a7\u09cb\u09a1\u09bf (\u09b6\u09be\u09b0\u09a6\u09c0\u09af\u09bc\u09be \u09b2\u09be\u0987\u09ad \u09b0\u09c7\u0995\u09b0\u09cd\u09a1\u09bf\u0982)',category:'Dhak & Shankha',mood:'Dhak & Traditional',durationSeconds:99,audioUrl:'https://upload.wikimedia.org/wikipedia/commons/4/46/Durga_Puja_Dhak_Dhol.ogg',coverUrl:'https://images.unsplash.com/photo-1511671782779-c97d3d27a1d4?auto=format&fit=crop&w=600&q=80',description:'Authentic live field recording of traditional Bengali wooden dhak drums and resonant brass kashi bells during Durga Puja festivities in Kolkata.',descriptionBn:'\u09a6\u09c1\u09b0\u09cd\u0997\u09be\u09aa\u09c2\u099c\u09be\u09b0 \u09aa\u09cd\u09b0\u09be\u09a3\u09b8\u09cd\u09aa\u09a8\u09cd\u09a6\u09a8 - \u0996\u09be\u0981\u099f\u09bf \u0990\u09a4\u09bf\u09b9\u09cd\u09af\u09ac\u09be\u09b9\u09c0 \u0995\u09be\u09a0\u09c7\u09b0 \u09a2\u09be\u0995\u09c7\u09b0 \u0997\u09ae\u0997\u09ae\u09c7 \u0997\u09ae\u09cd\u09ad\u09c0\u09b0 \u09ac\u09cb\u09b2 \u0993 \u0995\u09be\u0981\u09b8\u09bf\u09b0 \u099b\u09a8\u09cd\u09a6 \u09af\u09be \u09ac\u09be\u0999\u09be\u09b2\u09bf\u09b0 \u09b6\u09be\u09b0\u09a6\u09cb\u09ce\u09b8\u09ac\u0995\u09c7 \u09ae\u09c1\u0996\u09b0\u09bf\u09a4 \u0995\u09b0\u09c7 \u09a4\u09cb\u09b2\u09c7\u0964',culturalContext:'Played in mandaps from Sasthi bodhon to Dashami to create the sacred festive atmosphere.',culturalContextBn:'\u09b7\u09b7\u09cd\u09a0\u09c0\u09b0 \u09ac\u09cb\u09a7\u09a8 \u09a5\u09c7\u0995\u09c7 \u09a6\u09b6\u09ae\u09c0 \u09aa\u09b0\u09cd\u09af\u09a8\u09cd\u09a4 \u09aa\u09c2\u099c\u09be\u09ae\u09a3\u09cd\u09a1\u09aa\u09c7 \u098f\u0987 \u09ac\u09cb\u09b2\u09c7 \u09a6\u09c7\u09ac\u09c0\u09b0 \u0986\u09b0\u09a4\u09bf \u0993 \u0986\u09a8\u09a8\u09cd\u09a6 \u0989\u09a6\u09af\u09be\u09aa\u09bf\u09a4 \u09b9\u09af\u09bc\u0964',language:'Instrumental',playbackMethod:'direct_audio',licenseType:'Creative Commons CC BY-SA 4.0 / GFDL',attribution:'Recorded live by Mamta Jagdish Dhody during Durga Puja. Released under CC BY-SA 4.0 / GNU Free Documentation License on Wikimedia Commons.',sourceUrl:'https://commons.wikimedia.org/wiki/File:Durga_Puja_Dhak_Dhol.ogg',isLocalAsset:!1,lyricsSnippet:'Dhaak er tale komor dole, Pujo elo pujo elo...',lyricsSnippetBn:'\u09a2\u09be\u0995\u09c7\u09b0 \u09a4\u09be\u09b2\u09c7 \u0995\u09cb\u09ae\u09b0 \u09a6\u09cb\u09b2\u09c7, \u09aa\u09c1\u099c\u09cb \u098f\u09b2\u09cb \u09aa\u09c1\u099c\u09cb \u098f\u09b2\u09cb \u09b0\u09c7...',tags:['Dhak','Traditional','Kolkata','Percussion']},{id:'track-shankha-dhwani',title:'Sacred Shankha Naad (Auspicious Conch Call)',titleBn:'\u09b8\u09a8\u09cd\u09a7\u09bf\u09aa\u09c2\u099c\u09be \u0993 \u0986\u09b0\u09a4\u09bf\u09b0 \u09ae\u0999\u09cd\u0997\u09b2 \u09b6\u0999\u09cd\u0996\u09a7\u09cd\u09ac\u09a8\u09bf',artist:'David Bolton',artistBn:'\u09a1\u09c7\u09ad\u09bf\u09a1 \u09ac\u09cb\u09b2\u09cd\u099f\u09a8',category:'Dhak & Shankha',mood:'Dhak & Traditional',durationSeconds:7,audioUrl:'https://upload.wikimedia.org/wikipedia/commons/2/24/Conch_shell.ogg',coverUrl:'https://images.unsplash.com/photo-1543083477-4f785aeafaa9?auto=format&fit=crop&w=600&q=80',description:'Resonant sacred conch blowing associated with Sandhi Puja transition, evening aarati, and invoking Devi Durga into the mandap.',descriptionBn:'\u09b8\u09a8\u09cd\u09a7\u09bf\u09aa\u09c2\u099c\u09be \u0993 \u09b8\u09a8\u09cd\u09a7\u09cd\u09af\u09be\u09b0\u09a4\u09bf\u09b0 \u09aa\u09b0\u09ae \u09aa\u09ac\u09bf\u09a4\u09cd\u09b0 \u09b6\u0999\u09cd\u0996\u09a8\u09be\u09a6 - \u0985\u09b6\u09c1\u09ad \u09b6\u0995\u09cd\u09a4\u09bf \u09ac\u09bf\u09a8\u09be\u09b6\u0995\u09be\u09b0\u09c0 \u098f\u09ac\u0982 \u09a6\u09c7\u09ac\u09c0 \u09a6\u09c1\u09b0\u09cd\u0997\u09be\u09b0 \u09ac\u09cb\u09a7\u09a8 \u0993 \u0986\u09ac\u09be\u09b9\u09a8\u09c7\u09b0 \u09b6\u09c1\u09ad \u09b8\u09c2\u099a\u09a8\u09be\u0964',culturalContext:'Blown in triples during aarati and the critical 48-minute juncture of Sandhi Puja.',culturalContextBn:'\u0986\u09b0\u09a4\u09bf\u09b0 \u09b8\u09ae\u09af\u09bc \u0993 \u09b8\u09a8\u09cd\u09a7\u09bf\u09aa\u09c2\u099c\u09be\u09b0 \u09ea\u09ee \u09ae\u09bf\u09a8\u09bf\u099f\u09c7\u09b0 \u09ae\u09be\u09b9\u09c7\u09a8\u09cd\u09a6\u09cd\u09b0\u0995\u09cd\u09b7\u09a3\u09c7 \u09ae\u0999\u09cd\u0997\u09b2 \u09b6\u0999\u09cd\u0996\u09a7\u09cd\u09ac\u09a8\u09bf \u0995\u09b0\u09be \u09b9\u09af\u09bc\u0964',language:'Instrumental',playbackMethod:'direct_audio',licenseType:'Creative Commons CC BY 2.5',attribution:'Acoustic recording by David Bolton. Released under CC BY 2.5 on Wikimedia Commons.',sourceUrl:'https://commons.wikimedia.org/wiki/File:Conch_shell.ogg',isLocalAsset:!1,lyricsSnippet:'Shankha baje, ghonta baje, Ma go tomaar aarati saje...',lyricsSnippetBn:'\u09b6\u0999\u09cd\u0996 \u09ac\u09be\u099c\u09c7, \u0998\u09a3\u09cd\u099f\u09be \u09ac\u09be\u099c\u09c7, \u09ae\u09be \u0997\u09cb \u09a4\u09cb\u09ae\u09be\u09b0 \u0986\u09b0\u09a4\u09bf \u09b8\u09be\u099c\u09c7...',tags:['Shankha','Conch','Auspicious','Sandhi Puja']},{id:'track-dhunuchi-dhak',title:'Dhunuchi Naach Dhak Taali & Kaashor',titleBn:'\u09a7\u09c1\u09a8\u09c1\u099a\u09bf \u09a8\u09be\u099a\u09c7\u09b0 \u09a6\u09cd\u09b0\u09c1\u09a4 \u09a4\u09be\u09b2 \u0993 \u09a2\u09be\u0995\u09c7\u09b0 \u0995\u09be\u09a0\u09bf',artist:'Traditional Bengali Dhaki Ensemble',artistBn:'\u0990\u09a4\u09bf\u09b9\u09cd\u09af\u09ac\u09be\u09b9\u09c0 \u09ac\u09be\u0999\u09be\u09b2\u09bf \u09a2\u09be\u0995\u09c0 \u09b8\u09ae\u09cd\u09aa\u09cd\u09b0\u09a6\u09be\u09af\u09bc',category:'Dhak & Shankha',mood:'Dhak & Traditional',durationSeconds:240,embedUrl:'https://www.youtube-nocookie.com/embed/zKgoHwAtfNM',coverUrl:'https://images.unsplash.com/photo-1511671782779-c97d3d27a1d4?auto=format&fit=crop&w=600&q=80',description:'Electrifying fast-paced rhythmic crescendo performed to accompany the sacred camphor and coconut husk Dhunuchi dance during evening aarati.',descriptionBn:'\u09b8\u09a8\u09cd\u09a7\u09cd\u09af\u09be\u09b0\u09a4\u09bf\u09b0 \u09aa\u09b0 \u09a7\u09c1\u09a8\u09c1\u099a\u09bf \u09a8\u09be\u099a\u09c7\u09b0 \u0989\u09a8\u09cd\u09ae\u09be\u09a6\u09a8\u09be\u09ae\u09af\u09bc \u09a6\u09cd\u09b0\u09c1\u09a4 \u09b2\u09af\u09bc\u09c7\u09b0 \u09a2\u09be\u0995 \u0993 \u0995\u09be\u0981\u09b8\u09b0\u09c7\u09b0 \u0997\u09ae\u09cd\u09ad\u09c0\u09b0 \u09af\u09c1\u0997\u09b2\u09ac\u09a8\u09cd\u09a6\u09bf\u0964',culturalContext:'Accompanying the iconic Dhunuchi dance performed by devotees on Saptami and Ashtami nights.',culturalContextBn:'\u09b8\u09aa\u09cd\u09a4\u09ae\u09c0 \u0993 \u0985\u09b7\u09cd\u099f\u09ae\u09c0\u09b0 \u09b0\u09be\u09a4\u09c7 \u09b8\u09c1\u09ac\u09be\u09b8\u09bf\u09a4 \u09a7\u09c1\u09a8\u09cb\u09b0 \u09a7\u09cb\u0981\u09af\u09bc\u09be\u09b0 \u09ae\u09be\u099d\u09c7 \u09ad\u0995\u09cd\u09a4\u09a6\u09c7\u09b0 \u09a7\u09c1\u09a8\u09c1\u099a\u09bf \u09a8\u09be\u099a\u09c7\u09b0 \u09aa\u09cd\u09b0\u09a7\u09be\u09a8 \u0985\u09a8\u09c1\u09b7\u0999\u09cd\u0997\u0964',language:'Instrumental',playbackMethod:'authorized_stream',licenseType:'Traditional Heritage Performance (Authorized Stream)',attribution:'Authentic Dhunuchi dance live percussion rhythm by Best Dhaki. In-page playback via authorized embed.',sourceUrl:'https://www.youtube.com/watch?v=zKgoHwAtfNM',isLocalAsset:!1,lyricsSnippet:'Dhunuchi nacher dhomok, dhaak-er matano taal...',lyricsSnippetBn:'\u09a7\u09c1\u09a8\u09c1\u099a\u09bf \u09a8\u09be\u099a\u09c7\u09b0 \u09a6\u09ae\u0995, \u09a2\u09be\u0995\u09c7\u09b0 \u09ae\u09be\u09a4\u09be\u09a8\u09cb \u09a4\u09be\u09b2...',tags:['Dhunuchi','Dhak','Aarati','Folk Rhythm']},{id:'track-gokul-das-dhak',title:'Master Dhaki Gokul Das Ensemble Rhythms',titleBn:'\u09a2\u09be\u0995\u09b8\u09ae\u09cd\u09b0\u09be\u099f \u09aa\u09a6\u09cd\u09ae\u09b6\u09cd\u09b0\u09c0 \u0997\u09cb\u0995\u09c1\u09b2\u099a\u09a8\u09cd\u09a6\u09cd\u09b0 \u09a6\u09be\u09b8 \u0993 \u0990\u09a4\u09bf\u09b9\u09cd\u09af\u09ac\u09be\u09b9\u09c0 \u09ac\u09be\u09a6\u09a8',artist:'Padma Shri Gokul Chandra Das & Tanmoy Bose',artistBn:'\u09aa\u09a6\u09cd\u09ae\u09b6\u09cd\u09b0\u09c0 \u0997\u09cb\u0995\u09c1\u09b2\u099a\u09a8\u09cd\u09a6\u09cd\u09b0 \u09a6\u09be\u09b8 \u0993 \u09aa\u09a3\u09cd\u09a1\u09bf\u09a4 \u09a4\u09a8\u09cd\u09ae\u09af\u09bc \u09ac\u09cb\u09b8',category:'Dhak & Shankha',mood:'Dhak & Traditional',durationSeconds:310,embedUrl:'https://www.youtube-nocookie.com/embed/M9V5fE7CB74',coverUrl:'https://images.unsplash.com/photo-1511671782779-c97d3d27a1d4?auto=format&fit=crop&w=600&q=80',description:'Virtuosic cross-rhythms by Bengal\u2019s master dhaki Padma Shri Gokul Chandra Das and tabla maestro Tanmoy Bose, showcasing century-old feather-decorated dhak techniques.',descriptionBn:'\u09ac\u09be\u0982\u09b2\u09be\u09b0 \u0995\u09bf\u0982\u09ac\u09a6\u09a8\u09cd\u09a4\u09bf \u09a2\u09be\u0995\u09b6\u09bf\u09b2\u09cd\u09aa\u09c0 \u09aa\u09a6\u09cd\u09ae\u09b6\u09cd\u09b0\u09c0 \u0997\u09cb\u0995\u09c1\u09b2\u099a\u09a8\u09cd\u09a6\u09cd\u09b0 \u09a6\u09be\u09b8 \u0993 \u09aa\u09a3\u09cd\u09a1\u09bf\u09a4 \u09a4\u09a8\u09cd\u09ae\u09af\u09bc \u09ac\u09cb\u09b8\u09c7\u09b0 \u099c\u09be\u09a6\u09c1\u0995\u09b0\u09c0 \u09ac\u09be\u09a6\u09a8\u0964 \u09ac\u0995\u09c7\u09b0 \u09aa\u09be\u09b2\u0995\u09c7 \u09b8\u09be\u099c\u09be\u09a8\u09cb \u09a2\u09be\u0995\u09c7\u09b0 \u09b6\u09c8\u09b2\u09cd\u09aa\u09bf\u0995 \u09b0\u09c2\u09aa\u0964',culturalContext:'Heritage stage and festival performances preserving hereditary dhaki traditions.',culturalContextBn:'\u09aa\u09c1\u09b0\u09c1\u09b7\u09be\u09a8\u09c1\u0995\u09cd\u09b0\u09ae\u09bf\u0995 \u09a2\u09be\u0995\u09c0\u09a6\u09c7\u09b0 \u09ac\u09be\u09a6\u09a8\u09b6\u09c8\u09b2\u09c0 \u09b8\u0982\u09b0\u0995\u09cd\u09b7\u09a3\u09c7 \u098f\u0995 \u0985\u09a8\u09a8\u09cd\u09af \u09b8\u09be\u0982\u09b8\u09cd\u0995\u09c3\u09a4\u09bf\u0995 \u09a8\u09bf\u09a6\u09b0\u09cd\u09b6\u09a8\u0964',language:'Instrumental',playbackMethod:'authorized_stream',licenseType:'Master Artist Heritage Stream (Authorized In-Page Embed)',attribution:'Padma Shri Gokul Chandra Das & Pt. Tanmoy Bose live Durga Puja rhythm dialogue. In-page playback via authorized embed.',sourceUrl:'https://www.youtube.com/watch?v=M9V5fE7CB74',isLocalAsset:!1,lyricsSnippet:'Dhaak er shobdo banglar praan...',lyricsSnippetBn:'\u09a2\u09be\u0995\u09c7\u09b0 \u09b6\u09ac\u09cd\u09a6 \u09ac\u09be\u0982\u09b2\u09be\u09b0 \u09aa\u09cd\u09b0\u09be\u09a3...',tags:['Master Dhaki','Gokul Das','Bengal Heritage']},{id:'track-agomoni-flute',title:'Sharod Shondhya - Autumn Bamboo Flute (Raag Mayamalavagowla)',titleBn:'\u09b6\u09b0\u09ce \u09b8\u09a8\u09cd\u09a7\u09cd\u09af\u09be - \u09ac\u09be\u0981\u09b6\u09bf\u09b0 \u09b6\u09be\u09a8\u09cd\u09a4 \u0986\u0997\u09ae\u09a8\u09c0 \u09b0\u09be\u0997',artist:'Bansuri Arvind',artistBn:'\u09ac\u09be\u0981\u09b6\u09b0\u09c0 \u0985\u09b0\u09ac\u09bf\u09a8\u09cd\u09a6',category:'Agomoni & Devotional',mood:'Ritual & Devotion',durationSeconds:39,audioUrl:'https://upload.wikimedia.org/wikipedia/commons/0/0f/Carnatic_flute.ogg',coverUrl:'https://images.unsplash.com/photo-1509198397868-475647b2a1e5?auto=format&fit=crop&w=600&q=80',description:'Pure acoustic bamboo flute melody evoking tranquil autumn mornings, dew on Shiuli flowers, and the arrival of the Mother.',descriptionBn:'\u09a8\u09c0\u09b2 \u0986\u0995\u09be\u09b6, \u09b6\u09bf\u0989\u09b2\u09bf \u09ab\u09c1\u09b2\u09c7\u09b0 \u09b8\u09c1\u09ac\u09be\u09b8 \u0986\u09b0 \u0995\u09be\u09b6\u09ab\u09c1\u09b2\u09c7\u09b0 \u09a6\u09cb\u09b2\u09be\u09af\u09bc \u09b6\u09b0\u09ce \u09b8\u09a8\u09cd\u09a7\u09cd\u09af\u09be\u09b0 \u09b6\u09be\u09a8\u09cd\u09a4 \u09ac\u09be\u0981\u09b6\u09bf\u09b0 \u09b8\u09c1\u09b0\u09c7 \u09ae\u09be\u09af\u09bc\u09c7\u09b0 \u0986\u0997\u09ae\u09a8\u09c0 \u09ac\u09be\u09b0\u09cd\u09a4\u09be\u0964',culturalContext:'Evoking the pristine tranquility of Ashwin month mornings and village riverbanks.',culturalContextBn:'\u0986\u09b6\u09cd\u09ac\u09bf\u09a8\u09c7\u09b0 \u09b6\u09be\u09a8\u09cd\u09a4 \u09ad\u09cb\u09b0 \u0993 \u0995\u09be\u09b6\u09ab\u09c1\u09b2\u09c7\u09b0 \u09b6\u09c1\u09ad\u09cd\u09b0\u09a4\u09be\u09b0 \u09ae\u09a7\u09cd\u09af\u09c7 \u09ae\u09be\u09af\u09bc\u09c7\u09b0 \u0986\u0997\u09ae\u09a8\u09c0 \u0985\u09a8\u09c1\u09ad\u09c2\u09a4\u09bf\u0964',language:'Instrumental',playbackMethod:'direct_audio',licenseType:'Creative Commons CC BY-SA 3.0',attribution:'Performed on 8-hole bamboo flute by Bansuri Arvind. Hosted on Wikimedia Commons under CC BY-SA 3.0.',sourceUrl:'https://commons.wikimedia.org/wiki/File:Carnatic_flute.ogg',isLocalAsset:!1,lyricsSnippet:'Instrumental melody in Raag Mayamalavagowla',lyricsSnippetBn:'\u09ae\u09be\u09af\u09bc\u09be\u09ae\u09be\u09b2\u09ac\u0997\u09cc\u09b2 \u09b0\u09be\u0997\u09c7 \u09b0\u099a\u09bf\u09a4 \u09a7\u09cd\u09b0\u09c1\u09aa\u09a6\u09c0 \u09ac\u0982\u09b6\u09c0\u09ac\u09be\u09a6\u09a8',tags:['Flute','Agomoni','Autumn','Shiuli']},{id:'track-sanskrit-stotram',title:'Sanskrit Stotram & Chandi Dhwani (Ya Devi Sarvabhuteshu)',titleBn:'\u09b6\u09cd\u09b0\u09c0 \u09b6\u09cd\u09b0\u09c0 \u099a\u09a3\u09cd\u09a1\u09c0 \u09b8\u09cd\u09a4\u09cb\u09a4\u09cd\u09b0 \u0986\u09ac\u09be\u09b9\u09a8 \u0993 \u09ac\u09c8\u09a6\u09bf\u0995 \u09aa\u09be\u09a0',artist:'Swami Atmananda (Vedic Chanting)',artistBn:'\u09b8\u09cd\u09ac\u09be\u09ae\u09c0 \u0986\u09a4\u09cd\u09ae\u09be\u09a8\u09a8\u09cd\u09a6 (\u09ac\u09c8\u09a6\u09bf\u0995 \u09b8\u09cd\u09a4\u09cb\u09a4\u09cd\u09b0 \u09aa\u09be\u09a0)',category:'Agomoni & Devotional',mood:'Ritual & Devotion',durationSeconds:295,audioUrl:'https://upload.wikimedia.org/wikipedia/commons/f/ff/Sanskrit_Chanting_Guru_Stotram.ogg',coverUrl:'https://images.unsplash.com/photo-1596704017254-9b121068fb31?auto=format&fit=crop&w=600&q=80',description:'Authentic classical Sanskrit sacred chanting and stotra recitation invoking the cosmic mother from sacred Vedic scriptures.',descriptionBn:'\u09b6\u09cd\u09b0\u09c0 \u09b6\u09cd\u09b0\u09c0 \u099a\u09a3\u09cd\u09a1\u09c0\u09b0 \u09aa\u09b0\u09ae \u09aa\u09ac\u09bf\u09a4\u09cd\u09b0 \u09b6\u09cd\u09b2\u09cb\u0995 \u0993 \u09b8\u09cd\u09a4\u09cb\u09a4\u09cd\u09b0\u09aa\u09be\u09a0 - \u09a6\u09c7\u09ac\u09c0 \u09af\u09bf\u09a8\u09bf \u09b8\u0995\u09b2 \u099c\u09c0\u09ac\u09c7\u09b0 \u09ae\u09a7\u09cd\u09af\u09c7 \u099a\u09c7\u09a4\u09a8\u09be, \u09b6\u0995\u09cd\u09a4\u09bf \u0993 \u09b6\u09be\u09a8\u09cd\u09a4\u09bf\u09b0\u09c2\u09aa\u09c7 \u09ac\u09bf\u09b0\u09be\u099c \u0995\u09b0\u09c7\u09a8\u0964',culturalContext:'Chanted during Sasthi bodhon and throughout morning puja rituals in every mandap.',culturalContextBn:'\u09b7\u09b7\u09cd\u09a0\u09c0\u09b0 \u09ac\u09cb\u09a7\u09a8 \u0993 \u09aa\u09cd\u09b0\u09a4\u09cd\u09af\u09b9 \u09b8\u0995\u09be\u09b2\u09c7\u09b0 \u09aa\u09c2\u099c\u09be\u09b0\u09cd\u099a\u09a8\u09be\u09af\u09bc \u09aa\u09a0\u09bf\u09a4 \u09ae\u09b9\u09bf\u09ae\u09be\u09a8\u09cd\u09ac\u09bf\u09a4 \u09ac\u09c8\u09a6\u09bf\u0995 \u09b8\u09cd\u09a4\u09cb\u09a4\u09cd\u09b0\u0964',language:'Sanskrit',playbackMethod:'direct_audio',licenseType:'Creative Commons CC0 1.0 (Public Domain Dedication)',attribution:'Sanskrit shlokas chanted by Swami Atmananda. Released into public domain under CC0 1.0 on Wikimedia Commons.',sourceUrl:'https://commons.wikimedia.org/wiki/File:Sanskrit_Chanting_Guru_Stotram.ogg',isLocalAsset:!1,lyricsSnippet:'Ya Devi Sarvabhuteshu Matri-rupena Samsthita, Namastasyai Namastasyai Namastasyai Namo Namah...',lyricsSnippetBn:'\u09af\u09be \u09a6\u09c7\u09ac\u09c0 \u09b8\u09b0\u09cd\u09ac\u09ad\u09c2\u09a4\u09c7\u09b7\u09c1 \u09ae\u09be\u09a4\u09c3\u09b0\u09c2\u09aa\u09c7\u09a3 \u09b8\u0982\u09b8\u09cd\u09a5\u09bf\u09a4\u09be, \u09a8\u09ae\u09b8\u09cd\u09a4\u09b8\u09cd\u09af\u09c8 \u09a8\u09ae\u09b8\u09cd\u09a4\u09b8\u09cd\u09af\u09c8 \u09a8\u09ae\u09b8\u09cd\u09a4\u09b8\u09cd\u09af\u09c8 \u09a8\u09ae\u09cb \u09a8\u09ae\u0983...',tags:['Stotram','Sanskrit','Chandi','Vedic']},{id:'track-jago-tumi-jago',title:'Jago Tumi Jago (Mahisasuramardini Agomoni)',titleBn:'\u099c\u09be\u0997\u09cb \u09a4\u09c1\u09ae\u09bf \u099c\u09be\u0997\u09cb (\u09ae\u09b9\u09bf\u09b7\u09be\u09b8\u09c1\u09b0\u09ae\u09b0\u09cd\u09a6\u09bf\u09a8\u09c0 \u0986\u0997\u09ae\u09a8\u09c0 \u0997\u09c0\u09a4\u09bf)',artist:'Dwijen Mukhopadhyay, Pankaj Mullick, Bani Kumar',artistBn:'\u09a6\u09cd\u09ac\u09bf\u099c\u09c7\u09a8 \u09ae\u09c1\u0996\u09cb\u09aa\u09be\u09a7\u09cd\u09af\u09be\u09af\u09bc, \u09aa\u0999\u09cd\u0995\u099c \u0995\u09c1\u09ae\u09be\u09b0 \u09ae\u09b2\u09cd\u09b2\u09bf\u0995 \u0993 \u09ac\u09be\u09a3\u09c0\u0995\u09c1\u09ae\u09be\u09b0',category:'Agomoni & Devotional',mood:'Ritual & Devotion',durationSeconds:215,embedUrl:'https://www.youtube-nocookie.com/embed/IfSJy3_Lkuo',coverUrl:'https://images.unsplash.com/photo-1601616634707-1b058c42ca17?auto=format&fit=crop&w=600&q=80',description:'The sublime Agomoni hymn from Mahishasuramardini awakening Goddess Durga to defeat asuric darkness. Recorded for All India Radio.',descriptionBn:'\u09ae\u09b9\u09bf\u09b7\u09be\u09b8\u09c1\u09b0\u09ae\u09b0\u09cd\u09a6\u09bf\u09a8\u09c0\u09b0 \u0985\u09ac\u09bf\u09b8\u09cd\u09ae\u09b0\u09a3\u09c0\u09af\u09bc \u0986\u0997\u09ae\u09a8\u09c0 \u09b8\u0999\u09cd\u0997\u09c0\u09a4\u0964 \u0985\u09b6\u09c1\u09ad \u09ac\u09bf\u09a8\u09be\u09b6\u09c7 \u09a6\u09c7\u09ac\u09c0\u09b0 \u099c\u09be\u0997\u09b0\u09a3\u09c7\u09b0 \u0986\u0995\u09c1\u09b2 \u09aa\u09cd\u09b0\u09be\u09b0\u09cd\u09a5\u09a8\u09be\u0964',culturalContext:'Sung during dawn on Mahalaya, marking the commencement of Devi Paksha.',culturalContextBn:'\u09ae\u09b9\u09be\u09b2\u09af\u09bc\u09be\u09b0 \u09ad\u09cb\u09b0\u09c7 \u09a6\u09c7\u09ac\u09c0\u09aa\u0995\u09cd\u09b7\u09c7\u09b0 \u09b8\u09c2\u099a\u09a8\u09be\u09b2\u0997\u09cd\u09a8\u09c7 \u09ac\u09be\u0982\u09b2\u09be\u09b0 \u0998\u09b0\u09c7 \u0998\u09b0\u09c7 \u09a7\u09cd\u09ac\u09a8\u09bf\u09a4 \u09b9\u09af\u09bc\u0964',language:'Bengali',playbackMethod:'authorized_stream',licenseType:'Saregama Official Broadcast Archive (Authorized Stream)',attribution:'Master recording by Saregama Bengali. Script by Bani Kumar, music by Pankaj Mullick. In-page playback via authorized embed.',sourceUrl:'https://www.youtube.com/watch?v=IfSJy3_Lkuo',isLocalAsset:!1,lyricsSnippet:'Jago tumi jago, jago durga, jago doshoprohoronodharini...',lyricsSnippetBn:'\u099c\u09be\u0997\u09cb \u09a4\u09c1\u09ae\u09bf \u099c\u09be\u0997\u09cb, \u099c\u09be\u0997\u09cb \u09a6\u09c1\u09b0\u09cd\u0997\u09be, \u099c\u09be\u0997\u09cb \u09a6\u09b6\u09aa\u09cd\u09b0\u09b9\u09b0\u09a3\u09a7\u09be\u09b0\u09bf\u09a3\u09c0...',tags:['Agomoni','Dwijen Mukhopadhyay','Devi Paksha']},{id:'track-bajlo-tomar-alor-benu',title:'Bajlo Tomar Alor Benu (Sharad Agomoni)',titleBn:'\u09ac\u09be\u099c\u09b2\u09cb \u09a4\u09cb\u09ae\u09be\u09b0 \u0986\u09b2\u09cb\u09b0 \u09ac\u09c7\u09a3\u09c1 (\u09b6\u09be\u09b0\u09a6 \u0986\u0997\u09ae\u09a8\u09c0)',artist:'Supriti Ghosh, Pankaj Mullick, Bani Kumar',artistBn:'\u09b8\u09c1\u09aa\u09cd\u09b0\u09c0\u09a4\u09bf \u0998\u09cb\u09b7, \u09aa\u0999\u09cd\u0995\u099c \u0995\u09c1\u09ae\u09be\u09b0 \u09ae\u09b2\u09cd\u09b2\u09bf\u0995 \u0993 \u09ac\u09be\u09a3\u09c0\u0995\u09c1\u09ae\u09be\u09b0',category:'Agomoni & Devotional',mood:'Ritual & Devotion',durationSeconds:195,embedUrl:'https://www.youtube-nocookie.com/embed/mnKcHhCOyT8',coverUrl:'https://images.unsplash.com/photo-1509198397868-475647b2a1e5?auto=format&fit=crop&w=600&q=80',description:'The eternal melody of golden autumn light filling the skies, announcing the maternal homecoming of Uma.',descriptionBn:'\u0986\u09b6\u09cd\u09ac\u09bf\u09a8\u09c7\u09b0 \u09b8\u09cb\u09a8\u09be\u09b2\u09c0 \u09b0\u09cb\u09a6\u09c7 \u09ad\u09cb\u09b0\u09c7\u09b0 \u0986\u09b2\u09cb\u09b0 \u09ac\u09c7\u09a3\u09c1 \u09ac\u09c7\u099c\u09c7 \u0993\u09a0\u09be\u09b0 \u0985\u09ae\u09b0 \u09b8\u09c1\u09b0 - \u0989\u09ae\u09be\u09b0 \u09aa\u09bf\u09a4\u09c3\u0997\u09c3\u09b9\u09c7 \u09aa\u09cd\u09b0\u09a4\u09cd\u09af\u09be\u09ac\u09b0\u09cd\u09a4\u09a8\u09c7\u09b0 \u0986\u09a8\u09a8\u09cd\u09a6\u0964',culturalContext:'Immortalized in Bengali collective memory since the 1930s.',culturalContextBn:'\u09e7\u09ef\u09e9\u09e6-\u098f\u09b0 \u09a6\u09b6\u0995 \u09a5\u09c7\u0995\u09c7 \u09ac\u09be\u0999\u09be\u09b2\u09bf\u09b0 \u09b9\u09c3\u09a6\u09af\u09bc\u09c7 \u09b6\u09be\u09b0\u09a6\u09c0\u09af\u09bc\u09be\u09b0 \u0986\u0997\u09ae\u09a8\u09ac\u09be\u09b0\u09cd\u09a4\u09be \u09a8\u09bf\u09af\u09bc\u09c7 \u0986\u09b8\u09be \u098f\u0995 \u0985\u09ae\u09b0 \u0997\u09be\u09a8\u0964',language:'Bengali',playbackMethod:'authorized_stream',licenseType:'Saregama Official Archive (Authorized Stream)',attribution:'Master recording by Saregama Bengali. Sung by Supriti Ghosh. In-page playback via authorized embed.',sourceUrl:'https://www.youtube.com/watch?v=mnKcHhCOyT8',isLocalAsset:!1,lyricsSnippet:'Bajlo tomar alor benu, matlo re bhubon...',lyricsSnippetBn:'\u09ac\u09be\u099c\u09b2\u09cb \u09a4\u09cb\u09ae\u09be\u09b0 \u0986\u09b2\u09cb\u09b0 \u09ac\u09c7\u09a3\u09c1, \u09ae\u09be\u09a4\u09b2\u09cb \u09b0\u09c7 \u09ad\u09c1\u09ac\u09a8...',tags:['Supriti Ghosh','Alor Benu','Agomoni']},{id:'track-sandhi-puja-bells',title:'Sandhi Puja Brass Temple Bells & Aarti Ambience',titleBn:'\u09b8\u09a8\u09cd\u09a7\u09bf\u09aa\u09c2\u099c\u09be\u09b0 \u0995\u09be\u0981\u09b8\u09b0-\u0998\u09a3\u09cd\u099f\u09be \u0993 \u09aa\u09ac\u09bf\u09a4\u09cd\u09b0 \u0986\u09b0\u09a4\u09bf \u09a7\u09cd\u09ac\u09a8\u09bf',artist:'Michael Maggs (Acoustic Struck Bell Recording)',artistBn:'\u09ae\u09be\u0987\u0995\u09c7\u09b2 \u09ae\u09cd\u09af\u09be\u0997\u09b8 (\u09aa\u09ac\u09bf\u09a4\u09cd\u09b0 \u0998\u09a3\u09cd\u099f\u09be \u09a8\u09be\u09a6)',category:'Puja Ritual & Ambience',mood:'Ritual & Devotion',durationSeconds:24,audioUrl:'https://upload.wikimedia.org/wikipedia/commons/e/e6/Japanese_rin_played_as_struck_idiophone.ogg',coverUrl:'https://images.unsplash.com/photo-1543083477-4f785aeafaa9?auto=format&fit=crop&w=600&q=80',description:'Pure resonant bronze temple bell striking accompanied by sacred acoustic overtones during the transition between Ashtami and Navami.',descriptionBn:'\u09ae\u09b9\u09be\u09b7\u09cd\u099f\u09ae\u09c0 \u0993 \u09ae\u09b9\u09be\u09a8\u09ac\u09ae\u09c0\u09b0 \u09b8\u09a8\u09cd\u09a7\u09bf\u0995\u09cd\u09b7\u09a3\u09c7 \u09e7\u09e6\u09ee \u09aa\u09a6\u09cd\u09ae \u09a8\u09bf\u09ac\u09c7\u09a6\u09a8\u09c7\u09b0 \u09b8\u09ae\u09af\u09bc \u0995\u09be\u0981\u09b8\u09b0, \u0998\u09a3\u09cd\u099f\u09be \u0993 \u09b6\u0999\u09cd\u0996\u09a7\u09cd\u09ac\u09a8\u09bf\u09b0 \u0997\u09ae\u09cd\u09ad\u09c0\u09b0 \u0986\u09ac\u09b9\u0964',culturalContext:'Marks the 48-minute Sandhi Puja window when Devi Chamunda slew Chanda and Munda.',culturalContextBn:'\u09b8\u09a8\u09cd\u09a7\u09bf\u09aa\u09c2\u099c\u09be\u09b0 \u09aa\u09c1\u09a3\u09cd\u09af\u09b2\u0997\u09cd\u09a8\u09c7 \u09e7\u09e6\u09ee \u09ae\u09be\u099f\u09bf\u09b0 \u09aa\u09cd\u09b0\u09a6\u09c0\u09aa \u09aa\u09cd\u09b0\u099c\u09cd\u09ac\u09b2\u09a8\u09c7\u09b0 \u09ae\u09c1\u09b9\u09c2\u09b0\u09cd\u09a4\u09c7 \u0997\u09ae\u09cd\u09ad\u09c0\u09b0 \u0998\u09a3\u09cd\u099f\u09be\u09b0 \u09a8\u09be\u09a6\u0964',language:'Instrumental',playbackMethod:'direct_audio',licenseType:'Creative Commons CC BY-SA 4.0',attribution:'Acoustic struck sacred bell recorded by Michael Maggs. Hosted on Wikimedia Commons under CC BY-SA 4.0.',sourceUrl:'https://commons.wikimedia.org/wiki/File:Japanese_rin_played_as_struck_idiophone.ogg',isLocalAsset:!1,lyricsSnippet:'Joy maa chamunda, 108 poddo arati...',lyricsSnippetBn:'\u099c\u09af\u09bc \u09ae\u09be \u099a\u09be\u09ae\u09c1\u09a8\u09cd\u09a1\u09be, \u09e7\u09e6\u09ee \u09aa\u09a6\u09cd\u09ae \u0986\u09b0\u09a4\u09bf...',tags:['Sandhi Puja','Temple Bell','Aarti','Ashtami']},{id:'track-evening-aarati-dhoop',title:'Pandal Evening Dhoop Aarti & Ghonta Dhwani',titleBn:'\u09ae\u09a3\u09cd\u09a1\u09aa\u09c7\u09b0 \u09b8\u09be\u09a8\u09cd\u09a7\u09cd\u09af \u0986\u09b0\u09a4\u09bf, \u09a7\u09c2\u09aa \u0993 \u0998\u09a3\u09cd\u099f\u09be\u09b0 \u09b8\u09ae\u09cd\u09ae\u09bf\u09b2\u09bf\u09a4 \u09a8\u09be\u09a6',artist:'Kolkata Mandap Arati Recording',artistBn:'\u0995\u09b2\u0995\u09be\u09a4\u09be \u09ae\u09a3\u09cd\u09a1\u09aa \u09b8\u09be\u09a8\u09cd\u09a7\u09cd\u09af \u0986\u09b0\u09a4\u09bf \u0993 \u09a2\u09be\u0995\u09c7\u09b0 \u09ac\u09be\u099c\u09a8\u09be',category:'Puja Ritual & Ambience',mood:'Ritual & Devotion',durationSeconds:320,embedUrl:'https://www.youtube-nocookie.com/embed/9mg18ipVYJ4',coverUrl:'https://images.unsplash.com/photo-1543083477-4f785aeafaa9?auto=format&fit=crop&w=600&q=80',description:'Immersive authentic audio environment capturing the incense-filled atmosphere of North Kolkata traditional thakurdalan during evening aarati.',descriptionBn:'\u0989\u09a4\u09cd\u09a4\u09b0 \u0995\u09b2\u0995\u09be\u09a4\u09be\u09b0 \u09ac\u09a8\u09c7\u09a6\u0