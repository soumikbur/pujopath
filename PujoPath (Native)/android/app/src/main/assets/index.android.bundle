__d(function(g,r,i,a,m,e,d){"use strict";Object.defineProperty(e,'__esModule',{value:!0}),Object.defineProperty(e,"KALI_PANDALS_DATA",{enumerable:!0,get:function(){return t}});var t=[{id:'kali-barasat-pioneer-park',slug:'pioneer-athletic-club-barasat',name:'Pioneer Athletic Club (Pioneer Park)',nameBn:'\u09aa\u09be\u0987\u0993\u09a8\u09bf\u09af\u09bc\u09be\u09b0 \u0985\u09cd\u09af\u09be\u09a5\u09b2\u09c7\u099f\u09bf\u0995 \u0995\u09cd\u09b2\u09be\u09ac (\u09aa\u09be\u0987\u0993\u09a8\u09bf\u09af\u09bc\u09be\u09b0 \u09aa\u09be\u09b0\u09cd\u0995)',zone:'Barasat',locality:'Pioneer Park',localityBn:'\u09aa\u09be\u0987\u0993\u09a8\u09bf\u09af\u09bc\u09be\u09b0 \u09aa\u09be\u09b0\u09cd\u0995',address:'Pioneer Park, Near Barasat Railway Station, Barasat, North 24 Parganas - 700124',addressBn:'\u09aa\u09be\u0987\u0993\u09a8\u09bf\u09af\u09bc\u09be\u09b0 \u09aa\u09be\u09b0\u09cd\u0995, \u09ac\u09be\u09b0\u09be\u09b8\u09be\u09a4 \u09b0\u09c7\u09b2\u0993\u09af\u09bc\u09c7 \u09b8\u09cd\u099f\u09c7\u09b6\u09a8 \u09b8\u0982\u09b2\u0997\u09cd\u09a8, \u09ac\u09be\u09b0\u09be\u09b8\u09be\u09a4, \u0989\u09a4\u09cd\u09a4\u09b0 \u09e8\u09ea \u09aa\u09b0\u0997\u09a8\u09be - \u09ed\u09e6\u09e6\u09e7\u09e8\u09ea',latitude:22.724419,longitude:88.481443,theme:'Architectural Heritage & Illumination (Historical)',themeBn:'\u09ac\u09bf\u09b6\u09be\u09b2 \u09b8\u09cd\u09a5\u09be\u09aa\u09a4\u09cd\u09af \u0993 \u0986\u09b2\u09cb\u0995\u09b8\u099c\u09cd\u099c\u09be (\u0990\u09a4\u09bf\u09b9\u09be\u09b8\u09bf\u0995)',themeYear:2025,category:'Artistic',description:'One of the oldest, largest, and most heavily visited community Kali Puja hubs in Barasat. Renowned for colossal architectural pandals, intricate idol sculpting, and dynamic multikilometer Chandannagar light gates.',descriptionBn:'\u09ac\u09be\u09b0\u09be\u09b8\u09be\u09a4\u09c7\u09b0 \u0985\u09a8\u09cd\u09af\u09a4\u09ae \u09aa\u09cd\u09b0\u09be\u099a\u09c0\u09a8 \u0993 \u09b8\u09c1\u09ac\u09bf\u0996\u09cd\u09af\u09be\u09a4 \u09b8\u09b0\u