rossing)'},{stationId:'shobhabazar-sutanuti',stationName:'Shobhabazar Sutanuti',stationNameBn:'\u09b6\u09cb\u09ad\u09be\u09ac\u09be\u099c\u09be\u09b0 \u09b8\u09c1\u09a4\u09be\u09a8\u09c1\u099f\u09bf',walkingDistanceMeters:900,walkingDurationMinutes:12,exitGate:'Gate 1'}],facilities:{wheelchairAccessible:!0,drinkingWater:!0,medicalBooth:!0,vipPassEntry:!0,parkingAvailable:!1,foodStallsNearby:!0,publicToilets:!0},highlights:['Pure Traditional Ekchala Protima','Centenary Celebrations','Famous Pujo Mela by the Ghats','Iconic Bhog Prasad'],highlightsBn:['\u09ac\u09bf\u09b6\u09c1\u09a6\u09cd\u09a7 \u09b8\u09a8\u09be\u09a4\u09a8\u09c0 \u098f\u0995\u099a\u09be\u09b2\u09be \u09aa\u09cd\u09b0\u09a4\u09bf\u09ae\u09be','\u09b6\u09a4\u09ac\u09b0\u09cd\u09b7\u09c7\u09b0 \u0986\u09ad\u09bf\u099c\u09be\u09a4\u09cd\u09af','\u0998\u09be\u099f \u09b8\u0982\u09b2\u0997\u09cd\u09a8 \u0990\u09a4\u09bf\u09b9\u09cd\u09af\u09ac\u09be\u09b9\u09c0 \u09ae\u09c7\u09b2\u09be','\u09b8\u09c1\u09b8\u09cd\u09ac\u09be\u09a6\u09c1 \u09ad\u09cb\u0997 \u09aa\u09cd\u09b0\u09b8\u09be\u09a6']},{id:'kumartuli-park',slug:'kumartuli-park',name:'Kumartuli Park Sarbojanin',nameBn:'\u0995\u09c1\u09ae\u09cb\u09b0\u099f\u09c1\u09b2\u09bf \u09aa\u09be\u09b0\u09cd\u0995 \u09b8\u09b0\u09cd\u09ac\u099c\u09a8\u09c0\u09a8',zone:'North Kolkata',locality:'Kumartuli',localityBn:'\u0995\u09c1\u09ae\u09cb\u09b0\u099f\u09c1\u09b2\u09bf',address:'8/B, Abhay Mitra Street, Sovabazar, Kumartuli, Kolkata - 700005',addressBn:'\u09ee/\u09ac\u09bf, \u0985\u09ad\u09af\u09bc \u09ae\u09bf\u09a4\u09cd\u09b0 \u09b8\u09cd\u099f\u09cd\u09b0\u09bf\u099f, \u09b6\u09cb\u09ad\u09be\u09ac\u09be\u099c\u09be\u09b0, \u0995\u09c1\u09ae\u09cb\u09b0\u099f\u09c1\u09b2\u09bf, \u0995\u09b2\u0995\u09be\u09a4\u09be - \u09ed\u09e6\u09e6\u09e6MD',latitude:22.5997,longitude:88.3655,theme:'Architectural Splendor of Royal Indian Temples',themeBn:'\u09ad\u09be\u09b0\u09a4\u09c7\u09b0 \u09b0\u09be\u099c\u0995\u09c0\u09af\u09bc \u09ae\u09a8\u09cd\u09a6\u09bf\u09b0\u09c7\u09b0 \u09b6\u09bf\u09b2\u09cd\u09aa\u09b0\u09c2\u09aa \u0993 \u0995\u09be\u09b0\u09c1\u0995\u09be\u099c',category:'Artistic',description:'Located in the heart of the world-famous idol-makers colony of Kumartuli, this pandal always showcases breathtaking artistic installations and intricate idol sculpting.',descriptionBn:'\u09ac\u09bf\u09b6\u09cd\u09ac\u09ac\u09bf\u0996\u09cd\u09af\u09be\u09a4 \u09ae\u09c3\u09ce\u09b6\u09bf\u09b2\u09cd\u09aa\u09c0\u09a6\u09c7\u09b0 \u0986\u09b8\u09cd\u09a4\u09be\u09a8\u09be \u0995\u09c1\u09ae\u09cb\u09b0\u099f\u09c1\u09b2\u09bf\u09b0 \u0995\u09c7\u09a8\u09cd\u09a6\u09cd\u09b0\u09b8\u09cd\u09a5\u09b2\u09c7 \u0985\u09ac\u09b8\u09cd\u09a5\u09bf\u09a4 \u098f\u0987 \u09aa\u09c2\u099c\u09be\u099f\u09bf \u09aa\u09cd\u09b0\u09a4\u09bf \u09ac\u099b\u09b0\u0987 \u09a4\u09be\u09a6\u09c7\u09b0 \u099a\u09cb\u0996 \u09a7\u09be\u0981\u09a7\u09be\u09a8\u09cb \u09b6\u09bf\u09b2\u09cd\u09aa\u09ae\u09a3\u09cd\u09a1\u09bf\u09a4 \u09ae\u09a3\u09cd\u09a1\u09aa \u0993 \u09b8\u09c2\u0995\u09cd\u09b7\u09cd\u09ae \u09ad\u09be\u09b8\u09cd\u0995\u09b0\u09cd\u09af \u09b6\u09bf\u09b2\u09cd\u09aa\u09c7\u09b0 \u099c\u09a8\u09cd\u09af \u09b8\u09ae\u09be\u09a6\u09c3\u09a4\u0964',history:'Founded in 1993, this puja transformed North Kolkata modern pandal architecture while keeping rooted in the master craft of Kumartuli sculptors.',historyBn:'\u09e7\u09ef\u09ef\u09e9 \u09b8\u09be\u09b2\u09c7 \u09b6\u09c1\u09b0\u09c1 \u09b9\u0993\u09af\u09bc\u09be \u098f\u0987 \u09aa\u09c1\u099c\u09cb \u0989\u09a4\u09cd\u09a4\u09b0 \u0995\u09b2\u0995\u09be\u09a4\u09be\u09b0 \u0986\u09a7\u09c1\u09a8\u09bf\u0995 \u09ae\u09a3\u09cd\u09a1\u09aa\u09b8\u099c\u09cd\u099c\u09be \u0993 \u0995\u09c1\u09ae\u09cb\u09b0\u099f\u09c1\u09b2\u09bf\u09b0 \u09a6\u0995\u09cd\u09b7 \u09b6\u09bf\u09b2\u09cd\u09aa\u09c0\u09a6\u09c7\u09b0 \u09ad\u09be\u09ac\u09a8\u09be\u09b0 \u09ae\u09c7\u09b2\u09ac\u09a8\u09cd\u09a7\u09a8 \u0998\u099f\u09bf\u09af\u09bc\u09c7\u099b\u09c7\u0964',establishedYear:1993,openingTime:'08:00 AM',closingTime:'03:00 AM',crowdLevel:'High',popularityScore:94,rating:4.8,reviewCount:2890,imageUrl:'/images/pandals/kumartuli-park.webp',galleryImages:['/images/pandals/kumartuli-park.webp'],isFeatured:!0,isHeritage:!1,metroLinks:[{stationId:'shobhabazar-sutanuti',stationName:'Shobhabazar Sutanuti',stationNameBn:'\u09b6\u09cb\u09ad\u09be\u09ac\u09be\u099c\u09be\u09b0 \u09b8\u09c1\u09a4\u09be\u09a8\u09c1\u099f\u09bf',walkingDistanceMeters:600,walkingDurationMinutes:8,exitGate:'Gate 2 (BK Paul Ave)'}],facilities:{wheelchairAccessible:!0,drinkingWater:!0,medicalBooth:!0,vipPassEntry:!0,parkingAvailable:!1,foodStallsNearby:!0,publicToilets:!0},highlights:['Adjacent to Idol Artisans Studios','Spectacular Grand Dome','Artistic Lighting Display'],highlightsBn:['\u09ae\u09c3\u09ce\u09b6\u09bf\u09b2\u09cd\u09aa\u09c0\u09a6\u09c7\u09b0 \u0995\u09b0\u09cd\u09ae\u09b6\u09be\u09b2\u09be \u09b8\u0982\u09b2\u0997\u09cd\u09a8','\u09ac\u09bf\u09b6\u09be\u09b2 \u09b0\u09be\u099c\u0995\u09c0\u09af\u09bc \u099a\u09c2\u09a1\u09bc\u09be \u0993 \u0986\u09b2\u09cb','\u09ae\u09a8\u09cb\u09b0\u09ae \u0986\u09b2\u09cb\u0995\u09b8\u099c\u09cd\u099c\u09be']},{id:'sovabazar-rajbari',slug:'sovabazar-rajbari',name:'Sovabazar Rajbari (Boro Taraf)',nameBn:'\u09b6\u09cb\u09ad\u09be\u09ac\u09be\u099c\u09be\u09b0 \u09b0\u09be\u099c\u09ac\u09be\u09a1\u09bc\u09bf (\u09ac\u09a1\u09bc \u09a4\u09b0\u09ab)',zone:'North Kolkata',locality:'Sovabazar',localityBn:'\u09b6\u09cb\u09ad\u09be\u09ac\u09be\u099c\u09be\u09b0',address:'35 Raja Naba Krishna Street, Sovabazar, Kolkata - 700005',addressBn:'\u09e9\u09eb \u09b0\u09be\u099c\u09be \u09a8\u09ac\u0995\u09c3\u09b7\u09cd\u09a3 \u09b8\u09cd\u099f\u09cd\u09b0\u09bf\u099f, \u09b6\u09cb\u09ad\u09be\u09ac\u09be\u099c\u09be\u09b0, \u0995\u09b2\u0995\u09be\u09a4\u09be - \u09ed\u09e6\u09e6\u09e6MD',latitude:22.5963,longitude:88.3674,theme:'Heritage 1757 Daaker Saaj & Ekchala Ghotokmuki Singha',themeBn:'\u09e7\u09ed\u09eb\u09ed \u09b8\u09be\u09b2\u09c7\u09b0 \u0990\u09a4\u09bf\u09b9\u09be\u09b8\u09bf\u0995 \u09a1\u09be\u0995\u09c7\u09b0 \u09b8\u09be\u099c \u0993 \u0998\u09cb\u099f\u0995\u09ae\u09c1\u0996\u09c0 \u09b8\u09bf\u0982\u09b9 \u09b8\u09ae\u09a8\u09cd\u09ac\u09bf\u09a4 \u098f\u0995\u099a\u09be\u09b2\u09be \u09aa\u09cd\u09b0\u09a4\u09bf\u09ae\u09be',category:'Bonedi Bari',description:'The foundational Bonedi Bari Durga Puja of Kolkata, inaugurated by Raja Nabakrishna Deb in 1757 following the Battle of Plassey. Celebrated in the magnificent open-pillared Natmandir with British and Indian historical luminaries having attended.',descriptionBn:'\u09e7\u09ed\u09eb\u09ed \u09b8\u09be\u09b2\u09c7 \u09aa\u09b2\u09be\u09b6\u09c0\u09b0 \u09af\u09c1\u09a6\u09cd\u09a7\u09c7\u09b0 \u09aa\u09b0 \u09b0\u09be\u099c\u09be \u09a8\u09ac\u0995\u09c3\u09b7\u09cd\u09a3 \u09a6\u09c7\u09ac \u0995\u09b0\u09cd\u09a4\u09c3\u0995 \u09b8\u09c2\u099a\u09bf\u09a4 \u0995\u09b2\u0995\u09be\u09a4\u09be\u09b0 \u0985\u09a8\u09cd\u09af\u09a4\u09ae \u0990\u09a4\u09bf\u09b9\u09be\u09b8\u09bf\u0995 \u09ac\u09a8\u09c7\u09a6\u09bf \u09ac\u09be\u09a1\u09bc\u09bf\u09b0 \u09a6\u09c1\u09b0\u09cd\u0997\u09be\u09aa\u09c2\u099c\u09be\u0964 \u0989\u09a8\u09cd\u09ae\u09c1\u0995\u09cd\u09a4 \u09a5\u09be\u09ae\u09af\u09c1\u0995\u09cd\u09a4 \u09a8\u09be\u099f\u09ae\u09a8\u09cd\u09a6\u09bf\u09b0\u09c7 \u09a6\u09c7\u09ac\u09c0\u09b0 \u0986\u09b0\u09be\u09a7\u09a8\u09be \u098f\u09ac\u0982 \u0998\u09cb\u099f\u0995\u09ae\u09c1\u0996\u09c0 \u09b8\u09bf\u0982\u09b9\u09c7\u09b0 \u0990\u09a4\u09bf\u09b9\u09cd\u09af\u09ac\u09be\u09b9\u09c0 \u09b0\u09c2\u09aa\u0964',history:'Commenced in 1757 after the Battle of Plassey by Raja Nabakrishna Deb. Lord Clive and Warren Hastings were historically hosted here. The idol features classical Daaker Saaj, silver filigree backdrop, and the unique horse-faced lion mount.',historyBn:'\u09e7\u09ed\u09eb\u09ed \u09b8\u09be\u09b2\u09c7 \u09b0\u09be\u099c\u09be \u09a8\u09ac\u0995\u09c3\u09b7\u09cd\u09a3 \u09a6\u09c7\u09ac \u098f\u0987 \u09aa\u09c1\u099c\u09cb\u09b0 \u09b8\u09c2\u099a\u09a8\u09be \u0995\u09b0\u09c7\u09a8\u0964 \u09b2\u09b0\u09cd\u09a1 \u0995\u09cd\u09b2\u09be\u0987\u09ad \u0993 \u0993\u09af\u09bc\u09be\u09b0\u09c7\u09a8 \u09b9\u09c7\u09b8\u09cd\u099f\u09bf\u0982\u09b8\u0993 \u098f\u0987 \u09b0\u09be\u099c\u09ac\u09be\u09a1\u09bc\u09bf\u09b0 \u09aa\u09c1\u099c\u09cb\u09af\u09bc \u0986\u09ae\u09a8\u09cd\u09a4\u09cd\u09b0\u09bf\u09a4 \u0985\u09a4\u09bf\u09a5\u09bf \u099b\u09bf\u09b2\u09c7\u09a8\u0964 \u09b0\u09c2\u09aa\u09cb\u09b0 \u09b8\u09be\u099c \u0993 \u0990\u09a4\u09bf\u09b9\u09be\u09b8\u09bf\u0995 \u09a8\u09be\u099f\u09ae\u09a8\u09cd\u09a6\u09bf\u09b0 \u098f\u0987 \u09aa\u09c1\u099c\u09cb\u09b0 \u0997\u09cc\u09b0\u09ac\u0964',establishedYear:1757,openingTime:'06:00 AM',closingTime:'11:00 PM',crowdLevel:'High',popularityScore:99,rating:4.9,reviewCount:4120,imageUrl:'/images/pandals/sovabazar-rajbari.webp',galleryImages:['/images/pandals/sovabazar-rajbari.webp'],isFeatured:!0,isHeritage:!0,isBonediBari:!0,bonediBariInfo:{ancestralHouseName:'Sovabazar Rajbari Boro Taraf (Baag-ola Bari)',ancestralHouseNameBn:'\u09b6\u09cb\u09ad\u09be\u09ac\u09be\u099c\u09be\u09b0 \u09b0\u09be\u099c\u09ac\u09be\u09a1\u09bc\u09bf \u09ac\u09a1\u09bc \u09a4\u09b0\u09ab (\u09ac\u09be\u0998-\u0993\u09b2\u09be \u09ac\u09be\u09a1\u09bc\u09bf)',familyLineage:'Deb Family of Sovabazar (Descendants of Raja Nabakrishna Deb)',familyLineageBn:'\u09b6\u09cb\u09ad\u09be\u09ac\u09be\u099c\u09be\u09b0 \u09a6\u09c7\u09ac \u09b0\u09be\u099c\u09aa\u09b0\u09bf\u09ac\u09be\u09b0',visitorAccessStatus:'Visitor access confirmed',visitorAccessStatusBn:'\u09a6\u09b0\u09cd\u09b6\u09a8\u09be\u09b0\u09cd\u09a5\u09c0\u09a6\u09c7\u09b0 \u09aa\u09cd\u09b0\u09ac\u09c7\u09b6\u09be\u09a7\u09bf\u0995\u09be\u09b0 \u09b8\u09c1\u09a8\u09bf\u09b6\u09cd\u099a\u09bf\u09a4',visitingHours:'06:00 AM - 10:30 PM daily during festival',visitingHoursBn:'\u0989\u09ce\u09b8\u09ac\u09c7\u09b0 \u09a6\u09bf\u09a8\u0997\u09c1\u09b2\u09bf\u09a4\u09c7 \u09b8