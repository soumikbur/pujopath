:'Extreme',popularityScore:100,rating:4.9,reviewCount:11200,imageUrl:'',galleryImages:[],isFeatured:!0,isHeritage:!0,metroLinks:[{stationId:'dakshineswar-metro',stationName:'Dakshineswar Metro Station (Blue Line Terminal)',stationNameBn:'\u09a6\u0995\u09cd\u09b7\u09bf\u09a3\u09c7\u09b6\u09cd\u09ac\u09b0 \u09ae\u09c7\u099f\u09cd\u09b0\u09cb \u09b8\u09cd\u099f\u09c7\u09b6\u09a8',walkingDistanceMeters:300,walkingDurationMinutes:4,exitGate:'Direct Skywalk to Temple Gate'}],facilities:{wheelchairAccessible:!0,drinkingWater:!0,medicalBooth:!0,vipPassEntry:!0,parkingAvailable:!0,foodStallsNearby:!0,publicToilets:!0},highlights:['Sri Ramakrishna Hermitage','Navaratna Architecture','Skywalk from Metro','Ganges River Ghats'],highlightsBn:['\u09b6\u09cd\u09b0\u09c0 \u09b0\u09be\u09ae\u0995\u09c3\u09b7\u09cd\u09a3\u09a6\u09c7\u09ac\u09c7\u09b0 \u09b8\u09be\u09a7\u09a8\u0995\u09cd\u09b7\u09c7\u09a4\u09cd\u09b0','\u09a8\u09ac\u09b0\u09a4\u09cd\u09a8 \u09ae\u09a8\u09cd\u09a6\u09bf\u09b0 \u09b8\u09cd\u09a5\u09be\u09aa\u09a4\u09cd\u09af','\u09ae\u09c7\u099f\u09cd\u09b0\u09cb \u09b8\u09cd\u0995\u09be\u0987\u0993\u09af\u09bc\u09be\u0995 \u09b8\u09b0\u09be\u09b8\u09b0\u09bf \u09b8\u0982\u09af\u09cb\u0997','\u0997\u0999\u09cd\u0997\u09be\u09b0 \u09ae\u09a8\u09cb\u09b0\u09ae \u0998\u09be\u099f'],sourceUrl:'https://dakshineswarkalitemple.org/',sourceName:'Dakshineswar Kali Temple Trust',verificationDate:'2026-10-19',coordinateConfidence:'High',verificationStatus:'Verified'},{id:'kali-thanthania',slug:'thanthania-kalibari-kolkata',name:'Thanthania Kalibari (Maa Siddheswari)',nameBn:'\u09a0\u09a8\u09a0\u09a8\u09bf\u09af\u09bc\u09be \u0995\u09be\u09b2\u09c0\u09ac\u09be\u09a1\u09bc\u09bf (\u09ae\u09be \u09b8\u09bf\u09a6\u09cd\u09a7\u09c7\u09b6\u09cd\u09ac\u09b0\u09c0)',zone:'Central Kolkata',locality:'College Street / Bidhan Sarani',localityBn:'\u0995\u09b2\u09c7\u099c \u09b8\u09cd\u099f\u09cd\u09b0\u09bf\u099f / \u09ac\u09bf\u09a7\u09be\u09a8 \u09b8\u09b0\u09a3\u09bf',address:'College Street & Bidhan Sarani Crossing, Kolkata - 700006',addressBn:'\u0995\u09b2\u09c7\u099c \u09b8\u09cd\u099f\u09cd\u09b0\u09bf\u099f \u0993 \u09ac\u09bf\u09a7\u09be\u09a8 \u09b8\u09b0\u09a3\u09bf \u0995\u09cd\u09b0\u09b8\u09bf\u0982, \u0995\u09b2\u0995\u09be\u09a4\u09be - \u09ed\u09e6\u09e6\u09e6\u09e6\u09ec',latitude:22.5802,longitude:88.3639,theme:'Centuries Old Tantric Shrine & Annual Clay Pratima Renewal',themeBn:'\u09b8\u09c1\u09aa\u09cd\u09b0\u09be\u099a\u09c0\u09a8 \u09a4\u09be\u09a8\u09cd\u09a4\u09cd\u09b0\u09bf\u0995 \u09aa\u09c0\u09a0 \u0993 \u09ac\u09be\u09b0\u09cd\u09b7\u09bf\u0995 \u09ae\u09c3\u09a8\u09cd\u09ae\u09af\u09bc\u09c0 \u09ac\u09bf\u0997\u09cd\u09b0\u09b9 \u09b8\u0982\u09b8\u09cd\u0995\u09be\u09b0',category:'Heritage',description:'Legendary tantric shrine founded in 1703 by Udiyana Brahmachari. The seated clay murti of Goddess Siddheswari is unique: traditionally sculpted anew over the sacred wooden frame every single year immediately preceding Kali Puja.',descriptionBn:'\u09e7\u09ed\u09e6\u09e9 \u0996\u09cd\u09b0\u09bf\u09b8\u09cd\u099f\u09be\u09ac\u09cd\u09a6\u09c7 \u0989\u09a6\u09af\u09bc\u09a8\u09be\u09b0\u09be\u09af\u09bc\u09a8 \u09ac\u09cd\u09b0\u09b9\u09cd\u09ae\u099a\u09be\u09b0\u09c0 \u09aa\u09cd\u09b0\u09a4\u09bf\u09b7\u09cd\u09a0\u09bf\u09a4 \u09ae\u09a7\u09cd\u09af \u0995\u09b2\u0995\u09be\u09a4\u09be\u09b0 \u0985\u09a8\u09cd\u09af\u09a4\u09ae \u09aa\u09cd\u09b0\u09be\u099a\u09c0\u09a8 \u099c\u09be\u0997\u09cd\u09b0\u09a4 \u09aa\u09c0\u09a0\u0964 \u09aa\u09cd\u09b0\u09a4\u09bf \u09ac\u099b\u09b0 \u0995\u09be\u09b2\u09c0\u09aa\u09c2\u099c\u09be\u09b0 \u09aa\u09c2\u09b0\u09cd\u09ac\u09c7 \u09ae\u09c3\u09a8\u09cd\u09ae\u09af\u09bc\u09c0 \u09aa\u09cd\u09b0\u09a4\u09bf\u09ae\u09be \u09a8\u09a4\u09c1\u09a8 \u0995\u09b0\u09c7 \u09a8\u09bf\u09b0\u09cd\u09ae\u09be\u09a3 \u0995\u09b0\u09be \u09b9\u09af\u09bc \u09af\u09be \u09b6\u09a4\u09be\u09ac\u09cd\u09a6\u09c0\u09b0 \u09aa\u09cd\u09b0\u09be\u099a\u09c0\u09a8 \u09aa\u09cd\u09b0\u09a5\u09be\u0964',history:'Over 320 years old, situated in the historic cultural heart of College Street.',historyBn:'\u09e9\u09e8\u09e6 \u09ac\u099b\u09b0\u09c7\u09b0\u0993 \u09ac\u09c7\u09b6\u09bf \u09aa\u09cd\u09b0\u09be\u099a\u09c0\u09a8 \u0990\u09a4\u09bf\u09b9\u09cd\u09af\u09ae\u09a3\u09cd\u09a1\u09bf\u09a4 \u099c\u09be\u0997\u09cd\u09b0\u09a4 \u09ae\u09a8\u09cd\u09a6\u09bf\u09b0\u0964',establishedYear:1703,openingTime:'06:00 AM',closingTime:'02:00 AM',crowdLevel:'High',popularityScore:95,rating:4.8,reviewCount:3800,imageUrl:'',galleryImages:[],isFeatured:!0,isHeritage:!0,metroLinks:[{stationId:'central-metro',stationName:'Central / MG Road Metro Station',stationNameBn:'\u09b8\u09c7\u09a8\u09cd\u099f\u09cd\u09b0\u09be\u09b2 / \u098f\u09ae\u099c\u09bf \u09b0\u09cb\u09a1 \u09ae\u09c7\u099f\u09cd\u09b0\u09cb',walkingDistanceMeters:550,walkingDurationMinutes:7}],facilities:{wheelchairAccessible:!0,drinkingWater:!0,medicalBooth:!1,vipPassEntry:!1,parkingAvailable:!1,foodStallsNearby:!0,publicToilets:!1},highlights:['Founded 1703 AD','College Street Historic Artery','Unique Seated Deity Form'],highlightsBn:['\u09e7\u09ed\u09e6\u09e9 \u09b8\u09be\u09b2\u09c7 \u09aa\u09cd\u09b0\u09a4\u09bf\u09b7\u09cd\u09a0\u09bf\u09a4','\u0990\u09a4\u09bf\u09b9\u09be\u09b8\u09bf\u0995 \u0995\u09b2\u09c7\u099c \u09b8\u09cd\u099f\u09cd\u09b0\u09bf\u099f \u0985\u099e\u09cd\u099a\u09b2','\u0989\u09aa\u09ac\u09bf\u09b7\u09cd\u099f\u09be \u09a6\u09c7\u09ac\u09c0 \u09ac\u09bf\u0997\u09cd\u09b0\u09b9'],sourceUrl:'https://wbhc.in/heritage-site-details.php?id=thanthania',sourceName:'West Bengal Heritage Commission & Temple Trust',verificationDate:'2026-10-19',coordinateConfidence:'High',verificationStatus:'Verified'},{id:'kali-lake-kalibari',slug:'lake-kalibari-karunamoyee',name:'Lake Kalibari (Sree Sree Karunamoyee Kali)',nameBn:'\u09b2\u09c7\u0995 \u0995\u09be\u09b2\u09c0\u09ac\u09be\u09a1\u09bc\u09bf (\u09b6\u09cd\u09b0\u09c0 \u09b6\u09cd\u09b0\u09c0 \u0995\u09b0\u09c1\u09a3\u09be\u09ae\u09af\u09bc\u09c0 \u09