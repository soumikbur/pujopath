# ==============================================================================
# PujoPath — Environment Configuration Template (.env.example)
# ==============================================================================
# Copy this file to .env.local to configure your local development environment:
#   cp .env.example .env.local
#
# Do NOT commit .env.local or any production credentials to source control.
# ==============================================================================

# Public URL of the application
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Base path for deployment (leave empty for root domain, use /pujopath for GitHub Pages)
NEXT_PUBLIC_BASE_PATH=

# Interactive Map Configuration
# Preferred provider: google (Official Google Maps Platform JavaScript API)
NEXT_PUBLIC_MAP_PROVIDER=google

# Google Maps Platform API Key (Required for embedded Google Maps)
# For prototyping: get a free Maps Demo Key at https://mapsplatform.google.com/maps-demo-key
# For production: generate an API key in Google Cloud Console and restrict by HTTP referrer
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Google Maps Platform Map ID (Optional; default is DEMO_MAP_ID for AdvancedMarkerElement)
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=DEMO_MAP_ID


# Default Application Language (en | bn)
NEXT_PUBLIC_DEFAULT_LOCALE=en

# Analytics & Monitoring (optional)
NEXT_PUBLIC_ENABLE_ANALYTICS=false
NEXT_PUBLIC_ANALYTICS_KEY=
